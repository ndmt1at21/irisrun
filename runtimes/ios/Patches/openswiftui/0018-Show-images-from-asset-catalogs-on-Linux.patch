--- a/Sources/OpenSwiftUICore/Render/DisplayList/DisplayListLayerRenderer.swift
+++ b/Sources/OpenSwiftUICore/Render/DisplayList/DisplayListLayerRenderer.swift
@@ -177,9 +177,19 @@ extension IrisRender.Scene {
             parent.addSublayer(layer)
         case let .flattened(list, offset, _):
             add(list, to: parent, at: CGPoint(x: frame.minX + offset.x, y: frame.minY + offset.y))
+        case let .image(image):
+            // Layout has already sized the image; it fills its frame. ponytail: encoded images
+            // from asset catalogs only, drawn without template tint or resizing insets.
+            guard case let .irisEncoded(encoded)? = image.contents else {
+                break
