             #else
             _openSwiftUIPlatformUnimplementedWarning()
             return nil
@@ -900,6 +916,15 @@ extension Image {
                     return resolveBitmap(key: key, info: info, in: context)
                 }
             }
+            #elseif !canImport(Darwin)
