+// MARK: - IrisEncodedImage
+
+/// Iris: the bytes of an image file, kept once however many views show it.
+package final class IrisEncodedImage: Equatable, @unchecked Sendable {
+    package let bytes: [UInt8]
+
+    package init(bytes: [UInt8]) {
+        self.bytes = bytes
+    }
+
+    package static func == (lhs: IrisEncodedImage, rhs: IrisEncodedImage) -> Bool {
+        lhs === rhs || lhs.bytes == rhs.bytes
+    }
+}
