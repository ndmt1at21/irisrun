+/// An alert: a title, a message and buttons in a 270-point card in the middle of the
+/// screen, two buttons side by side.
+private struct AlertView<Actions, Message>: View where Actions: View, Message: View {
+    var title: Text
+    var actions: Actions
+    var message: Message
+    var dismiss: () -> Void
+
+    var body: some View {
+        ZStack {
+            dimming
+            VStack(spacing: 0) {
+                VStack(spacing: 4) {
+                    title
+                        .font(.headline)
+                    message
+                        .font(.footnote)
+                }
+                .multilineTextAlignment(.center)
+                .padding(.horizontal, 16)
+                .padding(.top, 19)
+                .padding(.bottom, 17)
+                // The style outside the rows, for the buttons in them to see it.
+                _VariadicView.Tree(AlertActions()) {
+                    actions
+                }
+                .buttonStyle(ModalActionButtonStyle(dismiss: dismiss, height: 44, font: .body))
+            }
+            .frame(width: 270)
+            .background(RoundedRectangle(cornerRadius: 14).fill(materialBackground))
+        }
+    }
+}
+
+private struct AlertActions: _VariadicView_UnaryViewRoot {
+    func body(children: _VariadicView.Children) -> some View {
+        if children.isEmpty {
+            Button("OK") {}
+        } else if children.count == 2 {
+            HStack(spacing: 0) {
+                children[0]
+                separator.frame(width: 0.33, height: 44.33)
+                children[1]
+            }
+        } else {
+            VStack(spacing: 0) {
+                children
+            }
+        }
+    }
+}
+
+/// A confirmation dialog: an action sheet at the bottom of the screen, its cancel button
+/// apart below the others. A tap outside cancels it.
+private struct DialogView<Actions, Message>: View where Actions: View, Message: View {
+    var title: Text?
+    var actions: Actions
+    var message: Message
+    var dismiss: () -> Void
+
+    var body: some View {
+        ZStack(alignment: .bottom) {
+            dimming
+                .onTapGesture(perform: dismiss)
+            VStack(spacing: 8) {
+                VStack(spacing: 0) {
+                    if let title {
+                        VStack(spacing: 4) {
+                            title
+                                .font(.footnote.weight(.semibold))
+                            message
+                                .font(.footnote)
+                        }
+                        .foregroundStyle(secondaryLabel)
+                        .multilineTextAlignment(.center)
+                        .padding(.horizontal, 16)
+                        .padding(.vertical, 14)
+                    }
+                    actions
+                        .buttonStyle(ModalActionButtonStyle(dismiss: dismiss, height: 57, font: .title3, showsCancel: false))
+                }
+                .background(RoundedRectangle(cornerRadius: 14).fill(materialBackground))
+                _VariadicView.Tree(DialogCancel()) {
+                    actions
+                }
+                .buttonStyle(ModalActionButtonStyle(dismiss: dismiss, height: 57, font: .title3, showsCancel: true))
+                .background(RoundedRectangle(cornerRadius: 14).fill(Color.white))
+                .clipShape(RoundedRectangle(cornerRadius: 14))
+            }
+            .padding(8)
+        }
+    }
+}
+
+/// The cancel button of a dialog: the one given, or one the system adds.
+private struct DialogCancel: _VariadicView_UnaryViewRoot {
+    func body(children: _VariadicView.Children) -> some View {
+        if children.contains(where: { $0[IrisCancelActionTrait.self] }) {
+            VStack(spacing: 0) {
+                children
+            }
+        } else {
+            Button("Cancel", role: .cancel) {}
+        }
+    }
+}
