+/// A type that represents a height where a sheet naturally rests.
+public struct PresentationDetent: Hashable, Sendable {
+    enum Kind: Hashable, Sendable {
+        case medium
+        case large
+        case fraction(CGFloat)
+        case height(CGFloat)
+    }
+
+    var kind: Kind
+
+    /// The system detent for a sheet that's approximately half the height of the screen.
+    public static var medium: PresentationDetent { PresentationDetent(kind: .medium) }
+    /// The system detent for a sheet at full height.
+    public static var large: PresentationDetent { PresentationDetent(kind: .large) }
+
+    /// A custom detent with the specified fractional height.
+    public static func fraction(_ fraction: CGFloat) -> PresentationDetent {
+        PresentationDetent(kind: .fraction(fraction))
+    }
+
+    /// A custom detent with the specified height.
+    public static func height(_ height: CGFloat) -> PresentationDetent {
+        PresentationDetent(kind: .height(height))
+    }
+
+    func height(in full: CGFloat) -> CGFloat {
+        switch kind {
+        case .medium: full / 2
+        case .large: full
+        case let .fraction(fraction): full * fraction
+        case let .height(height): min(height, full)
+        }
+    }
+}
+
+/// Iris: what a sheet's content asks of the sheet.
+struct IrisSheetOptions: Equatable {
+    var detents: Set<PresentationDetent>?
+    var selection: Binding<PresentationDetent>?
+    var dragIndicator: Visibility?
+    var interactiveDismissDisabled: Bool?
+    var cornerRadius: CGFloat?
+    var background: Color?
+
+    mutating func merge(_ other: IrisSheetOptions) {
+        detents = detents ?? other.detents
+        selection = selection ?? other.selection
+        dragIndicator = dragIndicator ?? other.dragIndicator
+        interactiveDismissDisabled = interactiveDismissDisabled ?? other.interactiveDismissDisabled
+        cornerRadius = cornerRadius ?? other.cornerRadius
+        background = background ?? other.background
+    }
+
+    static func == (lhs: IrisSheetOptions, rhs: IrisSheetOptions) -> Bool {
+        lhs.detents == rhs.detents
+            && lhs.selection?.wrappedValue == rhs.selection?.wrappedValue
+            && lhs.dragIndicator == rhs.dragIndicator
+            && lhs.interactiveDismissDisabled == rhs.interactiveDismissDisabled
+            && lhs.cornerRadius == rhs.cornerRadius
+            && lhs.background == rhs.background
+    }
+}
+
+struct IrisSheetOptionsKey: PreferenceKey {
+    static var defaultValue: IrisSheetOptions { IrisSheetOptions() }
+
+    static func reduce(value: inout IrisSheetOptions, nextValue: () -> IrisSheetOptions) {
+        value.merge(nextValue())
+    }
+}
+
+extension View {
+    /// Sets the available detents for the enclosing sheet.
+    public func presentationDetents(_ detents: Set<PresentationDetent>) -> some View {
+        sheetOptions(IrisSheetOptions(detents: detents))
+    }
+
+    /// Sets the available detents for the enclosing sheet, giving you programmatic control of
+    /// the currently selected detent.
+    public func presentationDetents(_ detents: Set<PresentationDetent>, selection: Binding<PresentationDetent>) -> some View {
+        sheetOptions(IrisSheetOptions(detents: detents, selection: selection))
+    }
+
+    /// Sets the visibility of the drag indicator on top of a sheet.
+    public func presentationDragIndicator(_ visibility: Visibility) -> some View {
+        sheetOptions(IrisSheetOptions(dragIndicator: visibility))
+    }
+
+    /// Conditionally prevents interactive dismissal of presentations like popovers, sheets,
+    /// and inspectors.
+    public func interactiveDismissDisabled(_ isDisabled: Bool = true) -> some View {
+        sheetOptions(IrisSheetOptions(interactiveDismissDisabled: isDisabled))
+    }
+
+    /// Requests that the presentation have a specific corner radius.
+    public func presentationCornerRadius(_ cornerRadius: CGFloat?) -> some View {
+        sheetOptions(IrisSheetOptions(cornerRadius: cornerRadius))
+    }
+
+    /// Sets the presentation background of the enclosing sheet to a custom view. Iris: a
+    /// color only.
+    public func presentationBackground(_ color: Color) -> some View {
+        sheetOptions(IrisSheetOptions(background: color))
+    }
+
+    /// Controls whether people can interact with the view behind a presentation. Iris: they
+    /// cannot.
+    public func presentationBackgroundInteraction(_ interaction: PresentationBackgroundInteraction) -> some View {
+        self
+    }
+
+    /// Specifies how to adapt a presentation to compact size classes. Iris: no adaptation.
+    public func presentationCompactAdaptation(_ adaptation: PresentationAdaptation) -> some View {
+        self
+    }
+
+    func sheetOptions(_ options: IrisSheetOptions) -> some View {
+        transformPreference(IrisSheetOptionsKey.self) { value in
+            var outer = options
+            outer.merge(value)
+            value = outer
+        }
+    }
+}
+
+/// The kinds of interaction available to views behind a presentation.
+public struct PresentationBackgroundInteraction: Sendable {
+    public static var automatic: PresentationBackgroundInteraction { .init() }
+    public static var enabled: PresentationBackgroundInteraction { .init() }
+    public static var disabled: PresentationBackgroundInteraction { .init() }
+
+    public static func enabled(upThrough detent: PresentationDetent) -> PresentationBackgroundInteraction {
+        .init()
+    }
+}
+
+/// Strategies for adapting a presentation to a different size class.
+public struct PresentationAdaptation: Sendable {
+    public static var automatic: PresentationAdaptation { .init() }
+    public static var none: PresentationAdaptation { .init() }
+    public static var popover: PresentationAdaptation { .init() }
+    public static var sheet: PresentationAdaptation { .init() }
+    public static var fullScreenCover: PresentationAdaptation { .init() }
+}
+
+/// A page sheet: rounded at the top, 10 points below the top of the screen at full height,
+/// resting at its detents; a drag down dismisses it.
+private struct SheetContainer: View {
+    var presentation: IrisPresentation
+    @State private var options = IrisSheetOptions()
+    @State private var detent: PresentationDetent?
+    @GestureState private var drag: CGFloat = 0
+
+    var body: some View {
+        GeometryReader { proxy in
+            let full = max(proxy.size.height - 10, 0)
+            let detents = (options.detents ?? [.large]).sorted { $0.height(in: full) < $1.height(in: full) }
+            let current = options.selection?.wrappedValue ?? detent ?? detents.first ?? .large
+            let height = current.height(in: full)
+            let radius = options.cornerRadius ?? 10
+            let showsIndicator = options.dragIndicator == .visible || (options.dragIndicator != .hidden && detents.count > 1)
+            ZStack(alignment: .bottom) {
+                dimming
+                presentation.content.view
+                    .frame(maxWidth: .infinity, maxHeight: .infinity)
+                    .onPreferenceChange(IrisSheetOptionsKey.self) { options = $0 }
+                    .padding(.bottom, radius)
+                    .frame(height: height + radius)
+                    .background(options.background ?? Color.white)
+                    .clipShape(RoundedRectangle(cornerRadius: radius))
+                    .overlay(alignment: .top) {
+                        if showsIndicator {
+                            Capsule()
+                                .fill(Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.3))
+                                .frame(width: 36, height: 5)
+                                .padding(.top, 5)
+                        }
+                    }
+                    .offset(y: radius + max(drag, -20))
+                    .gesture(
+                        DragGesture()
+                            .updating($drag) { value, drag, _ in
+                                drag = value.translation.height
+                            }
+                            .onEnded { value in
+                                settle(
+                                    from: height,
+                                    to: height - value.predictedEndTranslation.height,
+                                    detents: detents,
+                                    full: full
+                                )
+                            }
+                    )
+            }
+            .transformPreference(IrisSheetOptionsKey.self) { $0 = IrisSheetOptions() }
+        }
+    }
+
+    /// Rests the sheet at the detent closest to where a drag would take it, or dismisses it
+    /// when that is well below the lowest one.
+    private func settle(from height: CGFloat, to target: CGFloat, detents: [PresentationDetent], full: CGFloat) {
+        guard let lowest = detents.first else { return }
+        if target < lowest.height(in: full) / 2, options.interactiveDismissDisabled != true {
+            presentation.dismiss()
+            return
+        }
+        let closest = detents.min { abs($0.height(in: full) - target) < abs($1.height(in: full) - target) } ?? lowest
+        withAnimation(.spring(duration: 0.4)) {
+            if let selection = options.selection {
+                selection.wrappedValue = closest
+            } else {
+                detent = closest
+            }
+        }
+    }
+}
