+// MARK: - Alerts and dialogs
+
+/// The look of a button in an alert or a dialog: its role picks the color and weight, and
+/// a tap dismisses the presentation before running the action.
+private struct ModalActionButtonStyle: PrimitiveButtonStyle {
+    var dismiss: () -> Void
+    var height: CGFloat
+    var font: Font
+    var showsCancel: Bool?
+
+    func makeBody(configuration: Configuration) -> some View {
+        let isCancel = configuration.role == .cancel
+        if showsCancel.map({ $0 == isCancel }) ?? true {
+            VStack(spacing: 0) {
+                separator.frame(height: 0.33)
+                configuration.label
+                    .font(isCancel ? font.weight(.semibold) : font)
+                    .foregroundStyle(configuration.role == .destructive ? systemRed : Color.accentColor)
+                    .lineLimit(1)
+                    .frame(maxWidth: .infinity, minHeight: height)
+                    .contentShape(Rectangle())
+                    .onTapGesture {
+                        dismiss()
+                        configuration.trigger()
+                    }
+            }
+        }
+    }
+}
