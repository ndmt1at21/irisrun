+// MARK: - Alert and ActionSheet
+
+/// A representation of an alert presentation.
+public struct Alert {
+    var title: Text
+    var message: Text?
+    var buttons: [Button]
+
+    /// Creates an alert with one button.
+    public init(title: Text, message: Text? = nil, dismissButton: Button? = nil) {
+        self.title = title
+        self.message = message
+        buttons = dismissButton.map { [$0] } ?? []
+    }
+
+    /// Creates an alert with two buttons.
+    public init(title: Text, message: Text? = nil, primaryButton: Button, secondaryButton: Button) {
+        self.title = title
+        self.message = message
+        buttons = [primaryButton, secondaryButton]
+    }
+
+    /// A button representing an operation of an alert presentation.
+    public struct Button {
+        var label: Text
+        var role: ButtonRole?
+        var action: (() -> Void)?
+
+        /// Creates an alert button with the default style.
+        public static func `default`(_ label: Text, action: (() -> Void)? = {}) -> Button {
+            Button(label: label, role: nil, action: action)
+        }
+
+        /// Creates an alert button that indicates cancellation, with a custom label.
+        public static func cancel(_ label: Text, action: (() -> Void)? = {}) -> Button {
+            Button(label: label, role: .cancel, action: action)
+        }
+
+        /// Creates an alert button that indicates cancellation, with a system-provided label.
+        public static func cancel(_ action: (() -> Void)? = {}) -> Button {
+            Button(label: Text(verbatim: "Cancel"), role: .cancel, action: action)
+        }
+
+        /// Creates an alert button with a style that indicates a destructive action.
+        public static func destructive(_ label: Text, action: (() -> Void)? = {}) -> Button {
+            Button(label: label, role: .destructive, action: action)
+        }
+    }
+
+    var actions: some View {
+        ForEach(Array(buttons.enumerated()), id: \.offset) { _, button in
+            OpenSwiftUI.Button(role: button.role, action: { button.action?() }) {
+                button.label
+            }
+        }
+    }
+}
+
+/// A representation of an action sheet presentation.
+public struct ActionSheet {
+    var title: Text
+    var message: Text?
+    var buttons: [Alert.Button]
+
+    /// Creates an action sheet with the provided buttons.
+    public init(title: Text, message: Text? = nil, buttons: [Alert.Button] = [.cancel()]) {
+        self.title = title
+        self.message = message
+        self.buttons = buttons
+    }
+
+    public typealias Button = Alert.Button
+}
+
+extension View {
+    /// Presents an alert to the user.
+    public func alert(isPresented: Binding<Bool>, content: () -> Alert) -> some View {
+        let alert = content()
+        return self.alert(alert.title, isPresented: isPresented) {
+            alert.actions
+        } message: {
+            alert.message
+        }
+    }
+
+    /// Presents an alert to the user, using an item as the data source.
+    public func alert<Item>(item: Binding<Item?>, content: (Item) -> Alert) -> some View where Item: Identifiable {
+        let alert = item.wrappedValue.map(content)
+        let isPresented = Binding(
+            get: { item.wrappedValue != nil },
+            set: { if !$0 { item.wrappedValue = nil } }
+        )
+        return self.alert(alert?.title ?? Text(verbatim: ""), isPresented: isPresented) {
+            alert?.actions
+        } message: {
+            alert?.message
+        }
+    }
+
+    /// Presents an action sheet when a given condition is true.
+    public func actionSheet(isPresented: Binding<Bool>, content: () -> ActionSheet) -> some View {
+        let sheet = content()
+        let alert = Alert(title: sheet.title, message: sheet.message, dismissButton: nil)
+        let actions = Alert(title: sheet.title, message: nil, buttons: sheet.buttons).actions
+        return confirmationDialog(alert.title, isPresented: isPresented, titleVisibility: .visible) {
+            actions
+        } message: {
+            alert.message
+        }
+    }
+}
+
+extension Alert {
+    fileprivate init(title: Text, message: Text?, buttons: [Button]) {
+        self.title = title
+        self.message = message
+        self.buttons = buttons
+    }
+}
