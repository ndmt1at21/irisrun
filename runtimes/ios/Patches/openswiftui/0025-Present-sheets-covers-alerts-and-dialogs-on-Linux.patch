+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: sheets, covers, alerts and confirmation dialogs, until upstream has presentations.
+// As in SwiftUI, a presented view travels up as a preference, here to the presentation host
+// at the root of the scene, which shows it over the app with the environment of the view
+// that presented it. ponytail: no appear or disappear animation yet.
+
+/// systemRed.
+private let systemRed = Color(red: 1, green: 59 / 255, blue: 48 / 255)
+/// secondaryLabel.
+private let secondaryLabel = Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.6)
+/// separator.
+private let separator = Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.29)
+/// The background of alerts and dialogs: a light material, opaque here.
+private let materialBackground = Color(red: 242 / 255, green: 242 / 255, blue: 242 / 255)
+/// The dimming behind a modal presentation.
+private let dimming = Color(red: 0, green: 0, blue: 0, opacity: 0.2)
+
+// MARK: - Presentations
+
+/// Iris: a view presented over the app.
+struct IrisPresentation: Equatable {
+    enum Kind: Equatable {
+        case sheet
+        case fullScreenCover
+        case alert
+        case dialog
+    }
+
+    var id: AnyHashable
+    var kind: Kind
+    var content: IrisCarriedView
+    var dismiss: () -> Void
+
+    static func == (lhs: IrisPresentation, rhs: IrisPresentation) -> Bool {
+        lhs.id == rhs.id && lhs.kind == rhs.kind && lhs.content == rhs.content
+    }
+}
+
+struct IrisPresentationKey: PreferenceKey {
+    static var defaultValue: [IrisPresentation] { [] }
+
+    static func reduce(value: inout [IrisPresentation], nextValue: () -> [IrisPresentation]) {
+        value += nextValue()
+    }
+}
+
+/// Iris: shows what the views of a scene present, each over the app and the ones before.
+struct IrisPresentationHost: ViewModifier {
+    @State private var presentations: [IrisPresentation] = []
+
+    func body(content: Content) -> some View {
+        content
+            .overlay {
+                ZStack {
+                    ForEach(presentations, id: \.id) { presentation in
+                        switch presentation.kind {
+                        case .sheet:
+                            SheetContainer(presentation: presentation)
+                        case .fullScreenCover:
+                            presentation.content.view
+                                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                                .background(Color.white)
+                        case .alert:
+                            presentation.content.view
+                        case .dialog:
+                            presentation.content.view
+                        }
+                    }
+                }
+            }
+            // After the overlay, to see what presented views present in turn.
+            .onPreferenceChange(IrisPresentationKey.self) { presentations = $0 }
+            .transformPreference(IrisPresentationKey.self) { $0 = [] }
+    }
+}
+
+/// Identifies a view that presents.
+private final class PresenterID {}
+
+/// Presents `content` while `isPresented` is true.
+private struct PresentationModifier<Presented>: ViewModifier where Presented: View {
+    var kind: IrisPresentation.Kind
+    @Binding var isPresented: Bool
+    /// What is presented, when it changes with the data presented: a new one is presented
+    /// as a new view.
+    var dataID: AnyHashable?
+    var onDismiss: (() -> Void)?
+    var presented: () -> Presented
+
+    @State private var presenter = PresenterID()
+    @Environment(\.self) private var environment
+
+    func body(content: Content) -> some View {
+        let presentation: IrisPresentation? = if isPresented {
+            makePresentation()
+        } else {
+            nil
+        }
+        content
+            .transformPreference(IrisPresentationKey.self) { value in
+                if let presentation {
+                    value.append(presentation)
+                }
+            }
+            .onChange(of: isPresented) { wasPresented, isPresented in
+                if wasPresented, !isPresented {
+                    onDismiss?()
+                }
+            }
+    }
+
+    private func makePresentation() -> IrisPresentation {
+        let binding = $isPresented
+        let id = AnyHashable([AnyHashable(ObjectIdentifier(presenter)), dataID ?? AnyHashable(0)])
+        let dismiss = DismissAction(id: id) {
+            binding.wrappedValue = false
+        }
+        var environment = environment
+        // What presented the view does not reach into it.
+        environment.irisNavigator = nil
+        environment.irisListRow = false
+        environment.irisGroupedRows = false
+        environment.dismiss = dismiss
+        environment.isPresented = true
+        let view = presented().environment(\.self, environment)
+        return IrisPresentation(id: id, kind: kind, content: IrisCarriedView(view), dismiss: dismiss.callAsFunction)
+    }
+}
+
+extension View {
+    /// Presents a sheet when a binding to a Boolean value that you provide is true.
+    public func sheet<Content>(isPresented: Binding<Bool>, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping () -> Content) -> some View where Content: View {
+        modifier(PresentationModifier(kind: .sheet, isPresented: isPresented, onDismiss: onDismiss, presented: content))
+    }
+
+    /// Presents a sheet using the given item as a data source for the sheet's content.
+    public func sheet<Item, Content>(item: Binding<Item?>, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping (Item) -> Content) -> some View where Item: Identifiable, Content: View {
+        modifier(itemPresentation(.sheet, item: item, onDismiss: onDismiss, content: content))
+    }
+
+    /// Presents a modal view that covers as much of the screen as possible when binding to a
+    /// Boolean value you provide is true.
+    public func fullScreenCover<Content>(isPresented: Binding<Bool>, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping () -> Content) -> some View where Content: View {
+        modifier(PresentationModifier(kind: .fullScreenCover, isPresented: isPresented, onDismiss: onDismiss, presented: content))
+    }
+
+    /// Presents a modal view that covers as much of the screen as possible using the binding
+    /// you provide as a data source for the sheet's content.
+    public func fullScreenCover<Item, Content>(item: Binding<Item?>, onDismiss: (() -> Void)? = nil, @ViewBuilder content: @escaping (Item) -> Content) -> some View where Item: Identifiable, Content: View {
+        modifier(itemPresentation(.fullScreenCover, item: item, onDismiss: onDismiss, content: content))
+    }
+
+    /// Presents a popover when a given condition is true. Iris: a sheet, as on an iPhone.
+    public func popover<Content>(isPresented: Binding<Bool>, attachmentAnchor: PopoverAttachmentAnchor = .point(.center), arrowEdge: Edge? = nil, @ViewBuilder content: @escaping () -> Content) -> some View where Content: View {
+        sheet(isPresented: isPresented, content: content)
+    }
+
+    /// Presents a popover using the given item as a data source for the popover's content.
+    /// Iris: a sheet, as on an iPhone.
+    public func popover<Item, Content>(item: Binding<Item?>, attachmentAnchor: PopoverAttachmentAnchor = .point(.center), arrowEdge: Edge? = nil, @ViewBuilder content: @escaping (Item) -> Content) -> some View where Item: Identifiable, Content: View {
+        sheet(item: item, content: content)
+    }
+
+    fileprivate func itemPresentation<Item, Content>(
+        _ kind: IrisPresentation.Kind,
+        item: Binding<Item?>,
+        onDismiss: (() -> Void)?,
+        content: @escaping (Item) -> Content
+    ) -> PresentationModifier<Content?> where Item: Identifiable, Content: View {
+        let isPresented = Binding(
+            get: { item.wrappedValue != nil },
+            set: { if !$0 { item.wrappedValue = nil } }
+        )
+        let value = item.wrappedValue
+        return PresentationModifier(
+            kind: kind,
+            isPresented: isPresented,
+            dataID: value.map { AnyHashable($0.id) },
+            onDismiss: onDismiss,
+            presented: { value.map(content) }
+        )
+    }
+}
