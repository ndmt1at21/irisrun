+++ b/Sources/OpenSwiftUI/App/App/Stdout/IrisDevice.swift
@@ -0,0 +1,240 @@
+//
+//  IrisDevice.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+@_spi(StdoutRenderer)
+import OpenSwiftUICore
+import IrisProtocol
+import IrisRender
+
+/// Iris: keeps stdout for the Device Protocol and sends what the app prints to stderr instead,
+/// where irisrun shows it as logs. Call it before anything prints.
+func takeStandardOutput() -> FileHandle {
+    fflush(stdout)
+    let protocolOutput = dup(STDOUT_FILENO)
+    dup2(STDERR_FILENO, STDOUT_FILENO)
+    return FileHandle(fileDescriptor: protocolOutput, closeOnDealloc: true)
+}
+
+/// Iris: runs the app as a device of the Device Protocol on stdio, as `irisrun start` runs it:
+/// size-delimited HostMessage envelopes come in on stdin and DeviceMessage envelopes go out on
+/// stdout. Input is handled on the main run loop; frames are drawn by the render core when the
+/// display list changes and encoded as JPEG on another thread.
+final class IrisDevice<Content> where Content: View {
+    private let host: StdoutRendererHost<Content>
+    private let input: DeviceInput
+    private let scale: Float
+    private let output: FileHandle
+    /// Encodes and writes, in order, everything sent to the host.
+    private let writer = DispatchQueue(label: "dev.irisrun.device.writer")
+    private let lock = NSLock()
+    private var newestFrame: UInt64 = 0
+    private var sequence: UInt64 = 0
+    private var shownVersion = -1
+    private var nextRender: DispatchTime?
+
+    /// `output` is what `takeStandardOutput()` returns.
+    init(host: StdoutRendererHost<Content>, input: DeviceInput, scale: Float, output: FileHandle) {
+        self.host = host
+        self.input = input
+        self.scale = scale
+        self.output = output
+    }
+
+    func run() -> Never {
+        let size = host.options.surface
+        send(.with {
+            $0.deviceInfo = .with {
+                $0.platform = .ios
+                $0.kind = .localRuntime
+                $0.model = "iPhone 14"
+                $0.osVersion = "18.0"
+                $0.display = .with {
+                    $0.widthPx = UInt32((Float(size.width) * scale).rounded())
+                    $0.heightPx = UInt32((Float(size.height) * scale).rounded())
+                    $0.scale = scale
+                }
+            }
+        })
+        send(status(.launching))
+        host.onRequestUpdate = { [unowned self] delay in
+            scheduleRender(after: delay)
+        }
+        render()
+        send(status(.foreground))
+        Thread.detachNewThread { [self] in
+            readHostMessages()
+        }
+        // A timer keeps the run loop running while nothing else is scheduled.
+        RunLoop.main.add(Timer(timeInterval: 3600, repeats: true) { _ in }, forMode: .default)
+        while true {
+            RunLoop.main.run(mode: .default, before: .distantFuture)
+        }
+    }
+
+    // MARK: Host messages
+
+    private func readHostMessages() {
+        while let envelope = Self.readEnvelope() {
+            guard let message = try? IrisHostMessage(serializedBytes: envelope) else {
+                fputs("irisrun: dropped an envelope that is not a HostMessage\n", stderr)
+                continue
+            }
+            DispatchQueue.main.async { [self] in
+                handle(message)
+            }
+        }
+        // The host closed stdin: it has gone, and so does the app.
+        exit(0)
+    }
+
+    private func handle(_ message: IrisHostMessage) {
+        guard case let .input(event)? = message.payload else {
+            // ponytail: display configuration and adapters come with P1-28 and P1-17.
+            return
+        }
+        // Gestures inside views time touches with the view graph's clock, so bring it up to
+        // now first: a clock left at the last frame, then moved on by a frame in the middle
+        // of a tap, makes the tap seem held too long.
+        render()
+        switch event.event {
+        case let .touch(touch)?:
+            input.touch(touch.touches.map { point in
+                DeviceInput.Touch(
+                    id: point.id,
+                    phase: Self.phase(point.phase),
+                    location: CGPoint(x: CGFloat(point.x / scale), y: CGFloat(point.y / scale))
+                )
+            })
+        case let .text(edit)?:
+            switch edit.edit {
+            case let .commitText(text)?:
+                input.commit(text)
+            case let .setComposingText(text)?:
+                input.compose(text)
+            case let .deleteSurroundingText(range)?:
+                input.deleteSurrounding(before: Int(range.beforeLength), after: Int(range.afterLength))
+            case nil:
+                break
+            }
+        case let .key(key)? where key.action == .down:
+            input.press(key.code, command: key.meta)
+        default:
+            return
+        }
+        // Answer input at once rather than at the next requested update.
+        render()
+    }
+
+    private static func phase(_ phase: IrisTouchPhase) -> DeviceInput.Phase {
+        switch phase {
+        case .began: .began
+        case .moved: .moved
+        case .ended: .ended
+        case .cancelled: .cancelled
+        default: .stationary
+        }
+    }
+
+    // MARK: Frames
+
+    /// Renders on the main run loop after `delay` seconds, at most 60 times a second.
+    private func scheduleRender(after delay: Double) {
+        let time = DispatchTime.now() + max(delay, 1.0 / 60)
+        if let nextRender, nextRender <= time {
+            return
+        }
+        nextRender = time
+        DispatchQueue.main.asyncAfter(deadline: time) { [self] in
+            guard let nextRender, nextRender <= .now() else { return }
+            render()
+        }
+    }
+
+    private func render() {
+        nextRender = nil
+        // The view graph runs on the clock touch events carry, as UIKit hosts' do.
+        host.render(interval: max(Time.systemUptime - host.currentTimestamp, 0), targetTimestamp: nil)
+        guard irisSceneVersion != shownVersion else { return }
+        shownVersion = irisSceneVersion
+        sequence += 1
+        let sequence = sequence
+        let frame = irisScene.render()
+        lock.withLock { newestFrame = sequence }
+        writer.async { [self] in
+            // Frames the encoder fell behind on are skipped: the newest shows everything.
+            guard lock.withLock({ newestFrame == sequence }), let jpeg = frame.encode(.jpeg, quality: 85) else {
+                return
+            }
+            write(.with {
+                $0.frame = .with {
+                    $0.sequence = sequence
+                    $0.format = .jpeg
+                    $0.data = Data(jpeg)
+                }
+            })
+        }
+    }
+
+    // MARK: Envelopes
+
+    private func status(_ state: IrisAppState) -> IrisDeviceMessage {
+        .with {
+            $0.appStatus = .with {
+                $0.state = state
+                $0.appID = Bundle.main.bundleIdentifier ?? ProcessInfo.processInfo.processName
+            }
+        }
+    }
+
+    private func send(_ message: IrisDeviceMessage) {
+        writer.async { [self] in
+            write(message)
+        }
+    }
+
+    /// On the writer queue.
+    private func write(_ message: IrisDeviceMessage) {
+        guard let payload: [UInt8] = try? message.serializedBytes() else { return }
+        var envelope: [UInt8] = []
+        var length = UInt64(payload.count)
+        repeat {
+            envelope.append(UInt8(length & 0x7F) | (length > 0x7F ? 0x80 : 0))
+            length >>= 7
+        } while length > 0
+        envelope += payload
+        output.write(Data(envelope))
+    }
+
+    /// The next size-delimited envelope on stdin, or nil once it ends.
+    private static func readEnvelope() -> [UInt8]? {
+        var length: UInt64 = 0
+        for shift in stride(from: 0, to: 64, by: 7) {
+            guard let byte = readExactly(1)?.first else { return nil }
+            length |= UInt64(byte & 0x7F) << shift
+            if byte & 0x80 == 0 {
+                return readExactly(Int(length))
+            }
+        }
+        return nil
+    }
+
+    private static func readExactly(_ count: Int) -> [UInt8]? {
+        var bytes = [UInt8](repeating: 0, count: count)
+        var done = 0
+        while done < count {
+            let read = bytes.withUnsafeMutableBytes { buffer in
+                Glibc.read(STDIN_FILENO, buffer.baseAddress! + done, count - done)
+            }
+            guard read > 0 else { return nil }
+            done += read
+        }
+        return bytes
+    }
+}
+#endif
