+//
+//  Path+Elements.swift
+//  OpenSwiftUICore
+//
+//  Status: Iris
+
+package import Foundation
+package import OpenCoreGraphicsShims
+
+// Iris: paths as a list of elements, in Swift. Upstream builds paths with OpenRenderBox, which
+// cannot hold them on Linux yet, and leaves move(to:), addLine(to:) and the like unimplemented.
+// Curves are flattened into 16 segments wherever a point set is needed: hit-testing, bounds
+// and trimming.
+
+extension Path {
+    /// The elements of the path, with rectangles, ellipses and rounded rectangles spelled out.
+    /// A stroked path gives the line it strokes.
+    package var elements: [Element] {
+        switch storage {
+        case .empty:
+            []
+        case let .rect(rect):
+            Self.elements(rect: rect)
+        case let .ellipse(rect):
+            Self.elements(ellipseIn: rect)
+        case let .roundedRect(rounded):
+            Self.elements(roundedRect: rounded.rect, cornerSize: rounded.cornerSize)
+        case let .elements(elements):
+            elements
+        case let .stroked(stroked):
+            stroked.path.elements
+        case let .trimmed(trimmed):
+            trimmed.path.trimmedElements(from: trimmed.from, to: trimmed.to)
+        case .path:
+            // CoreGraphics or OpenRenderBox paths, which Linux does not make.
+            []
+        }
+    }
+
+    /// Appends elements, turning the path into a list of elements first.
+    package mutating func append(_ newElements: [Element]) {
+        if case var .elements(elements) = storage {
+            // Let go of the storage first so the array grows in place.
+            storage = .empty
+            elements.append(contentsOf: newElements)
+            storage = .elements(elements)
+        } else {
+            storage = .elements(elements + newElements)
+        }
+    }
+
+    /// The point the next element starts from: after closeSubpath, the subpath's start.
+    package var lastPoint: CGPoint? {
+        var start: CGPoint?
+        var last: CGPoint?
+        for element in elements {
+            switch element {
+            case let .move(point):
+                start = point
+                last = point
+            case let .line(point), let .quadCurve(point, _), let .curve(point, _, _):
+                last = point
+            case .closeSubpath:
+                last = start
+            }
+        }
+        return last
+    }
+
+    // MARK: Shapes as elements
+
+    package static func elements(rect: CGRect) -> [Element] {
+        guard !rect.isNull else { return [] }
+        let r = rect.standardized
+        return [
+            .move(to: CGPoint(x: r.minX, y: r.minY)),
+            .line(to: CGPoint(x: r.maxX, y: r.minY)),
+            .line(to: CGPoint(x: r.maxX, y: r.maxY)),
+            .line(to: CGPoint(x: r.minX, y: r.maxY)),
+            .closeSubpath,
+        ]
+    }
+
+    package static func elements(ellipseIn rect: CGRect) -> [Element] {
+        guard !rect.isNull else { return [] }
+        let r = rect.standardized
+        return elements(roundedRect: r, cornerSize: CGSize(width: r.width / 2, height: r.height / 2))
+    }
+
+    /// Continuous corners count as circular ones.
+    package static func elements(roundedRect rect: CGRect, cornerSize: CGSize) -> [Element] {
+        let radius = cornerSize
+        return elements(roundedRect: rect, radii: (radius, radius, radius, radius))
+    }
+
+    /// Corners in the order top-left, top-right, bottom-right, bottom-left.
+    package static func elements(
+        roundedRect rect: CGRect,
+        radii: (CGSize, CGSize, CGSize, CGSize)
+    ) -> [Element] {
+        guard !rect.isNull else { return [] }
+        let r = rect.standardized
+        func clamp(_ size: CGSize) -> CGSize {
+            CGSize(width: min(max(size.width, 0), r.width / 2), height: min(max(size.height, 0), r.height / 2))
+        }
+        let (tl, tr, br, bl) = (clamp(radii.0), clamp(radii.1), clamp(radii.2), clamp(radii.3))
+        // How far along a tangent the control points of a quarter ellipse sit.
+        let k = 0.5522847498
+        return [
+            .move(to: CGPoint(x: r.minX + tl.width, y: r.minY)),
+            .line(to: CGPoint(x: r.maxX - tr.width, y: r.minY)),
+            .curve(
+                to: CGPoint(x: r.maxX, y: r.minY + tr.height),
+                control1: CGPoint(x: r.maxX - tr.width + k * tr.width, y: r.minY),
+                control2: CGPoint(x: r.maxX, y: r.minY + tr.height - k * tr.height)
+            ),
+            .line(to: CGPoint(x: r.maxX, y: r.maxY - br.height)),
+            .curve(
+                to: CGPoint(x: r.maxX - br.width, y: r.maxY),
+                control1: CGPoint(x: r.maxX, y: r.maxY - br.height + k * br.height),
+                control2: CGPoint(x: r.maxX - br.width + k * br.width, y: r.maxY)
+            ),
+            .line(to: CGPoint(x: r.minX + bl.width, y: r.maxY)),
+            .curve(
+                to: CGPoint(x: r.minX, y: r.maxY - bl.height),
+                control1: CGPoint(x: r.minX + bl.width - k * bl.width, y: r.maxY),
+                control2: CGPoint(x: r.minX, y: r.maxY - bl.height + k * bl.height)
+            ),
+            .line(to: CGPoint(x: r.minX, y: r.minY + tl.height)),
+            .curve(
+                to: CGPoint(x: r.minX + tl.width, y: r.minY),
+                control1: CGPoint(x: r.minX, y: r.minY + tl.height - k * tl.height),
+                control2: CGPoint(x: r.minX + tl.width - k * tl.width, y: r.minY)
+            ),
+            .closeSubpath,
+        ]
+    }
+
+    /// An arc of a circle as cubic curves of at most a quarter turn each, from `start` turning
+    /// by `delta` radians; positive turns clockwise on screen, y pointing down.
+    package static func arcElements(center: CGPoint, radius: CGFloat, start: Double, delta: Double) -> [Element] {
+        let pieces = max(Int((abs(delta) / (.pi / 2)).rounded(.up)), 1)
+        let step = delta / Double(pieces)
+        let k = 4.0 / 3.0 * tan(step / 4)
+        var elements: [Element] = []
+        var angle = start
+        for _ in 0 ..< pieces {
+            let next = angle + step
+            let p0 = CGPoint(x: center.x + radius * cos(angle), y: center.y + radius * sin(angle))
+            let p3 = CGPoint(x: center.x + radius * cos(next), y: center.y + radius * sin(next))
+            elements.append(.curve(
+                to: p3,
+                control1: CGPoint(x: p0.x - k * radius * sin(angle), y: p0.y + k * radius * cos(angle)),
+                control2: CGPoint(x: p3.x + k * radius * sin(next), y: p3.y - k * radius * cos(next))
+            ))
+            angle = next
+        }
+        return elements
+    }
+
+    // MARK: Points
+
+    /// The path as polylines, one per subpath, and whether each is closed.
+    package var polylines: [(points: [CGPoint], isClosed: Bool)] {
+        var result: [(points: [CGPoint], isClosed: Bool)] = []
+        var points: [CGPoint] = []
+        func finish(closed: Bool) {
+            if !points.isEmpty {
+                result.append((points, closed))
+            }
+            points = []
+        }
+        for element in elements {
+            switch element {
+            case let .move(point):
+                finish(closed: false)
+                points = [point]
+            case let .line(point):
+                points.append(point)
+            case let .quadCurve(point, control):
+                let start = points.last ?? point
+                for i in 1 ... 16 {
+                    let t = CGFloat(i) / 16
+                    let a = (1 - t) * (1 - t), b = 2 * (1 - t) * t, c = t * t
+                    points.append(CGPoint(
+                        x: a * start.x + b * control.x + c * point.x,
+                        y: a * start.y + b * control.y + c * point.y
+                    ))
+                }
+            case let .curve(point, control1, control2):
+                let start = points.last ?? point
+                for i in 1 ... 16 {
+                    let t = CGFloat(i) / 16
+                    let u = 1 - t
+                    let a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t
+                    points.append(CGPoint(
+                        x: a * start.x + b * control1.x + c * control2.x + d * point.x,
+                        y: a * start.y + b * control1.y + c * control2.y + d * point.y
+                    ))
+                }
+            case .closeSubpath:
+                let start = points.first
+                finish(closed: true)
+                // A subpath closed without a move starts where the last one started.
+                if let start {
+                    points = [start]
+                }
+            }
+        }
+        finish(closed: false)
+        return result.filter { $0.points.count > 1 || $0.isClosed }
+    }
+
+    package var elementsBoundingRect: CGRect {
+        let points = polylines.flatMap(\.points)
+        guard let first = points.first else { return .null }
+        var minX = first.x, maxX = first.x, minY = first.y, maxY = first.y
+        for point in points {
+            minX = min(minX, point.x)
+            maxX = max(maxX, point.x)
+            minY = min(minY, point.y)
+            maxY = max(maxY, point.y)
+        }
+        return CGRect(x: minX, y: minY, width: maxX - minX, height: maxY - minY)
+    }
+
+    /// Whether the area the path fills holds the point, by its winding number.
+    package func elementsContain(_ point: CGPoint, eoFill: Bool) -> Bool {
+        var winding = 0
+        for polyline in polylines {
+            let points = polyline.points
+            for (index, a) in points.enumerated() {
+                // Fills close every subpath.
+                let b = points[(index + 1) % points.count]
+                if a.y <= point.y {
+                    if b.y > point.y, cross(a, b, point) > 0 {
+                        winding += 1
+                    }
+                } else if b.y <= point.y, cross(a, b, point) < 0 {
+                    winding -= 1
+                }
+            }
+        }
+        return eoFill ? winding % 2 != 0 : winding != 0
+    }
+
+    /// Whether the point is within `distance` of the path's line.
+    package func lineContains(_ point: CGPoint, within distance: CGFloat) -> Bool {
+        for polyline in polylines {
+            var points = polyline.points
+            if polyline.isClosed, let first = points.first {
+                points.append(first)
+            }
+            for index in points.indices.dropLast() {
+                if distanceToSegment(point, points[index], points[index + 1]) <= distance {
+                    return true
+                }
+            }
+        }
+        return false
+    }
+
+    /// The part of the path from `from` to `to`, as fractions of its length, in line segments.
+    package func trimmedElements(from: CGFloat, to: CGFloat) -> [Element] {
+        var segments: [(CGPoint, CGPoint)] = []
+        for polyline in polylines {
+            var points = polyline.points
+            if polyline.isClosed, let first = points.first {
+                points.append(first)
+            }
+            for index in points.indices.dropLast() {
+                segments.append((points[index], points[index + 1]))
+            }
+        }
+        let lengths = segments.map { hypot($0.1.x - $0.0.x, $0.1.y - $0.0.y) }
+        let total = lengths.reduce(0, +)
+        guard total > 0, to > from else { return [] }
+        let start = max(from, 0) * total
+        let end = min(to, 1) * total
+        var result: [Element] = []
+        var walked: CGFloat = 0
+        var last: CGPoint?
+        for (segment, length) in zip(segments, lengths) {
+            defer { walked += length }
+            guard walked + length > start, walked < end, length > 0 else { continue }
+            let a = interpolate(segment, (max(start, walked) - walked) / length)
+            let b = interpolate(segment, (min(end, walked + length) - walked) / length)
+            if last != a {
+                result.append(.move(to: a))
+            }
+            result.append(.line(to: b))
+            last = b
+        }
+        return result
+    }
+
+    /// The elements with every point mapped by `transform`.
+    package func elementsApplying(_ transform: CGAffineTransform) -> [Element] {
+        elements.map { element in
+            switch element {
+            case let .move(point): .move(to: point.applying(transform))
+            case let .line(point): .line(to: point.applying(transform))
+            case let .quadCurve(point, control):
+                .quadCurve(to: point.applying(transform), control: control.applying(transform))
+            case let .curve(point, control1, control2):
+                .curve(
+                    to: point.applying(transform),
+                    control1: control1.applying(transform),
+                    control2: control2.applying(transform)
+                )
+            case .closeSubpath: .closeSubpath
+            }
+        }
+    }
+}
+
+private func cross(_ a: CGPoint, _ b: CGPoint, _ p: CGPoint) -> CGFloat {
+    (b.x - a.x) * (p.y - a.y) - (p.x - a.x) * (b.y - a.y)
+}
+
+private func distanceToSegment(_ p: CGPoint, _ a: CGPoint, _ b: CGPoint) -> CGFloat {
+    let dx = b.x - a.x, dy = b.y - a.y
+    let lengthSquared = dx * dx + dy * dy
+    let t = lengthSquared > 0 ? min(max(((p.x - a.x) * dx + (p.y - a.y) * dy) / lengthSquared, 0), 1) : 0
+    return hypot(p.x - (a.x + t * dx), p.y - (a.y + t * dy))
+}
+
+private func interpolate(_ segment: (CGPoint, CGPoint), _ t: CGFloat) -> CGPoint {
+    CGPoint(x: segment.0.x + (segment.1.x - segment.0.x) * t, y: segment.0.y + (segment.1.y - segment.0.y) * t)
+}
