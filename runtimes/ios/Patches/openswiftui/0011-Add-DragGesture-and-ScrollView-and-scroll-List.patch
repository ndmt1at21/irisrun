diff --git a/Sources/OpenSwiftUI/View/Scroll/ScrollView.swift b/Sources/OpenSwiftUI/View/Scroll/ScrollView.swift
new file mode 100644
index 0000000..bb157d3
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Scroll/ScrollView.swift
@@ -0,0 +1,224 @@
+//
+//  ScrollView.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+import OpenAttributeGraphShims
+
+// MARK: - ScrollView
+
+/// A scrollable view.
+///
+/// Iris: made of SwiftUI parts until upstream has one. The content is laid out at its ideal size
+/// along the scrolling axes and moved by a drag. Like UIScrollView, it keeps moving after a
+/// fling, stretches past its edges and springs back, and taps reach the content unless the touch
+/// moved far enough to scroll. No indicators, paging, scroll targets or zooming yet; a touch
+/// during a fling does not stop it where it shows.
+@available(OpenSwiftUI_v1_0, *)
+public struct ScrollView<Content>: View where Content: View {
+    /// The scroll view's content.
+    public var content: Content
+
+    /// The scrollable axes of the scroll view.
+    public var axes: Axis.Set
+
+    /// A value that indicates whether the scroll view displays the scrollable component of the
+    /// content offset, in a way that's suitable for the platform.
+    public var showsIndicators: Bool
+
+    // A reference: gesture callbacks run several times between updates, and @State reads in
+    // them return the value of the last update.
+    @State private var scroll = ScrollState()
+
+    /// Creates a new instance that's scrollable in the direction of the given axis and can
+    /// show indicators while scrolling.
+    public init(_ axes: Axis.Set = .vertical, showsIndicators: Bool = true, @ViewBuilder content: () -> Content) {
+        self.axes = axes
+        self.showsIndicators = showsIndicators
+        self.content = content()
+    }
+
+    public var body: some View {
+        GeometryReader { viewport in
+            content
+                .fixedSize(horizontal: axes.contains(.horizontal), vertical: axes.contains(.vertical))
+                // The content's own size: a frame would cap it at the size the view offers.
+                .onGeometryChange(for: CGSize.self, of: { $0.size }) { size in
+                    scroll.contentSize = size
+                    // Content that shrank pulls the offset back within it.
+                    let offset = clamped(scroll.offset, viewport: viewport.size)
+                    if scroll.dragStart == nil, offset != scroll.offset {
+                        scroll.offset = offset
+                    }
+                }
+                .frame(minWidth: viewport.size.width, minHeight: viewport.size.height, alignment: contentAlignment)
+                .offset(x: -scroll.offset.x, y: -scroll.offset.y)
+                .frame(width: viewport.size.width, height: viewport.size.height, alignment: .topLeading)
+                .clipped()
+                .modifier(HitTestClip())
+                // Drags anywhere in the view scroll it, not only on the content.
+                .contentShape(Rectangle())
+                .highPriorityGesture(scrollGesture(viewport: viewport.size))
+        }
+    }
+
+    /// Content shorter than the view sits at its top, narrower content in its middle, as in
+    /// SwiftUI.
+    private var contentAlignment: Alignment {
+        switch (axes.contains(.horizontal), axes.contains(.vertical)) {
+        case (true, true): .topLeading
+        case (true, false): .leading
+        default: .top
+        }
+    }
+
+    private func scrollGesture(viewport: CGSize) -> some Gesture {
+        DragGesture(scrolling: axes)
+            .onChanged { drag in
+                let start = scroll.dragStart ?? scroll.offset
+                scroll.dragStart = start
+                let wanted = CGPoint(x: start.x - drag.translation.width, y: start.y - drag.translation.height)
+                scroll.offset = stretched(wanted, viewport: viewport)
+            }
+            .onEnded { drag in
+                scroll.dragStart = nil
+                let offset = scroll.offset
+                let isPastEdge = offset != clamped(offset, viewport: viewport)
+                // Where a fling decelerates to, within the content.
+                let target = clamped(
+                    CGPoint(
+                        x: offset.x - (drag.predictedEndLocation.x - drag.location.x),
+                        y: offset.y - (drag.predictedEndLocation.y - drag.location.y)
+                    ),
+                    viewport: viewport
+                )
+                guard target != offset else {
+                    return
+                }
+                let speed = max(abs(drag.velocity.width), abs(drag.velocity.height))
+                withAnimation(isPastEdge ? .spring(duration: 0.4, bounce: 0) : .easeOut(duration: min(max(speed / 2000, 0.3), 1.2))) {
+                    scroll.offset = target
+                }
+            }
+    }
+
+    private func maximumOffset(viewport: CGSize) -> CGPoint {
+        let content = scroll.contentSize
+        return CGPoint(
+            x: axes.contains(.horizontal) ? max(content.width - viewport.width, 0) : 0,
+            y: axes.contains(.vertical) ? max(content.height - viewport.height, 0) : 0
+        )
+    }
+
+    private func clamped(_ point: CGPoint, viewport: CGSize) -> CGPoint {
+        let limit = maximumOffset(viewport: viewport)
+        return CGPoint(x: min(max(point.x, 0), limit.x), y: min(max(point.y, 0), limit.y))
+    }
+
+    /// Past an edge, content follows the finger less and less, as UIScrollView's does.
+    private func stretched(_ point: CGPoint, viewport: CGSize) -> CGPoint {
+        let edge = clamped(point, viewport: viewport)
+        func stretch(_ overshoot: CGFloat, _ dimension: CGFloat) -> CGFloat {
+            guard dimension > 0 else { return 0 }
+            let sign: CGFloat = overshoot < 0 ? -1 : 1
+            return sign * (1 - 1 / (abs(overshoot) * 0.55 / dimension + 1)) * dimension
+        }
+        return CGPoint(
+            x: axes.contains(.horizontal) ? edge.x + stretch(point.x - edge.x, viewport.width) : 0,
+            y: axes.contains(.vertical) ? edge.y + stretch(point.y - edge.y, viewport.height) : 0
+        )
+    }
+}
+
+@available(*, unavailable)
+extension ScrollView: Sendable {}
+
+/// Iris: where a scroll view is. Views observe the offset; the rest only gestures read.
+private final class ScrollState: Observable {
+    private let registrar = ObservationRegistrar()
+    private var _offset = CGPoint.zero
+
+    /// How far the content is scrolled: the point of it at the top-left corner of the view.
+    var offset: CGPoint {
+        get {
+            registrar.access(self, keyPath: \.offset)
+            return _offset
+        }
+        set {
+            guard newValue != _offset else { return }
+            registrar.withMutation(of: self, keyPath: \.offset) { _offset = newValue }
+        }
+    }
+
+    /// The offset when the current drag began.
+    var dragStart: CGPoint?
+    var contentSize = CGSize.zero
+}
+
+// MARK: - HitTestClip
+
+/// Iris: hides the content outside the view from touches too, as the bounds of a UIScrollView
+/// do; `clipped()` only stops drawing it.
+private struct HitTestClip: MultiViewModifier, PrimitiveViewModifier {
+    nonisolated static func _makeView(
+        modifier: _GraphValue<Self>,
+        inputs: _ViewInputs,
+        body: @escaping (_Graph, _ViewInputs) -> _ViewOutputs
+    ) -> _ViewOutputs {
+        var outputs = body(_Graph(), inputs)
+        guard inputs.preferences.requiresViewResponders else {
+            return outputs
+        }
+        outputs.preferences.viewResponders = Attribute(HitTestClipFilter(
+            position: inputs.animatedPosition(),
+            size: inputs.animatedSize(),
+            transform: inputs.transform,
+            children: outputs.viewResponders(),
+            responder: HitTestClipResponder(inputs: inputs)
+        ))
+        return outputs
+    }
+}
+
+private final class HitTestClipResponder: DefaultLayoutViewResponder {
+    var helper = ContentResponderHelper<TrivialContentResponder>()
+
+    override func containsGlobalPoints(
+        _ points: [PlatformPoint],
+        cacheKey: UInt32?,
+        options: ContainsPointsOptions
+    ) -> ContainsPointsResult {
+        var result = super.containsGlobalPoints(points, cacheKey: cacheKey, options: options)
+        let inside = helper.containsGlobalPoints(points, cacheKey: cacheKey, options: options, children: [])
+        result.mask.formIntersection(inside.mask)
+        return result
+    }
+}
+
+private struct HitTestClipFilter: StatefulRule {
+    @Attribute var position: CGPoint
+    @Attribute var size: ViewSize
+    @Attribute var transform: ViewTransform
+    @Attribute var children: [ViewResponder]
+    let responder: HitTestClipResponder
+
+    typealias Value = [ViewResponder]
+
+    mutating func updateValue() {
+        responder.helper.update(
+            data: (TrivialContentResponder(), false),
+            size: $size.changedValue(),
+            position: $position.changedValue(),
+            transform: $transform.changedValue(),
+            parent: responder
+        )
+        responder.updateChildren($children.changedValue())
+        if !hasValue {
+            value = [responder]
+        }
+    }
+}
