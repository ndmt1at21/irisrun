diff --git a/Sources/OpenSwiftUI/Event/Gesture/DragGesture.swift b/Sources/OpenSwiftUI/Event/Gesture/DragGesture.swift
new file mode 100644
index 0000000..536fa3b
--- /dev/null
+++ b/Sources/OpenSwiftUI/Event/Gesture/DragGesture.swift
@@ -0,0 +1,176 @@
+//
+//  DragGesture.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// MARK: - DragGesture
+
+/// A dragging motion that invokes an action as the drag-event sequence changes.
+///
+/// The gesture becomes active once the touch has moved `minimumDistance` points from where it
+/// began, and ends when the touch lifts. A touch that lifts before that fails the gesture, so
+/// taps still reach the views underneath.
+@available(OpenSwiftUI_v1_0, *)
+public struct DragGesture: PubliclyPrimitiveGesture {
+    /// The attributes of a drag gesture.
+    public struct Value: Equatable, @unchecked Sendable {
+        /// The time associated with the drag gesture's current event.
+        public var time: Date
+
+        /// The location of the drag gesture's current event.
+        public var location: CGPoint
+
+        /// The location of the drag gesture's first event.
+        public var startLocation: CGPoint
+
+        /// The current drag velocity, in points per second.
+        public var velocity: CGSize
+
+        /// The total translation from the start of the drag gesture to the current event.
+        public var translation: CGSize {
+            CGSize(width: location.x - startLocation.x, height: location.y - startLocation.y)
+        }
+
+        /// A prediction, based on the current drag velocity, of where the final location will
+        /// be if dragging stopped now.
+        public var predictedEndLocation: CGPoint {
+            CGPoint(
+                x: location.x + velocity.width * Self.projection,
+                y: location.y + velocity.height * Self.projection
+            )
+        }
+
+        /// A prediction, based on the current drag velocity, of what the final translation
+        /// will be if dragging stopped now.
+        public var predictedEndTranslation: CGSize {
+            let end = predictedEndLocation
+            return CGSize(width: end.x - startLocation.x, height: end.y - startLocation.y)
+        }
+
+        /// How far content keeps moving, in seconds of the current velocity, when it
+        /// decelerates like a scroll view at UIScrollView's normal rate (0.998 per ms).
+        static let projection = 0.998 / (1 - 0.998) / 1000
+    }
+
+    /// The minimum dragging distance before the gesture succeeds.
+    public var minimumDistance: CGFloat
+
+    /// The coordinate space in which to receive location values.
+    public var coordinateSpace: CoordinateSpace
+
+    /// Iris: the gesture fails when the touch first moves past `minimumDistance` along any other
+    /// axis, as a scroll view's pan does, so that a scroll view in another one gets the touch.
+    package var axes: Axis.Set = [.horizontal, .vertical]
+
+    /// Creates a dragging gesture with the minimum dragging distance before the gesture
+    /// succeeds and the coordinate space of the gesture's location.
+    @available(*, deprecated, message: "use overload that accepts a CoordinateSpaceProtocol instead")
+    @_disfavoredOverload
+    public init(minimumDistance: CGFloat = 10, coordinateSpace: CoordinateSpace = .local) {
+        self.minimumDistance = minimumDistance
+        self.coordinateSpace = coordinateSpace
+    }
+
+    /// Creates a dragging gesture with the minimum dragging distance before the gesture
+    /// succeeds and the coordinate space of the gesture's location.
+    @available(OpenSwiftUI_v5_0, *)
+    public init(minimumDistance: CGFloat = 10, coordinateSpace: some CoordinateSpaceProtocol = .local) {
+        self.minimumDistance = minimumDistance
+        self.coordinateSpace = coordinateSpace.coordinateSpace
+    }
+
+    /// A drag that starts only along `axes`, for scroll views.
+    package init(scrolling axes: Axis.Set) {
+        self.init(minimumDistance: 10, coordinateSpace: .global)
+        self.axes = axes
+    }
+
+    package var internalBody: some Gesture<Value> {
+        let minimumDistance = minimumDistance
+        let axes = axes
+        return DragState.gesture(
+            content: EventListener<SpatialEvent>().coordinateSpace(coordinateSpace)
+        ) { state, phase in
+            switch phase {
+            case .possible:
+                return .possible(nil)
+            case let .active(event):
+                state.track(event)
+                guard state.hasMoved(minimumDistance) else {
+                    return .possible(nil)
+                }
+                return state.isAlong(axes) ? .active(state.value) : .failed
+            case let .ended(event):
+                state.track(event)
+                guard state.hasMoved(minimumDistance), state.isAlong(axes) else {
+                    return .failed
+                }
+                return .ended(state.value)
+            case .failed:
+                return .failed
+            }
+        }
+    }
+
+    public typealias Body = Never
+}
+
+@available(*, unavailable)
+extension DragGesture: Sendable {}
+
+// MARK: - DragState
+
+/// The touch so far: where it began, how far it got, and its last moments for the velocity.
+private struct DragState: GestureStateProtocol {
+    private var start: CGPoint?
+    private var maxDistance: CGFloat = 0
+    /// The events of the last tenth of a second.
+    private var recent: [(time: Time, location: CGPoint)] = []
+
+    init() {}
+
+    mutating func track(_ event: SpatialEvent) {
+        let start = start ?? event.location
+        self.start = start
+        maxDistance = max(maxDistance, distance(start, event.location))
+        recent.append((event.timestamp, event.location))
+        recent.removeAll { event.timestamp.seconds - $0.time.seconds > 0.1 }
+    }
+
+    /// The axis of the first move past the minimum distance, which decides the drag.
+    private var axis: Axis?
+
+    func hasMoved(_ minimumDistance: CGFloat) -> Bool {
+        maxDistance >= minimumDistance
+    }
+
+    mutating func isAlong(_ axes: Axis.Set) -> Bool {
+        if axis == nil, let start, let location = recent.last?.location {
+            axis = abs(location.x - start.x) > abs(location.y - start.y) ? .horizontal : .vertical
+        }
+        return axes.contains(axis == .horizontal ? .horizontal : .vertical)
+    }
+
+    var value: DragGesture.Value {
+        let last = recent.last!
+        var velocity = CGSize.zero
+        if let first = recent.first, last.time.seconds > first.time.seconds {
+            let interval = last.time.seconds - first.time.seconds
+            velocity = CGSize(
+                width: (last.location.x - first.location.x) / interval,
+                height: (last.location.y - first.location.y) / interval
+            )
+        }
+        return DragGesture.Value(
+            time: Date(timeIntervalSinceNow: last.time.seconds - Time.systemUptime.seconds),
+            location: last.location,
+            startLocation: start!,
+            velocity: velocity
+        )
+    }
+}
