+/// A picker in a menu: the label, the selected option and a chevron; a tap opens a menu of
+/// the options, the selected one checked.
+private struct MenuPickerRow<Label, SelectionValue>: View where Label: View, SelectionValue: Hashable {
+    var label: Label
+    var options: [(child: _VariadicView.Children.Element, tag: SelectionValue)]
+    var selection: Binding<SelectionValue>
+    @State private var isPresented = false
+    @State private var anchor = IrisAnchorBox()
+
+    var body: some View {
+        let selected = options.firstIndex { $0.tag == selection.wrappedValue }
+        HStack {
+            label
+            Spacer(minLength: 8)
+            if let selected {
+                options[selected].child.foregroundStyle(systemBlue)
+            }
+            UpDownChevron()
+                .stroke(systemBlue, style: StrokeStyle(lineWidth: 1.5, lineCap: .round, lineJoin: .round))
+                .frame(width: 8, height: 13)
+        }
+        .contentShape(Rectangle())
+        .onTapGesture {
+            isPresented = true
+        }
+        .onGeometryChange(for: CGRect.self) { $0.frame(in: .global) } action: { [anchor] in
+            anchor.rect = $0
+        }
+        .modifier(PresentationModifier(kind: .menu, isPresented: $isPresented) { [anchor, options, selection] in
+            IrisMenuPanel(anchor: anchor.rect, dims: false) {
+                ForEach(Array(options.enumerated()), id: \.element.child.id) { _, option in
+                    Button {
+                        selection.wrappedValue = option.tag
+                    } label: {
+                        HStack(spacing: 8) {
+                            Checkmark()
+                                .stroke(Color.primary, style: StrokeStyle(lineWidth: 2, lineCap: .round, lineJoin: .round))
+                                .frame(width: 14, height: 12)
+                                .opacity(option.tag == selection.wrappedValue ? 1 : 0)
+                            option.child
+                        }
                     }
-                    UpDownChevron()
-                        .stroke(tint, style: StrokeStyle(lineWidth: 1.5, lineCap: .round, lineJoin: .round))
-                        .frame(width: 8, height: 13)
-                }
-                .contentShape(Rectangle())
-                .onTapGesture {
-                    // ponytail: the next option, until menus can be presented.
-                    guard !options.isEmpty else { return }
-                    let next = ((selected ?? -1) + 1) % options.count
-                    selection.wrappedValue = options[next].tag
                 }
             }
-        }
+        })
     }
 }
 
diff --git a/Sources/OpenSwiftUI/View/Presentation/IrisMenu.swift b/Sources/OpenSwiftUI/View/Presentation/IrisMenu.swift
new file mode 100644
index 0000000..ee0f80f
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Presentation/IrisMenu.swift
@@ -0,0 +1,257 @@
+//
+//  IrisMenu.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: menus and context menus, presented as iOS draws them: a 250-point panel next to what
+// opened it, below it when there is room, an item a row; a tap outside closes it. Submenus
+// open as another panel. Custom menu styles and context menu previews are not supported.
+
+/// systemRed.
+private let systemRed = Color(red: 1, green: 59 / 255, blue: 48 / 255)
+/// The background of menus: a light material, opaque here.
+private let materialBackground = Color(red: 242 / 255, green: 242 / 255, blue: 242 / 255)
+/// separator.
+private let separator = Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.29)
+
+/// Where a view is on the screen, for the panel it opens.
+final class IrisAnchorBox {
+    var rect = CGRect.zero
+}
+
+// MARK: - Menu
+
+/// A control for presenting a menu of actions.
+public struct Menu<Label, Content>: View where Label: View, Content: View {
+    var label: Label
+    var content: Content
+    var primaryAction: (() -> Void)?
+    @State private var isPresented = false
+    @State private var anchor = IrisAnchorBox()
+
+    /// Creates a menu with a custom label.
+    public init(@ViewBuilder content: () -> Content, @ViewBuilder label: () -> Label) {
+        self.content = content()
+        self.label = label()
+    }
+
+    /// Creates a menu with a custom primary action and custom label. Iris: a tap runs the
+    /// primary action; the menu cannot be opened yet.
+    public init(@ViewBuilder content: () -> Content, @ViewBuilder label: () -> Label, primaryAction: @escaping () -> Void) {
+        self.content = content()
+        self.label = label()
+        self.primaryAction = primaryAction
+    }
+
+    public var body: some View {
+        Button {
+            if let primaryAction {
+                primaryAction()
+            } else {
+                isPresented = true
+            }
+        } label: {
+            label
+        }
+        .onGeometryChange(for: CGRect.self) { $0.frame(in: .global) } action: { [anchor] in
+            anchor.rect = $0
+        }
+        .modifier(PresentationModifier(kind: .menu, isPresented: $isPresented) { [anchor, content] in
+            IrisMenuPanel(anchor: anchor.rect, dims: false) { content }
+        })
+    }
+}
+
+extension Menu where Label == Text {
+    /// Creates a menu that generates its label from a localized string key.
+    public init(_ titleKey: LocalizedStringKey, @ViewBuilder content: () -> Content) {
+        self.init(content: content) { Text(titleKey) }
+    }
+
+    /// Creates a menu that generates its label from a string.
+    @_disfavoredOverload
+    public init<S>(_ title: S, @ViewBuilder content: () -> Content) where S: StringProtocol {
+        self.init(content: content) { Text(title) }
+    }
+}
+
+extension Menu where Label == OpenSwiftUI.Label<Text, Image> {
+    /// Creates a menu that generates its label from a localized string key and system image.
+    public init(_ titleKey: LocalizedStringKey, systemImage: String, @ViewBuilder content: () -> Content) {
+        self.init(content: content) { OpenSwiftUI.Label(titleKey, systemImage: systemImage) }
+    }
+
+    /// Creates a menu that generates its label from a string and system image.
+    @_disfavoredOverload
+    public init<S>(_ title: S, systemImage: String, @ViewBuilder content: () -> Content) where S: StringProtocol {
+        self.init(content: content) { OpenSwiftUI.Label(title, systemImage: systemImage) }
+    }
+}
+
+/// A type that applies standard interaction behavior and a custom appearance to all menus
+/// within a view hierarchy. Iris: menus keep the system look.
+public protocol MenuStyle {}
+
+/// The default menu style.
+public struct DefaultMenuStyle: MenuStyle {
+    public init() {}
+}
+
+/// A menu style that doesn't show a border.
+public struct BorderlessButtonMenuStyle: MenuStyle {
+    public init() {}
+}
+
+/// A menu style that displays a button that toggles the display of the menu's contents.
+public struct ButtonMenuStyle: MenuStyle {
+    public init() {}
+}
+
+extension MenuStyle where Self == DefaultMenuStyle {
+    public static var automatic: DefaultMenuStyle { DefaultMenuStyle() }
+}
+
+extension MenuStyle where Self == ButtonMenuStyle {
+    public static var button: ButtonMenuStyle { ButtonMenuStyle() }
+}
+
+extension View {
+    /// Sets the style for menus within this view. Iris: menus keep the system look.
+    public func menuStyle<S>(_ style: S) -> some View where S: MenuStyle {
+        self
+    }
+
+    /// Adds a context menu to a view: a long press shows it.
+    public func contextMenu<MenuItems>(@ViewBuilder menuItems: () -> MenuItems) -> some View where MenuItems: View {
+        modifier(ContextMenuModifier(items: menuItems()))
+    }
+
+    /// Designates a context menu with a custom preview. Iris: without the preview.
+    public func contextMenu<M, P>(@ViewBuilder menuItems: () -> M, @ViewBuilder preview: () -> P) -> some View where M: View, P: View {
+        contextMenu(menuItems: menuItems)
+    }
+}
+
+private struct ContextMenuModifier<Items>: ViewModifier where Items: View {
+    var items: Items
+    @State private var isPresented = false
+    @State private var anchor = IrisAnchorBox()
+
+    func body(content: Content) -> some View {
+        content
+            .onGeometryChange(for: CGRect.self) { $0.frame(in: .global) } action: { [anchor] in
+                anchor.rect = $0
+            }
+            // Before the view's own gestures, so that a long press does not also tap it.
+            .highPriorityGesture(LongPressGesture().onEnded { _ in
+                isPresented = true
+            })
+            .modifier(PresentationModifier(kind: .menu, isPresented: $isPresented) { [anchor, items] in
+                IrisMenuPanel(anchor: anchor.rect, dims: true) { items }
+            })
+    }
+}
+
+// MARK: - Panel
+
+/// A menu panel next to `anchor`, in screen coordinates.
+struct IrisMenuPanel<Content>: View where Content: View {
+    var anchor: CGRect
+    var dims: Bool
+    var content: Content
+    @Environment(\.dismiss) private var dismiss
+
+    init(anchor: CGRect, dims: Bool, @ViewBuilder content: () -> Content) {
+        self.anchor = anchor
+        self.dims = dims
+        self.content = content()
+    }
+
+    var body: some View {
+        GeometryReader { proxy in
+            let below = anchor.midY < proxy.size.height / 2
+            let leading = anchor.midX < proxy.size.width / 2
+            ZStack(alignment: .topLeading) {
+                Color(red: 0, green: 0, blue: 0, opacity: dims ? 0.2 : 0)
+                    .contentShape(Rectangle())
+                    .onTapGesture {
+                        dismiss()
+                    }
+                VStack(spacing: 0) {
+                    if below {
+                        Spacer().frame(height: anchor.maxY + 8)
+                    } else {
+                        Spacer(minLength: 0)
+                    }
+                    HStack(spacing: 0) {
+                        if leading {
+                            Spacer().frame(width: max(anchor.minX, 8))
+                        } else {
+                            Spacer(minLength: 8)
+                        }
+                        panel
+                        if leading {
+                            Spacer(minLength: 8)
+                        } else {
+                            Spacer().frame(width: max(proxy.size.width - anchor.maxX, 8))
+                        }
+                    }
+                    if below {
+                        Spacer(minLength: 0)
+                    } else {
+                        Spacer().frame(height: max(proxy.size.height - anchor.minY + 8, 0))
+                    }
+                }
+            }
+        }
+    }
+
+    private var panel: some View {
+        _VariadicView.Tree(MenuRows()) {
+            content
+        }
+        .buttonStyle(MenuItemButtonStyle(dismiss: dismiss.callAsFunction))
+        .environment(\.irisLabelStyle, .menuItem)
+        .frame(width: 250)
+        .background(RoundedRectangle(cornerRadius: 13).fill(materialBackground))
+        .clipShape(RoundedRectangle(cornerRadius: 13))
+        .shadow(color: Color(red: 0, green: 0, blue: 0, opacity: 0.15), radius: 20, y: 6)
+    }
+}
+
+private struct MenuRows: _VariadicView_UnaryViewRoot {
+    func body(children: _VariadicView.Children) -> some View {
+        VStack(spacing: 0) {
+            ForEach(children) { child in
+                child
+                if child.id != children.last?.id {
+                    separator.frame(height: 0.33)
+                }
+            }
+        }
+    }
+}
+
+/// An item of a menu: its title on the leading edge and its icon on the trailing one; a
+/// tap closes the menu before running the action.
+private struct MenuItemButtonStyle: PrimitiveButtonStyle {
+    var dismiss: () -> Void
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .foregroundStyle(configuration.role == .destructive ? systemRed : Color.primary)
+            .lineLimit(1)
+            .frame(maxWidth: .infinity, minHeight: 44, alignment: .leading)
+            .padding(.horizontal, 16)
+            .contentShape(Rectangle())
+            .onTapGesture {
+                dismiss()
+                configuration.trigger()
+            }
+    }
+}
