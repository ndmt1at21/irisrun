@@ -0,0 +1,63 @@
+//
+//  LongPressGesture.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: long presses, made of the gesture parts TapGesture is made of, until upstream has them.
+
+/// A gesture that succeeds when the user performs a long press.
+public struct LongPressGesture: Gesture {
+    /// The minimum duration of the long press that must elapse before the gesture succeeds.
+    public var minimumDuration: Double
+
+    /// The maximum distance that the long press can move before the gesture fails.
+    public var maximumDistance: CGFloat
+
+    /// Creates a long-press gesture with a minimum duration and a maximum distance that the
+    /// interaction can move before the gesture fails.
+    public init(minimumDuration: Double = 0.5, maximumDistance: CGFloat = 10) {
+        self.minimumDuration = minimumDuration
+        self.maximumDistance = maximumDistance
+    }
+
+    /// The value is true while the finger is down, and when the press succeeds: it ends as
+    /// soon as it has lasted long enough, before the finger lifts.
+    public var body: some Gesture<Bool> {
+        EventListener<TappableEvent>()
+            .duration(minimum: minimumDuration)
+            .mapPhase { phase -> GesturePhase<Bool> in
+                switch phase {
+                case let .possible(elapsed): .possible(elapsed.map { _ in true })
+                case .active, .ended: .ended(true)
+                case .failed: .failed
+                }
+            }
+            .gated(by: DistanceGesture(maximumDistance: maximumDistance).coordinateSpace(.global))
+    }
+
+    public typealias Value = Bool
+}
+
+extension View {
+    /// Adds an action to perform when this view recognizes a long press gesture.
+    public func onLongPressGesture(
+        minimumDuration: Double = 0.5,
+        maximumDistance: CGFloat = 10,
+        perform action: @escaping () -> Void,
+        onPressingChanged: ((Bool) -> Void)? = nil
+    ) -> some View {
+        gesture(LongPressGesture(minimumDuration: minimumDuration, maximumDistance: maximumDistance).onEnded { _ in
+            action()
+        })
+        .simultaneousGesture(DragGesture(minimumDistance: 0).onChanged { _ in
+            onPressingChanged?(true)
+        }.onEnded { _ in
+            onPressingChanged?(false)
+        })
+    }
+}
