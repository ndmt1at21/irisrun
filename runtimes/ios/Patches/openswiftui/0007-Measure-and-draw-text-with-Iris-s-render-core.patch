+// MARK: - Frames
+
+#if !canImport(Darwin)
+/// Iris: prints the frame as the stdout renderer would, then draws and writes it as a PNG.
+/// IRISRUN_BENCH=<count> also times drawing it that many times into JPEG, as hosts send frames.
+private func writeFrame<Content>(
+    of host: StdoutRendererHost<Content>,
+    number: Int,
+    to directory: URL,
+    updatedIn update: Duration
+) {
+    let (list, version) = Update.ensure { host.viewGraph.displayList() }
+    print(list.stdoutDescription(surface: host.options.surface, version: version))
+    let clock = ContinuousClock()
+    var png: [UInt8]?
+    let encode = clock.measure { png = irisScene.encode(.png) }
+    let url = directory.appendingPathComponent(String(format: "frame-%03d.png", number))
+    guard let png, FileManager.default.createFile(atPath: url.path, contents: Data(png)) else {
+        fputs("cannot write \(url.path)\n", stderr)
+        exit(1)
+    }
+    print("frame: \(url.path) (update \(milliseconds(update)) ms, draw and PNG \(milliseconds(encode)) ms)")
+    guard let count = ProcessInfo.processInfo.environment["IRISRUN_BENCH"].flatMap({ Int($0) }), count > 0 else {
+        return
+    }
+    var layers = Duration.zero
+    var drawing = Duration.zero
+    var bytes = 0
+    for _ in 0 ..< count {
+        layers += clock.measure { irisScene.show(list) }
+        drawing += clock.measure { bytes += irisScene.encode(.jpeg)?.count ?? 0 }
+    }
+    let perFrame = (layers + drawing) / count
+    print("bench: \(count) frames, layers \(milliseconds(layers / count)) ms, drawing and JPEG \(milliseconds(drawing / count)) ms (\(Int(.seconds(1) / perFrame)) fps), \(bytes / count / 1024) KB")
+}
+
+private func milliseconds(_ duration: Duration) -> String {
+    String(format: "%.1f", duration / .milliseconds(1))
+}
+#endif
 #endif
diff --git a/Sources/OpenSwiftUICore/Render/DisplayList/DisplayListLayerRenderer.swift b/Sources/OpenSwiftUICore/Render/DisplayList/DisplayListLayerRenderer.swift
new file mode 100644
index 0000000..e7f762e
--- /dev/null
+++ b/Sources/OpenSwiftUICore/Render/DisplayList/DisplayListLayerRenderer.swift
@@ -0,0 +1,254 @@
+//
+//  DisplayListLayerRenderer.swift
+//  OpenSwiftUICore
+//
+//  Status: Iris
+
+#if !canImport(Darwin)
+package import Foundation
+package import IrisRender
+
+// MARK: - The window's scene
+
+/// Iris: the render core scene of the app's one window, made when the app starts, before
+/// anything is laid out. Text is measured with the scene's fonts, so layout agrees with what
+/// the layer renderer draws.
+package var irisScene: IrisRender.Scene!
+
+extension IrisRender.Scene {
+    /// A white window with the fonts in `${IRISRUN_HOME:-~/.irisrun}/fonts`, which Iris's
+    /// crates/render/fetch-fonts.sh downloads.
+    package static func window(size: CGSize, scale: Float) -> IrisRender.Scene {
+        let scene = IrisRender.Scene(width: Float(size.width), height: Float(size.height), scale: scale)
+        scene.root.backgroundColor = 0xFFFF_FFFF
+        let environment = ProcessInfo.processInfo.environment
+        let home = environment["IRISRUN_HOME"] ?? (environment["HOME"] ?? NSHomeDirectory()) + "/.irisrun"
+        for name in ["Inter.ttf", "NotoSansSC.ttf"] {
+            let path = home + "/fonts/" + name
+            guard let data = FileManager.default.contents(atPath: path), scene.addFont([UInt8](data)) else {
+                fatalError("cannot load \(path); run Iris's crates/render/fetch-fonts.sh")
+            }
+        }
+        return scene
+    }
+}
+
+// MARK: - LayerRenderer
+
+/// Iris: the platform renderer on Linux. It mirrors each new display list into the layers of
+/// `irisScene`, which the host encodes into frames.
+final class LayerRenderer: ViewRendererBase {
+    let platform: DisplayList.ViewUpdater.Platform
+    weak var host: (any ViewRendererHost)?
+    private var seed: DisplayList.Seed?
+
+    init(platform: DisplayList.ViewUpdater.Platform, host: (any ViewRendererHost)?) {
+        self.platform = platform
+        self.host = host
+    }
+
+    var exportedObject: AnyObject? {
+        nil
+    }
+
+    func render(
+        rootView: AnyObject,
+        from list: DisplayList,
+        time: Time,
+        version: DisplayList.Version,
+        maxVersion: DisplayList.Version,
+        environment: DisplayList.ViewRenderer.Environment
+    ) -> Time {
+        let nextSeed = DisplayList.Seed(version)
+        guard nextSeed != seed else {
+            return .infinity
+        }
+        seed = nextSeed
+        irisScene.show(list)
+        if let host, let observer = host.as(ViewGraphRenderObserver.self) {
+            observer.didRender()
+        }
+        return .infinity
+    }
+
+    func renderAsync(
+        to list: DisplayList,
+        time: Time,
+        targetTimestamp: Time?,
+        version: DisplayList.Version,
+        maxVersion: DisplayList.Version
+    ) -> Time? {
+        nil
+    }
+
+    func destroy(rootView: AnyObject) {}
+
+    var viewCacheIsEmpty: Bool {
+        true
+    }
+}
+
+// MARK: - Display list to layers
+
+extension IrisRender.Scene {
+    /// Replaces the window's layers with ones that draw `list`.
+    // ponytail: rebuilds every layer for each display list; keep layers by item identity once
+    // screens are big enough for this to show in frame times.
+    package func show(_ list: DisplayList) {
+        for layer in root.sublayers {
+            layer.removeFromSuperlayer()
+        }
+        add(list, to: root, at: .zero)
+    }
+
+    /// Items are placed from the origin of the item that holds their list.
+    private func add(_ list: DisplayList, to parent: Layer, at origin: CGPoint) {
+        for item in list.items {
+            let frame = item.frame.offsetBy(dx: origin.x, dy: origin.y)
+            switch item.value {
+            case let .content(content):
+                add(content, in: frame, to: parent)
+            case let .effect(effect, list):
+                add(list, with: effect, in: frame, to: parent)
+            case let .states(states):
+                for (_, list) in states {
+                    add(list, to: parent, at: frame.origin)
+                }
+            case .empty:
+                break
+            }
+        }
+    }
+
+    private func add(_ content: DisplayList.Content, in frame: CGRect, to parent: Layer) {
+        switch content.value {
+        case let .color(color):
+            parent.addSublayer(box(frame, color: color))
+        case let .shape(path, paint, _):
+            // ponytail: rectangles, rounded rectangles and circles in one color; other paths
+            // and paints need path drawing in the render core.
+            if let color = paint.stdoutResolvedColor, let shape = path.irisRoundedRect {
+                let radius = min(shape.cornerSize.width, shape.cornerSize.height)
+                parent.addSublayer(box(shape.rect.offsetBy(dx: frame.minX, dy: frame.minY), color: color, radius: radius))
+            }
+        case let .text(view, _):
+            guard let storage = view.text.storage, storage.length > 0 else {
+                return
+            }
+            let properties = view.text.layoutProperties
+            let layer = Layer(in: self)
+            layer.frame = Rect(frame)
+            layer.setText(storage.string, style: storage.irisTextStyle(
+                lineLimit: properties.lineLimit,
+                alignment: properties.multilineTextAlignment
+            ))
+            parent.addSublayer(layer)
+        case let .flattened(list, offset, _):
+            add(list, to: parent, at: CGPoint(x: frame.minX + offset.x, y: frame.minY + offset.y))
+        default:
+            // ponytail: images, shadows, backdrops and platform views come with the render core's
+            // next round (P1-14).
+            break
+        }
+    }
+
+    private func box(_ frame: CGRect, color: Color.Resolved, radius: CGFloat = 0) -> Layer {
+        let layer = Layer(in: self)
+        layer.frame = Rect(frame)
+        layer.backgroundColor = color.irisColor
+        layer.cornerRadius = Float(radius)
+        return layer
+    }
+
+    private func add(_ list: DisplayList, with effect: DisplayList.Effect, in frame: CGRect, to parent: Layer) {
+        let group: Layer
+        switch effect {
+        case let .opacity(opacity):
+            group = Layer(in: self)
+            group.opacity = opacity
+        case let .transform(.affine(transform)):
+            // Display lists transform about the item's origin, the render core about the
+            // layer's center.
+            group = Layer(in: self)
+            let center = CGPoint(x: frame.width / 2, y: frame.height / 2)
+            let translation = center.applying(transform)
+            group.transform = [
+                transform.a, transform.b, transform.c, transform.d,
+                translation.x - center.x, translation.y - center.y,
+            ].map { Float($0) }
+        default:
+            // ponytail: clips, masks, filters and other transforms draw their content as is.
+            add(list, to: parent, at: frame.origin)
+            return
+        }
+        group.frame = Rect(frame)
+        parent.addSublayer(group)
+        add(list, to: group, at: .zero)
+    }
+}
+
+extension Rect {
+    init(_ rect: CGRect) {
+        self.init(x: Float(rect.minX), y: Float(rect.minY), width: Float(rect.width), height: Float(rect.height))
+    }
+}
+
+extension Path {
+    /// The path as a rounded rectangle, if it is one.
+    fileprivate var irisRoundedRect: FixedRoundedRect? {
+        switch storage {
+        case let .rect(rect):
+            FixedRoundedRect(rect)
+        case let .roundedRect(rounded):
+            rounded
+        case let .ellipse(rect) where rect.width == rect.height:
+            FixedRoundedRect(rect, cornerRadius: rect.width / 2, style: .circular)
+        default:
+            nil
+        }
+    }
+}
+
+// MARK: - Text and color
+
+extension NSAttributedString {
+    /// How the render core draws this text. It takes one style per text, so the font and
+    /// color of the first run apply to all of it.
+    func irisTextStyle(lineLimit: Int?, alignment: TextAlignment = .leading) -> IrisRender.TextStyle {
+        let font = length > 0 ? attribute(.kitFont, at: 0, effectiveRange: nil) as? CTFont : nil
+        let color = length > 0 ? attribute(.kitForegroundColor, at: 0, effectiveRange: nil) as? NDColor : nil
+        let textAlignment: IrisRender.TextStyle.Alignment = switch alignment {
+        case .leading: .leading
+        case .center: .center
+        case .trailing: .trailing
+        }
+        return IrisRender.TextStyle(
+            size: Float(font?.pointSize ?? 17),
+            weight: font.map { irisWeight($0.weight) } ?? 400,
+            color: color.map {
+                Color.Resolved(red: Float($0.red), green: Float($0.green), blue: Float($0.blue), opacity: Float($0.alpha))
+            }?.irisColor ?? 0xFF00_0000,
+            alignment: textAlignment,
+            maxLines: UInt32(max(lineLimit ?? 0, 0))
+        )
+    }
+}
+
+/// The CSS weight (100 to 900) closest to a `Font.Weight` value, which is on CoreText's scale.
+private func irisWeight(_ value: CGFloat) -> UInt16 {
+    let weights: [(CGFloat, UInt16)] = [
+        (-0.8, 100), (-0.6, 200), (-0.4, 300), (0, 400), (0.23, 500), (0.3, 600), (0.4, 700), (0.56, 800), (0.62, 900),
+    ]
+    return weights.min { abs($0.0 - value) < abs($1.0 - value) }!.1
+}
+
+extension Color.Resolved {
+    /// 0xAARRGGBB in sRGB, as the render core takes colors.
+    fileprivate var irisColor: UInt32 {
+        func byte(_ value: Float) -> UInt32 {
+            UInt32((min(max(value, 0), 1) * 255).rounded())
+        }
+        return byte(opacity) << 24 | byte(red) << 16 | byte(green) << 8 | byte(blue)
+    }
+}
+#endif
