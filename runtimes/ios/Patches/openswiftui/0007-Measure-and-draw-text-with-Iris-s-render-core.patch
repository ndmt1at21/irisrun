diff --git a/Package.swift b/Package.swift
index 3f83fde..8b1546c 100644
--- a/Package.swift
+++ b/Package.swift
@@ -984,6 +984,18 @@ if swiftCryptoCondition {
     openSwiftUITarget.addSwiftCryptoSettings()
 }
 
+// Iris: on Linux, text is measured and drawn by Iris's render core, the Swift package in its
+// crates/render/swift. The Rust library behind it must be on the linker's search path.
+if !buildForDarwinPlatform {
+    guard let irisRenderPath = envStringValue("IRIS_RENDER_PATH") else {
+        fatalError("set OPENSWIFTUI_IRIS_RENDER_PATH to Iris's crates/render/swift")
+    }
+    package.dependencies.append(.package(path: irisRenderPath))
+    for target in [openSwiftUICoreTarget, openSwiftUITarget] {
+        target.dependencies.append(.product(name: "IrisRender", package: "swift"))
+    }
+}
