@@ -46,8 +46,10 @@ extension ViewAlias {
 
     nonisolated public static func _viewListCount(inputs: _ViewListCountInputs) -> Int? {
         var inputs = inputs
+        // Iris: count inputs never see a source, as a graph inputs modifier does not write to
+        // them; 0 made lists drop the alias' views. The count is unknown instead.
         guard let source = inputs.popLast(SourceInput<Self>.self) else {
-            return 0
+            return nil
         }
         return source.formula.viewListCount(source: source, inputs: inputs)
     }
