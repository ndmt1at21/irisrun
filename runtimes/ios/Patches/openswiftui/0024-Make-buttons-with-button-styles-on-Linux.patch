diff --git a/Sources/OpenSwiftUI/View/Control/Button/ButtonStyle/IrisButtonStyles.swift b/Sources/OpenSwiftUI/View/Control/Button/ButtonStyle/IrisButtonStyles.swift
new file mode 100644
index 0000000..119259e
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Control/Button/ButtonStyle/IrisButtonStyles.swift
@@ -0,0 +1,258 @@
+//
+//  IrisButtonStyles.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: button styles, until upstream has them: the style machinery of OpenSwiftUICore (a
+// styleable view finds the nearest style modifier) with iOS's system styles. A ButtonStyle
+// sees the button pressed while a finger is down on it.
+
+/// systemRed, a destructive button's color.
+private let systemRed = Color(red: 1, green: 59 / 255, blue: 48 / 255)
+/// tertiaryLabel, a disabled button's color.
+private let disabledLabel = Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.3)
+/// tertiarySystemFill, a disabled bordered button's background.
+private let disabledFill = Color(red: 118 / 255, green: 118 / 255, blue: 128 / 255, opacity: 0.12)
+
+// MARK: - Resolution
+
+/// A button as its style draws it.
+struct ResolvedButtonStyle: StyleableView {
+    var configuration: PrimitiveButtonStyleConfiguration
+
+    static var defaultStyleModifier: PrimitiveButtonStyleModifier<DefaultButtonStyle> {
+        PrimitiveButtonStyleModifier(style: DefaultButtonStyle())
+    }
+}
+
+struct PrimitiveButtonStyleModifier<Style>: StyleModifier where Style: PrimitiveButtonStyle {
+    var style: Style
+
+    init(style: Style) {
+        self.style = style
+    }
+
+    func styleBody(configuration: PrimitiveButtonStyleConfiguration) -> Style.Body {
+        style.makeBody(configuration: configuration)
+    }
+}
+
+extension View {
+    /// Sets the style for buttons within this view to a button style with a custom
+    /// appearance and custom interaction behavior.
+    public func buttonStyle<S>(_ style: S) -> some View where S: PrimitiveButtonStyle {
+        modifier(PrimitiveButtonStyleModifier(style: style))
+    }
+
+    /// Sets the style for buttons within this view to a button style with a custom
+    /// appearance and standard interaction behavior.
+    public func buttonStyle<S>(_ style: S) -> some View where S: ButtonStyle {
+        modifier(PrimitiveButtonStyleModifier(style: IrisButtonStyleBridge(style: style)))
+    }
+
+    /// Sets the border shape for buttons in this view.
+    public func buttonBorderShape(_ shape: ButtonBorderShape) -> some View {
+        environment(\.irisButtonBorderShape, shape)
+    }
+}
+
+/// A ButtonStyle used as a primitive one: the button triggers on a tap and is pressed
+/// while a finger is down.
+struct IrisButtonStyleBridge<Style>: PrimitiveButtonStyle where Style: ButtonStyle {
+    var style: Style
+
+    func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: style, configuration: configuration)
+    }
+}
+
+private struct PressableButton<Style>: View where Style: ButtonStyle {
+    var style: Style
+    var configuration: PrimitiveButtonStyleConfiguration
+    @GestureState private var isPressed = false
+
+    var body: some View {
+        style.makeBody(configuration: ButtonStyleConfiguration(isPressed: isPressed, role: configuration.role))
+            .viewAlias(ButtonStyleConfiguration.Label.self) {
+                configuration.label
+            }
+            .onTapGesture {
+                configuration.trigger()
+            }
+            .simultaneousGesture(
+                DragGesture(minimumDistance: 0)
+                    .updating($isPressed) { _, pressed, _ in
+                        pressed = true
+                    }
+            )
+    }
+}
+
+// MARK: - System styles
+
+/// The default button style, based on the button's context: on iOS, a borderless button.
+public struct DefaultButtonStyle: PrimitiveButtonStyle {
+    public init() {}
+
+    public func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: BorderlessBase(), configuration: configuration)
+    }
+}
+
+extension PrimitiveButtonStyle where Self == DefaultButtonStyle {
+    public static var automatic: DefaultButtonStyle { DefaultButtonStyle() }
+}
+
+/// A button style that doesn't style or decorate its content while idle, but may apply a
+/// visual effect to indicate the pressed, focused, or enabled state of the button.
+public struct PlainButtonStyle: PrimitiveButtonStyle {
+    public init() {}
+
+    public func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: PlainBase(), configuration: configuration)
+    }
+}
+
+extension PrimitiveButtonStyle where Self == PlainButtonStyle {
+    public static var plain: PlainButtonStyle { PlainButtonStyle() }
+}
+
+/// A button style that doesn't apply a border.
+public struct BorderlessButtonStyle: PrimitiveButtonStyle {
+    public init() {}
+
+    public func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: BorderlessBase(), configuration: configuration)
+    }
+}
+
+extension PrimitiveButtonStyle where Self == BorderlessButtonStyle {
+    public static var borderless: BorderlessButtonStyle { BorderlessButtonStyle() }
+}
+
+/// A button style that applies standard border artwork based on the button's context.
+public struct BorderedButtonStyle: PrimitiveButtonStyle {
+    public init() {}
+
+    public func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: BorderedBase(isProminent: false), configuration: configuration)
+    }
+}
+
+extension PrimitiveButtonStyle where Self == BorderedButtonStyle {
+    public static var bordered: BorderedButtonStyle { BorderedButtonStyle() }
+}
+
+/// A button style that applies standard border prominent artwork based on the button's
+/// context.
+public struct BorderedProminentButtonStyle: PrimitiveButtonStyle {
+    public init() {}
+
+    public func makeBody(configuration: Configuration) -> some View {
+        PressableButton(style: BorderedBase(isProminent: true), configuration: configuration)
+    }
+}
+
+extension PrimitiveButtonStyle where Self == BorderedProminentButtonStyle {
+    public static var borderedProminent: BorderedProminentButtonStyle { BorderedProminentButtonStyle() }
+}
+
+/// The label in the tint, fading while pressed.
+private struct BorderlessBase: ButtonStyle {
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.tintColor) private var tint
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .foregroundStyle(isEnabled ? (configuration.role == .destructive ? systemRed : tint ?? Color.accentColor) : disabledLabel)
+            .opacity(configuration.isPressed ? 0.2 : 1)
+    }
+}
+
+private struct PlainBase: ButtonStyle {
+    @Environment(\.isEnabled) private var isEnabled
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .opacity(isEnabled ? (configuration.isPressed ? 0.75 : 1) : 0.5)
+    }
+}
+
+/// The label on a tinted fill: a light one, or a solid one with a white label.
+private struct BorderedBase: ButtonStyle {
+    var isProminent: Bool
+    @Environment(\.isEnabled) private var isEnabled
+    @Environment(\.tintColor) private var tint
+    @Environment(\.controlSize) private var controlSize
+    @Environment(\.irisButtonBorderShape) private var borderShape
+
+    func makeBody(configuration: Configuration) -> some View {
+        let color = configuration.role == .destructive ? systemRed : tint ?? Color.accentColor
+        let (horizontal, vertical, radius): (CGFloat, CGFloat, CGFloat) = switch controlSize {
+        case .mini: (8, 3, 5)
+        case .small: (10, 4, 6)
+        case .regular: (12, 7, 7)
+        case .large, .extraLarge: (20, 14, 12)
+        }
+        configuration.label
+            .foregroundStyle(isEnabled ? (isProminent ? Color.white : color) : disabledLabel)
+            .padding(.horizontal, horizontal)
+            .padding(.vertical, vertical)
+            .background {
+                let fill = isEnabled ? (isProminent ? color : color.opacity(0.15)) : disabledFill
+                switch borderShape.kind {
+                case .capsule:
+                    Capsule().fill(fill)
+                case .circle:
+                    Circle().fill(fill)
+                case let .roundedRectangle(cornerRadius):
+                    RoundedRectangle(cornerRadius: cornerRadius ?? radius).fill(fill)
+                }
+            }
+            .opacity(configuration.isPressed ? 0.7 : 1)
+    }
+}
+
+// MARK: - Border shape
+
+/// A shape used to draw a button's border.
+public struct ButtonBorderShape: Equatable, Sendable {
+    enum Kind: Equatable, Sendable {
+        case capsule
+        case circle
+        case roundedRectangle(CGFloat?)
+    }
+
+    var kind: Kind
+
+    /// A shape that defers to the system to determine an appropriate shape for the given
+    /// context and platform.
+    public static var automatic: ButtonBorderShape { ButtonBorderShape(kind: .roundedRectangle(nil)) }
+    /// A capsule shape.
+    public static var capsule: ButtonBorderShape { ButtonBorderShape(kind: .capsule) }
+    /// A circle shape.
+    public static var circle: ButtonBorderShape { ButtonBorderShape(kind: .circle) }
+    /// A rounded rectangle shape.
+    public static var roundedRectangle: ButtonBorderShape { ButtonBorderShape(kind: .roundedRectangle(nil)) }
+
+    /// A rounded rectangle shape.
+    public static func roundedRectangle(radius: CGFloat) -> ButtonBorderShape {
+        ButtonBorderShape(kind: .roundedRectangle(radius))
+    }
+}
+
+private struct ButtonBorderShapeKey: EnvironmentKey {
+    static var defaultValue: ButtonBorderShape { .automatic }
+}
+
+extension EnvironmentValues {
+    var irisButtonBorderShape: ButtonBorderShape {
+        get { self[ButtonBorderShapeKey.self] }
+        set { self[ButtonBorderShapeKey.self] = newValue }
+    }
+}
