-    // The Device Protocol, which the stdout app speaks on stdio for irisrun: Iris's runtimes/ios.
+    // The host the stdout app shares with Iris's UIKit (Iris's runtimes/ios): the window's scene,
+    // the Device Protocol it speaks on stdio for irisrun, and the script commands.
     guard let irisRuntimePath = envStringValue("IRIS_RUNTIME_PATH") else {
         fatalError("set OPENSWIFTUI_IRIS_RUNTIME_PATH to Iris's runtimes/ios")
     }
