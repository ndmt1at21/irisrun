 .../App/App/Stdout/DeviceInput.swift          |  20 +-
 .../App/App/Stdout/IrisDevice.swift           | 238 ++----------------
 .../App/App/Stdout/StdoutApp.swift            | 128 ++--------
 .../View/TextField/TextField.swift            |   1 +
 .../DisplayListLayerRenderer.swift            |  31 +--
 .../Text/Text/Text+StringDrawingContext.swift |   3 +
 7 files changed, 53 insertions(+), 375 deletions(-)

