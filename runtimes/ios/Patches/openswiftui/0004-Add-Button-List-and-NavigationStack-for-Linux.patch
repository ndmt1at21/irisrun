 Sources/OpenSwiftUI/View/List/List.swift      | 36 ++++++++
 .../View/Navigation/NavigationStack.swift     | 91 +++++++++++++++++++
 3 files changed, 151 insertions(+), 4 deletions(-)
 create mode 100644 Sources/OpenSwiftUI/View/List/List.swift
