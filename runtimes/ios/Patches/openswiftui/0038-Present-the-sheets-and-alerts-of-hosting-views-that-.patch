+/// Iris: a presentation as it shows over the app.
+struct IrisPresentationView: View {
+    var presentation: IrisPresentation
+
+    var body: some View {
+        switch presentation.kind {
+        case .sheet:
+            SheetContainer(presentation: presentation)
+        case .fullScreenCover:
+            presentation.content.view
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                .background(Color.white)
+        case .alert, .dialog, .menu:
+            presentation.content.view
+        }
+    }
+}
