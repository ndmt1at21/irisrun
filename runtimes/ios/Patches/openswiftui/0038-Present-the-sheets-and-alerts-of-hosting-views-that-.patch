+// MARK: - Presentations
+
+/// Iris: a hosting view that is not its window's root, such as a child view controller's or a
+/// representable's, presents sheets, covers, alerts and dialogs through UIKit, as SwiftUI does on
+/// iOS: each in a hosting controller of its own over the whole window, presented by the one
+/// before. The root's show over its content, as before; menus too, as they place themselves in
+/// the content's coordinates.
+extension _UIHostingView: IrisPresentationPresenter {
+    func present(_ presentations: [IrisPresentation]) -> [IrisPresentation] {
+        guard let controller = hostingController, let window, window.rootViewController !== controller else {
+            return presentations
+        }
+        let modal = presentations.filter { $0.kind != .menu }
+        // Those that went, and the ones over them, go; those that stay show their new content;
+        // new ones come over the last.
+        let kept = zip(presented, modal).prefix { $0.id == $1.id }.count
+        if kept < presented.count {
+            (kept == 0 ? controller : presented[kept - 1].controller).dismiss(animated: false)
+            presented.removeSubrange(kept...)
+        }
+        for (index, presentation) in modal.enumerated() {
+            guard index >= presented.count else {
+                presented[index].controller.rootView = IrisPresentationView(presentation: presentation)
+                continue
+            }
+            let presentedController = UIHostingController(rootView: IrisPresentationView(presentation: presentation))
+            presentedController.modalPresentationStyle = .overFullScreen
+            presentedController.view.backgroundColor = .clear
+            (presented.last?.controller ?? controller).present(presentedController, animated: false)
+            presented.append((presentation.id, presentedController))
+        }
+        return presentations.filter { $0.kind == .menu }
+    }
+}
