index 0000000..1305850
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Scroll/ScrollViewReader.swift
@@ -0,0 +1,149 @@
+//
+//  ScrollViewReader.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: scrolling to a view by its identifier, until upstream has it. A scroll view keeps where
+// its targets are: the children of lazy stacks and the rows of lists, by the identifier of
+// their ForEach element or their `id(_:)`. ponytail: children of a plain VStack are not targets.
+
+/// A proxy value that supports programmatic scrolling of the scrollable views within a view
+/// hierarchy.
+public struct ScrollViewProxy {
+    var reader: IrisScrollReader
+
+    /// Scans all scroll views contained by the proxy for the first with a child view with
+    /// identifier `id`, and then scrolls to that view.
+    public func scrollTo<ID>(_ id: ID, anchor: UnitPoint? = nil) where ID: Hashable {
+        // An optional identifier stands for its value; nil scrolls nowhere.
+        var value: any Hashable = id
+        while let optional = value as? any IrisOptional {
+            guard let wrapped = optional.irisWrapped else { return }
+            value = wrapped
+        }
+        reader.scrollTo(AnyHashable(value), anchor: anchor)
+    }
+}
+
+private protocol IrisOptional {
+    var irisWrapped: (any Hashable)? { get }
+}
+
+extension Optional: IrisOptional where Wrapped: Hashable {
+    fileprivate var irisWrapped: (any Hashable)? {
+        self
+    }
+}
+
+/// A view that provides programmatic scrolling, by working with a proxy to scroll to known
+/// child views.
+public struct ScrollViewReader<Content>: View where Content: View {
+    public var content: (ScrollViewProxy) -> Content
+    @State private var reader = IrisScrollReader()
+
+    public init(@ViewBuilder content: @escaping (ScrollViewProxy) -> Content) {
+        self.content = content
+    }
+
+    public var body: some View {
+        content(ScrollViewProxy(reader: reader))
+            .environment(\.irisScrollReader, reader)
+    }
+}
+
+/// The scroll views in a ScrollViewReader.
+final class IrisScrollReader {
+    private struct Weak {
+        weak var targets: IrisScrollTargets?
+    }
+
+    private var scrollViews: [Weak] = []
+
+    func add(_ targets: IrisScrollTargets) {
+        scrollViews.removeAll { $0.targets == nil }
+        if !scrollViews.contains(where: { $0.targets === targets }) {
+            scrollViews.append(Weak(targets: targets))
+        }
+    }
+
+    func scrollTo(_ id: AnyHashable, anchor: UnitPoint?) {
+        let all = scrollViews.compactMap(\.targets)
+        if all.contains(where: { $0.scrollTo(id, anchor: anchor) }) {
+            return
+        }
+        // Not laid out yet, as in onAppear: the first scroll view to lay it out scrolls.
+        for targets in all {
+            targets.pending = (id, anchor)
+        }
+    }
+}
+
+/// Where a scroll view's targets are, in global coordinates, with its content's origin.
+final class IrisScrollTargets {
+    var frames: [AnyHashable: CGRect] = [:]
+    var contentOrigin = CGPoint.zero
+    var pending: (id: AnyHashable, anchor: UnitPoint?)?
+    /// Scrolls to show a rect of the content, in the content's coordinates.
+    var scroll: ((CGRect, UnitPoint?) -> Void)?
+
+    func register(_ id: AnyHashable, frame: CGRect) {
+        frames[id] = frame
+        if let pending, pending.id == id {
+            self.pending = nil
+            scroll?(frame.offsetBy(dx: -contentOrigin.x, dy: -contentOrigin.y), pending.anchor)
+        }
+    }
+
+    func scrollTo(_ id: AnyHashable, anchor: UnitPoint?) -> Bool {
+        guard let frame = frames[id] else { return false }
+        scroll?(frame.offsetBy(dx: -contentOrigin.x, dy: -contentOrigin.y), anchor)
+        return true
+    }
+}
+
+/// A child of a lazy stack or a list row, which a ScrollViewProxy can scroll to.
+struct IrisScrollTarget<Content>: View where Content: View {
+    var id: AnyHashable
+    var content: Content
+    @Environment(\.irisScrollTargets) private var targets
+
+    init(id: AnyHashable, content: Content) {
+        self.id = id
+        self.content = content
+    }
+
+    var body: some View {
+        if let targets {
+            content.onGeometryChange(for: CGRect.self, of: { $0.frame(in: .global) }) { [id] frame in
+                targets.register(id, frame: frame)
+            }
+        } else {
+            content
+        }
+    }
+}
+
+extension EnvironmentValues {
+    var irisScrollReader: IrisScrollReader? {
+        get { self[IrisScrollReaderKey.self] }
+        set { self[IrisScrollReaderKey.self] = newValue }
+    }
+
+    var irisScrollTargets: IrisScrollTargets? {
+        get { self[IrisScrollTargetsKey.self] }
+        set { self[IrisScrollTargetsKey.self] = newValue }
+    }
+}
+
+private struct IrisScrollReaderKey: EnvironmentKey {
+    static var defaultValue: IrisScrollReader? { nil }
+}
+
+private struct IrisScrollTargetsKey: EnvironmentKey {
+    static var defaultValue: IrisScrollTargets? { nil }
+}
