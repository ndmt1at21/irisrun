     /// Content shorter than the view sits at its top, narrower content in its middle, as in
     /// SwiftUI.
+    /// How a ScrollViewProxy scrolls this view: to show a rect of the content, its anchor at
+    /// the same point of the view, or just enough without one.
+    private func prepareTargets(viewport: CGSize) {
+        scroll.targets.scroll = { [scroll, axes] rect, anchor in
+            func position(_ minimum: CGFloat, _ length: CGFloat, _ current: CGFloat, _ visible: CGFloat, _ unit: CGFloat?) -> CGFloat {
+                if let unit {
+                    return minimum + length * unit - visible * unit
+                }
+                if minimum < current {
+                    return minimum
+                }
+                if minimum + length > current + visible {
+                    return minimum + length - visible
+                }
+                return current
+            }
+            let current = scroll.offset
+            let content = scroll.contentSize
+            var target = CGPoint(
+                x: axes.contains(.horizontal) ? position(rect.minX, rect.width, current.x, viewport.width, anchor?.x) : 0,
+                y: axes.contains(.vertical) ? position(rect.minY, rect.height, current.y, viewport.height, anchor?.y) : 0
+            )
+            target.x = min(max(target.x, 0), max(content.width - viewport.width, 0))
+            target.y = min(max(target.y, 0), max(content.height - viewport.height, 0))
+            scroll.offset = target
+        }
+    }
