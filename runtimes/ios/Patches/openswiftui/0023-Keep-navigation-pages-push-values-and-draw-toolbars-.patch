+        return content.preference(key: IrisNavigationDestinationsKey.self, value: [ObjectIdentifier(D.self)])
     }
 }
+
+/// Pushes `destination` while `isPresented` is true, and sets it false when popped.
+private struct PresentedDestinationModifier<V>: ViewModifier where V: View {
+    @Binding var isPresented: Bool
+    var destination: V?
+    @Environment(\.irisNavigator) private var navigator
+    @State private var pushed = PushedBox()
+
+    func body(content: Content) -> some View {
+        content
+            .onAppear { update(isPresented) }
+            .onChange(of: isPresented) { _, presented in update(presented) }
+    }
+
+    private func update(_ presented: Bool) {
+        guard let navigator else { return }
+        if presented, pushed.id == nil, let destination {
+            let binding = $isPresented
+            pushed.id = navigator.push(AnyView(destination)) { [pushed] in
+                pushed.id = nil
+                binding.wrappedValue = false
+            }
+        } else if !presented, let id = pushed.id {
+            pushed.id = nil
+            navigator.pop(view: id)
+        }
+    }
+}
+
+private final class PushedBox {
+    var id: Int?
+}
diff --git a/Sources/OpenSwiftUI/View/Presentation/DismissAction.swift b/Sources/OpenSwiftUI/View/Presentation/DismissAction.swift
