@@ -0,0 +1,83 @@
+//
+//  DismissAction.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import OpenSwiftUICore
+
+// Iris: dismissing what presents a view, until upstream has presentations. A navigation stack
+// sets the action for each page it pushed; sheets and covers set it for their content.
+
+/// An action that dismisses a presentation.
+public struct DismissAction {
+    var action: () -> Void
+
+    /// What the action dismisses. Actions for the same presentation compare equal, so that
+    /// remaking one does not update every view that reads it.
+    var id: AnyHashable?
+
+    init(id: AnyHashable?, action: @escaping () -> Void) {
+        self.id = id
+        self.action = action
+    }
+
+    /// Dismisses the current presentation.
+    public func callAsFunction() {
+        action()
+    }
+}
+
+extension DismissAction: Equatable {
+    public static func == (lhs: DismissAction, rhs: DismissAction) -> Bool {
+        lhs.id != nil && lhs.id == rhs.id
+    }
+}
+
+/// An indication whether a view is currently presented by another view.
+@available(*, deprecated, message: "Use EnvironmentValues.isPresented or EnvironmentValues.dismiss")
+public struct PresentationMode {
+    /// Indicates whether a view is currently presented.
+    public private(set) var isPresented: Bool
+
+    var dismissAction: DismissAction
+
+    /// Dismisses the view if it is currently presented.
+    public mutating func dismiss() {
+        guard isPresented else { return }
+        isPresented = false
+        dismissAction()
+    }
+}
+
+private struct DismissActionKey: EnvironmentKey {
+    static var defaultValue: DismissAction { DismissAction(id: nil) {} }
+}
+
+private struct IsPresentedKey: EnvironmentKey {
+    static var defaultValue: Bool { false }
+}
+
+extension EnvironmentValues {
+    /// An action that dismisses the current presentation: pops a pushed page, or dismisses a
+    /// sheet or a cover. It does nothing elsewhere.
+    public internal(set) var dismiss: DismissAction {
+        get { self[DismissActionKey.self] }
+        set { self[DismissActionKey.self] = newValue }
+    }
+
+    /// A Boolean value that indicates whether the view associated with this environment is
+    /// currently presented.
+    public internal(set) var isPresented: Bool {
+        get { self[IsPresentedKey.self] }
+        set { self[IsPresentedKey.self] = newValue }
+    }
+
+    /// A binding to the current presentation mode of the view associated with this
+    /// environment.
+    @available(*, deprecated, message: "Use isPresented or dismiss")
+    public var presentationMode: Binding<PresentationMode> {
+        let mode = PresentationMode(isPresented: isPresented, dismissAction: dismiss)
+        return Binding(get: { mode }, set: { _ in })
+    }
+}
diff --git a/Sources/OpenSwiftUI/View/Toolbar/IrisToolbar.swift b/Sources/OpenSwiftUI/View/Toolbar/IrisToolbar.swift
new file mode 100644
index 0000000..0836aa0
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Toolbar/IrisToolbar.swift
@@ -0,0 +1,418 @@
+//
+//  IrisToolbar.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: toolbars, until upstream has them. A view's toolbar items travel up as a preference to
+// the navigation page around it, which draws them in its bars. Customizable toolbars, menus of
+// secondary items and the keyboard bar are not supported.
+
+// MARK: - ToolbarContent
+
+/// Conforming types represent items that can be placed in various locations in a toolbar.
+@MainActor
+@preconcurrency
+public protocol ToolbarContent {
+    associatedtype Body: ToolbarContent
+
+    /// The composition of content that comprise the toolbar content.
+    @ToolbarContentBuilder
+    var body: Body { get }
+
+    /// Iris: the items of this content, in order.
+    func _irisItems(into items: inout [_IrisToolbarItem])
+}
+
+extension ToolbarContent {
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {
+        body._irisItems(into: &items)
+    }
+}
+
+/// Conforming types represent items that can be placed in various locations in a customizable
+/// toolbar. Iris: customization is not supported.
+public protocol CustomizableToolbarContent: ToolbarContent where Body: CustomizableToolbarContent {}
+
+extension Never: ToolbarContent, CustomizableToolbarContent {}
+
+/// Iris: an item of a toolbar, where it goes and what it shows.
+public struct _IrisToolbarItem {
+    var placement: ToolbarItemPlacement.Role
+    var view: IrisCarriedView
+}
+
+extension _IrisToolbarItem: Equatable {}
+
+/// A model that represents an item which can be placed in the toolbar or navigation bar.
+public struct ToolbarItem<ID, Content>: ToolbarContent where Content: View {
+    var placement: ToolbarItemPlacement
+    var content: Content
+
+    public var body: Never {
+        fatalError("ToolbarItem has no body")
+    }
+
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {
+        items.append(_IrisToolbarItem(placement: placement.role, view: IrisCarriedView(content)))
+    }
+}
+
+extension ToolbarItem where ID == () {
+    /// Creates a toolbar item with the specified placement and content.
+    public init(placement: ToolbarItemPlacement = .automatic, @ViewBuilder content: () -> Content) {
+        self.placement = placement
+        self.content = content()
+    }
+}
+
+extension ToolbarItem: CustomizableToolbarContent where ID == String {
+    /// Creates a toolbar item with the specified placement and content, which allows for user
+    /// customization.
+    public init(id: String, placement: ToolbarItemPlacement = .automatic, @ViewBuilder content: () -> Content) {
+        self.placement = placement
+        self.content = content()
+    }
+}
+
+/// A model that represents a group of `ToolbarItem`s which can be placed in the toolbar or
+/// navigation bar.
+public struct ToolbarItemGroup<Content>: ToolbarContent where Content: View {
+    var placement: ToolbarItemPlacement
+    var content: Content
+
+    /// Creates a toolbar item group with a specified placement and content.
+    public init(placement: ToolbarItemPlacement = .automatic, @ViewBuilder content: () -> Content) {
+        self.placement = placement
+        self.content = content()
+    }
+
+    public var body: Never {
+        fatalError("ToolbarItemGroup has no body")
+    }
+
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {
+        items.append(_IrisToolbarItem(
+            placement: placement.role,
+            view: IrisCarriedView(HStack(spacing: 16) { content })
+        ))
+    }
+}
+
+/// Toolbar content made of several pieces.
+public struct _IrisTupleToolbarContent<each Content: ToolbarContent>: ToolbarContent {
+    var content: (repeat each Content)
+
+    public var body: Never {
+        fatalError("_IrisTupleToolbarContent has no body")
+    }
+
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {
+        for piece in repeat each content {
+            piece._irisItems(into: &items)
+        }
+    }
+}
+
+/// Toolbar content chosen by a condition.
+public enum _IrisConditionalToolbarContent<TrueContent, FalseContent>: ToolbarContent
+    where TrueContent: ToolbarContent, FalseContent: ToolbarContent
+{
+    case first(TrueContent)
+    case second(FalseContent)
+
+    public var body: Never {
+        fatalError("_IrisConditionalToolbarContent has no body")
+    }
+
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {
+        switch self {
+        case let .first(content): content._irisItems(into: &items)
+        case let .second(content): content._irisItems(into: &items)
+        }
+    }
+}
+
+/// Toolbar content with no items.
+public struct _IrisEmptyToolbarContent: ToolbarContent {
+    public var body: Never {
+        fatalError("_IrisEmptyToolbarContent has no body")
+    }
+
+    public func _irisItems(into items: inout [_IrisToolbarItem]) {}
+}
+
+/// Constructs a toolbar item set from multi-expression closures.
+@resultBuilder
+public enum ToolbarContentBuilder {
+    public static func buildExpression<Content>(_ content: Content) -> Content where Content: ToolbarContent {
+        content
+    }
+
+    public static func buildBlock() -> _IrisEmptyToolbarContent {
+        _IrisEmptyToolbarContent()
+    }
+
+    public static func buildBlock<Content>(_ content: Content) -> Content where Content: ToolbarContent {
+        content
+    }
+
+    public static func buildBlock<each Content>(_ content: repeat each Content) -> _IrisTupleToolbarContent<repeat each Content> where repeat each Content: ToolbarContent {
+        _IrisTupleToolbarContent(content: (repeat each content))
+    }
+
+    public static func buildIf<Content>(_ content: Content?) -> _IrisConditionalToolbarContent<Content, _IrisEmptyToolbarContent> where Content: ToolbarContent {
+        content.map { .first($0) } ?? .second(_IrisEmptyToolbarContent())
+    }
+
+    public static func buildEither<TrueContent, FalseContent>(first: TrueContent) -> _IrisConditionalToolbarContent<TrueContent, FalseContent> {
+        .first(first)
+    }
+
+    public static func buildEither<TrueContent, FalseContent>(second: FalseContent) -> _IrisConditionalToolbarContent<TrueContent, FalseContent> {
+        .second(second)
+    }
+
+    public static func buildLimitedAvailability<Content>(_ content: Content) -> Content where Content: ToolbarContent {
+        content
+    }
+}
+
+// MARK: - Placement
+
+/// A structure that defines the placement of a toolbar item.
+public struct ToolbarItemPlacement {
+    enum Role: Equatable {
+        case leading, trailing, principal, bottom, status, keyboard
+    }
+
+    var role: Role
+
+    /// The system places the item automatically: in the trailing edge of the navigation bar
+    /// on iOS.
+    public static var automatic: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// The item represents a change in selection: leading in the navigation bar.
+    public static var navigation: ToolbarItemPlacement { ToolbarItemPlacement(role: .leading) }
+    /// The item represents a primary action.
+    public static var primaryAction: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// The item represents a secondary action. Iris: shown with the primary ones.
+    public static var secondaryAction: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// The item is placed in the principal item section: the center of the navigation bar.
+    public static var principal: ToolbarItemPlacement { ToolbarItemPlacement(role: .principal) }
+    /// The item represents a change in status for the current context.
+    public static var status: ToolbarItemPlacement { ToolbarItemPlacement(role: .status) }
+    /// The item represents a confirmation action for a modal interface.
+    public static var confirmationAction: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// The item represents a cancellation action for a modal interface.
+    public static var cancellationAction: ToolbarItemPlacement { ToolbarItemPlacement(role: .leading) }
+    /// The item represents a destructive action for a modal interface.
+    public static var destructiveAction: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// The item is placed in the keyboard section. Iris: not shown.
+    public static var keyboard: ToolbarItemPlacement { ToolbarItemPlacement(role: .keyboard) }
+    /// Places the item in the leading edge of the top bar.
+    public static var topBarLeading: ToolbarItemPlacement { ToolbarItemPlacement(role: .leading) }
+    /// Places the item in the trailing edge of the top bar.
+    public static var topBarTrailing: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// Places the item in the leading edge of the navigation bar.
+    public static var navigationBarLeading: ToolbarItemPlacement { ToolbarItemPlacement(role: .leading) }
+    /// Places the item in the trailing edge of the navigation bar.
+    public static var navigationBarTrailing: ToolbarItemPlacement { ToolbarItemPlacement(role: .trailing) }
+    /// Places the item in the bottom toolbar.
+    public static var bottomBar: ToolbarItemPlacement { ToolbarItemPlacement(role: .bottom) }
+}
+
+/// The placement of a toolbar.
+public struct ToolbarPlacement: Hashable {
+    enum Role: Hashable {
+        case automatic, navigationBar, bottomBar, tabBar
+    }
+
+    var role: Role
+
+    /// The primary toolbar.
+    public static var automatic: ToolbarPlacement { ToolbarPlacement(role: .automatic) }
+    /// The navigation bar.
+    public static var navigationBar: ToolbarPlacement { ToolbarPlacement(role: .navigationBar) }
+    /// The bottom toolbar.
+    public static var bottomBar: ToolbarPlacement { ToolbarPlacement(role: .bottomBar) }
+    /// The tab bar.
+    public static var tabBar: ToolbarPlacement { ToolbarPlacement(role: .tabBar) }
+}
+
+/// A configuration for a navigation bar that represents a view at the top of a navigation
+/// stack.
+public struct NavigationBarItem: Sendable {
+    /// A style for displaying the title of a navigation bar.
+    public enum TitleDisplayMode: Sendable {
+        case automatic
+        case inline
+        case large
+    }
+}
+
+// MARK: - Preferences
+
+/// Iris: a view a preference carries to the view that shows it, as SwiftUI carries toolbar
+/// items and presentations. Every value made counts as a change, so the view shown is the one
+/// made last.
+struct IrisCarriedView: Equatable {
+    var view: AnyView
+    private var seed: Int
+
+    init(_ view: some View) {
+        self.view = AnyView(view)
+        IrisCarriedView.lastSeed &+= 1
+        seed = IrisCarriedView.lastSeed
+    }
+
+    static func == (lhs: IrisCarriedView, rhs: IrisCarriedView) -> Bool {
+        lhs.seed == rhs.seed
+    }
+
+    nonisolated(unsafe) private static var lastSeed = 0
+}
+
+struct IrisToolbarKey: PreferenceKey {
+    static var defaultValue: [_IrisToolbarItem] { [] }
+
+    static func reduce(value: inout [_IrisToolbarItem], nextValue: () -> [_IrisToolbarItem]) {
+        value += nextValue()
+    }
+}
+
+/// Iris: what a page asks of its bars.
+struct IrisNavigationBarStorage: Equatable {
+    var isHidden: Bool?
+    var isBackButtonHidden: Bool?
+    var isBottomBarHidden: Bool?
+    var isTabBarHidden: Bool?
+
+    mutating func merge(_ other: IrisNavigationBarStorage) {
+        isHidden = isHidden ?? other.isHidden
+        isBackButtonHidden = isBackButtonHidden ?? other.isBackButtonHidden
+        isBottomBarHidden = isBottomBarHidden ?? other.isBottomBarHidden
+        isTabBarHidden = isTabBarHidden ?? other.isTabBarHidden
+    }
+}
+
+struct IrisNavigationBarKey: PreferenceKey {
+    static var defaultValue: IrisNavigationBarStorage { IrisNavigationBarStorage() }
+
+    static func reduce(value: inout IrisNavigationBarStorage, nextValue: () -> IrisNavigationBarStorage) {
+        value.merge(nextValue())
+    }
+}
+
+// MARK: - Modifiers
+
+extension View {
+    /// Populates the toolbar or navigation bar with the specified items.
+    public func toolbar<Content>(@ViewBuilder content: () -> Content) -> some View where Content: View {
+        toolbar {
+            ToolbarItemGroup(placement: .automatic, content: content)
+        }
+    }
+
+    /// Populates the toolbar or navigation bar with the specified items.
+    public func toolbar<Content>(@ToolbarContentBuilder content: () -> Content) -> some View where Content: ToolbarContent {
+        var items: [_IrisToolbarItem] = []
+        content()._irisItems(into: &items)
+        return transformPreference(IrisToolbarKey.self) { value in
+            value = items + value
+        }
+    }
+
+    /// Populates the toolbar or navigation bar with the specified items, allowing for user
+    /// customization. Iris: not customizable.
+    public func toolbar<Content>(id: String, @ToolbarContentBuilder content: () -> Content) -> some View where Content: CustomizableToolbarContent {
+        toolbar(content: content)
+    }
+
+    /// Specifies the visibility of a bar managed by OpenSwiftUI.
+    public func toolbar(_ visibility: Visibility, for bars: ToolbarPlacement...) -> some View {
+        let hidden: Bool? = switch visibility {
+        case .hidden: true
+        case .visible: false
+        default: nil
+        }
+        var storage = IrisNavigationBarStorage()
+        for bar in bars {
+            switch bar.role {
+            case .automatic, .navigationBar: storage.isHidden = hidden
+            case .bottomBar: storage.isBottomBarHidden = hidden
+            case .tabBar: storage.isTabBarHidden = hidden
+            }
+        }
+        return navigationBarStorage(storage)
+    }
+
+    /// Specifies the preferred visibility of backgrounds on a bar. Iris: bars keep their look.
+    public func toolbarBackground(_ visibility: Visibility, for bars: ToolbarPlacement...) -> some View {
+        self
+    }
+
+    /// Specifies the preferred shape style of the background of a bar. Iris: bars keep their
+    /// look.
+    public func toolbarBackground<S>(_ style: S, for bars: ToolbarPlacement...) -> some View where S: ShapeStyle {
+        self
+    }
+
+    /// Specifies the preferred color scheme of a bar. Iris: bars keep their look.
+    public func toolbarColorScheme(_ colorScheme: ColorScheme?, for bars: ToolbarPlacement...) -> some View {
+        self
+    }
+
+    /// Hides the navigation bar back button for the view.
+    public func navigationBarBackButtonHidden(_ hidesBackButton: Bool = true) -> some View {
+        navigationBarStorage(IrisNavigationBarStorage(isBackButtonHidden: hidesBackButton))
+    }
+
+    /// Hides the navigation bar for this view.
+    public func navigationBarHidden(_ hidden: Bool) -> some View {
+        navigationBarStorage(IrisNavigationBarStorage(isHidden: hidden))
+    }
+
+    /// Configures the title display mode for this view.
+    public func navigationBarTitleDisplayMode(_ displayMode: NavigationBarItem.TitleDisplayMode) -> some View {
+        let mode: ToolbarTitleDisplayMode = switch displayMode {
+        case .automatic: .automatic
+        case .inline: .inline
+        case .large: .large
+        }
+        return toolbarTitleDisplayMode(mode)
+    }
+
+    /// Sets the navigation bar items for this view.
+    public func navigationBarItems<L, T>(leading: L, trailing: T) -> some View where L: View, T: View {
+        toolbar {
+            ToolbarItem(placement: .navigationBarLeading) { leading }
+            ToolbarItem(placement: .navigationBarTrailing) { trailing }
+        }
+    }
+
+    /// Sets the navigation bar items for this view.
+    public func navigationBarItems<L>(leading: L) -> some View where L: View {
+        toolbar {
+            ToolbarItem(placement: .navigationBarLeading) { leading }
+        }
+    }
+
+    /// Sets the navigation bar items for this view.
+    public func navigationBarItems<T>(trailing: T) -> some View where T: View {
+        toolbar {
+            ToolbarItem(placement: .navigationBarTrailing) { trailing }
+        }
+    }
+
+    func navigationBarStorage(_ storage: IrisNavigationBarStorage) -> some View {
+        transformPreference(IrisNavigationBarKey.self) { value in
+            var outer = storage
+            outer.merge(value)
+            value = outer
+        }
+    }
+}
