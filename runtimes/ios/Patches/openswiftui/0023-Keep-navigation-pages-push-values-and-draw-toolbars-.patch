+/// A page of a navigation stack with its bars.
+private struct NavigationPage<Content>: View where Content: View {
+    var index: Int
+    var isTop: Bool
+    var model: IrisNavigationModel
+    var content: Content
+
+    @State private var title: NavigationTitleStorage?
+    @State private var items: [_IrisToolbarItem] = []
+    @State private var bars = IrisNavigationBarStorage()
+    @State private var background: Color?
+
+    init(index: Int, isTop: Bool, model: IrisNavigationModel, @ViewBuilder content: () -> Content) {
+        self.index = index
+        self.isTop = isTop
+        self.model = model
+        self.content = content()
+    }
+
+    var body: some View {
+        VStack(spacing: 0) {
+            if bars.isHidden != true {
+                NavigationBar(
+                    title: title?.title,
+                    isLarge: title?.titleMode.map { $0.role != .inline } ?? true,
+                    backTitle: index > 0 && bars.isBackButtonHidden != true ? (model.titles[index - 1] ?? Text(verbatim: "Back")) : nil,
+                    items: items,
+                    pop: { model.pop(to: index - 1) }
+                )
+            }
+            content
+                .frame(maxWidth: .infinity, maxHeight: .infinity)
+                .onPreferenceChange(NavigationTitleKey.self) { storage in
+                    title = storage
+                    if model.titles[index] != storage?.title {
+                        model.titles[index] = storage?.title
+                    }
+                }
+                .onPreferenceChange(IrisToolbarKey.self) { items = $0 }
+                .onPreferenceChange(IrisNavigationBarKey.self) { bars = $0 }
+                .onPreferenceChange(IrisPageBackgroundKey.self) { background = $0 }
+            let bottom = items.filter { $0.placement == .bottom || $0.placement == .status }
+            if !bottom.isEmpty, bars.isBottomBarHidden != true {
+                BottomBar(items: bottom)
+            }
+        }
+        .background(background ?? Color.white)
+        // A page's bars are its own.
+        .transformPreference(NavigationTitleKey.self) { $0 = nil }
+        .transformPreference(IrisToolbarKey.self) { $0 = [] }
+        .transformPreference(IrisNavigationBarKey.self) { $0 = IrisNavigationBarStorage() }
+        .transformPreference(IrisPageBackgroundKey.self) { $0 = nil }
+        .modifier(PageEnvironment(index: index, model: model))
+        // Hit-testing skips a transparent view.
+        .opacity(isTop ? 1 : 0)
+    }
