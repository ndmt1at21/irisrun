+private struct NavigationDestinationModifier<D, C>: ViewModifier where D: Hashable, C: View {
+    var destination: (D) -> C
+    @Environment(\.irisNavigator) private var navigator
+
+    func body(content: Content) -> some View {
+        // The latest destination; the preference tells the stack when the types change.
+        navigator?.destinations[ObjectIdentifier(D.self)] = { [destination] value in
+            AnyView(destination(value.base as! D))
