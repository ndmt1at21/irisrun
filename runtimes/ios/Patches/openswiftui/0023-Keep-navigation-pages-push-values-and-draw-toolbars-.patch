+// MARK: - Model
+
+/// Iris: the pages of a navigation stack beyond its root. Pages pushed by value come first,
+/// then pages pushed as views.
+final class IrisNavigationModel: Observable {
+    struct Page {
+        var id: AnyHashable
+        var view: AnyView
+    }
+
+    private struct PushedView {
+        var id: Int
+        var view: AnyView
+        var onPop: (() -> Void)?
+    }
+
+    private let registrar = ObservationRegistrar()
+
+    private var _path: [AnyHashable] = []
+    private var _views: [PushedView] = []
+    private var _destinationTypes: Set<ObjectIdentifier> = []
+    private var _titles: [Int: Text] = [:]
+
+    /// The values pushed when the stack has no path binding.
+    var path: [AnyHashable] {
+        get {
+            registrar.access(self, keyPath: \.path)
+            return _path
+        }
+        set {
+            registrar.withMutation(of: self, keyPath: \.path) { _path = newValue }
+        }
+    }
+
+    private var views: [PushedView] {
+        get {
+            registrar.access(self, keyPath: \.views)
+            return _views
+        }
+        set {
+            registrar.withMutation(of: self, keyPath: \.views) { _views = newValue }
+        }
+    }
+
+    /// The types `navigationDestination(for:)` declared a destination for.
+    var destinationTypes: Set<ObjectIdentifier> {
+        get {
+            registrar.access(self, keyPath: \.destinationTypes)
+            return _destinationTypes
+        }
+        set {
+            registrar.withMutation(of: self, keyPath: \.destinationTypes) { _destinationTypes = newValue }
+        }
+    }
+
+    /// The title of each page, for the back button of the page above it.
+    var titles: [Int: Text] {
+        get {
+            registrar.access(self, keyPath: \.titles)
+            return _titles
+        }
+        set {
+            registrar.withMutation(of: self, keyPath: \.titles) { _titles = newValue }
+        }
+    }
+
+    /// The stack's path binding, as of its last update.
+    var binding: Binding<[AnyHashable]?>?
+
+    /// The destinations declared for each type, as of their last update.
+    var destinations: [ObjectIdentifier: (AnyHashable) -> AnyView] = [:]
+
+    private var lastViewID = 0
+
+    private var values: [AnyHashable] {
+        get { binding?.wrappedValue ?? path }
+        set {
+            if let binding {
+                binding.wrappedValue = newValue
+            } else {
+                path = newValue
+            }
+        }
+    }
+
+    func pages(values: [AnyHashable]) -> [Page] {
+        _ = destinationTypes
+        var pages = values.enumerated().map { index, value in
+            // Empty until the destination's declaration has been seen.
+            let destination = destinations[ObjectIdentifier(type(of: value.base))]
+            return Page(id: AnyHashable([AnyHashable(index), value]), view: destination?(value) ?? AnyView(EmptyView()))
+        }
+        pages += views.map { Page(id: AnyHashable($0.id), view: $0.view) }
+        return pages
+    }
+
+    func push(_ value: AnyHashable) {
+        if _views.isEmpty {
+            values.append(value)
+        } else if let destination = destinations[ObjectIdentifier(type(of: value.base))] {
+            push(destination(value))
+        }
+    }
+
+    /// Pushes a view; `onPop` runs when it is popped.
+    @discardableResult
+    func push(_ view: AnyView, onPop: (() -> Void)? = nil) -> Int {
+        lastViewID += 1
+        views.append(PushedView(id: lastViewID, view: view, onPop: onPop))
+        return lastViewID
+    }
+
+    /// Pops the pages above the one at `index`, the root being 0.
+    func pop(to index: Int) {
+        let values = values
+        let keptViews = max(index - values.count, 0)
+        if _views.count > keptViews {
+            let popped = _views[keptViews...]
+            views.removeLast(_views.count - keptViews)
+            for view in popped.reversed() {
+                view.onPop?()
+            }
+        }
+        if values.count > index {
+            self.values = Array(values.prefix(max(index, 0)))
+        }
+    }
+
+    /// Pops the view pushed as `id`, and the pages above it.
+    func pop(view id: Int) {
+        guard let position = _views.firstIndex(where: { $0.id == id }) else { return }
+        pop(to: values.count + position)
+    }
+}
