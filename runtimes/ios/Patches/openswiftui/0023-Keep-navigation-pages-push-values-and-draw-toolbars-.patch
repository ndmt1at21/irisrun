+/// SF Symbols' chevron.backward.
+private struct BackChevron: Shape {
+    func path(in rect: CGRect) -> Path {
+        var path = Path()
+        path.addLines([
+            CGPoint(x: rect.maxX, y: rect.minY),
+            CGPoint(x: rect.minX, y: rect.midY),
+            CGPoint(x: rect.maxX, y: rect.maxY),
+        ])
+        return path
+    }
