 extension NSAttributedString {
-    /// How the render core draws this text. It takes one style per text, so the font and
-    /// color of the first run apply to all of it.
+    /// The text's runs of style for the render core, over UTF-8 bytes: font, color, slant,
+    /// underline, strikethrough, kerning and baseline offset. Underlines take the run's color.
+    package var irisTextRuns: [IrisRender.TextRun] {
+        var runs: [IrisRender.TextRun] = []
+        let string = string
+        let utf16 = string.utf16
+        enumerateAttributes(in: NSRange(location: 0, length: length)) { attributes, range, _ in
+            guard let lower = utf16.index(utf16.startIndex, offsetBy: range.location, limitedBy: utf16.endIndex),
+                  let upper = utf16.index(lower, offsetBy: range.length, limitedBy: utf16.endIndex)
+            else { return }
+            let font = attributes[.kitFont] as? CTFont
+            let color = (attributes[.kitForegroundColor] as? NDColor).map {
+                Color.Resolved(red: Float($0.red), green: Float($0.green), blue: Float($0.blue), opacity: Float($0.alpha))
+            }
+            func number(_ key: NSAttributedString.Key) -> CGFloat {
+                (attributes[key] as? CGFloat) ?? (attributes[key] as? NSNumber).map { CGFloat($0.doubleValue) } ?? 0
+            }
+            runs.append(IrisRender.TextRun(
+                string.utf8.distance(from: string.startIndex, to: lower) ..< string.utf8.distance(from: string.startIndex, to: upper),
+                size: Float(font?.pointSize ?? 17),
+                weight: font.map { irisWeight($0.weight) } ?? 400,
+                color: color?.irisColor ?? 0xFF00_0000,
+                isItalic: font?.isItalic ?? false,
+                isUnderlined: number(.kitUnderlineStyle) != 0,
+                isStruckThrough: number(.kitStrikethroughStyle) != 0,
+                letterSpacing: Float(number(.kitKern) + number(.kitTracking)),
+                baselineOffset: Float(number(.kitBaselineOffset))
+            ))
+        }
+        return runs
+    }
+
+    /// How the render core breaks the text into lines.
+    package func irisParagraphStyle(lineLimit: Int?, alignment: TextAlignment = .leading) -> IrisRender.ParagraphStyle {
+        let lineSpacing = length > 0 ? (attribute(.kitParagraphStyle, at: 0, effectiveRange: nil) as? NSParagraphStyle)?.lineSpacing : nil
+        let textAlignment: IrisRender.TextAlignment = switch alignment {
+        case .leading: .leading
+        case .center: .center
+        case .trailing: .trailing
+        }
+        return IrisRender.ParagraphStyle(
+            alignment: textAlignment,
+            maxLines: UInt32(max(lineLimit ?? 0, 0)),
+            lineSpacing: Float(lineSpacing ?? 0)
+        )
+    }
+
