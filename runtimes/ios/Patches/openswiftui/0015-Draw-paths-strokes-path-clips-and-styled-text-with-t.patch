 extension Path {
+    /// The line or area the render core draws for the path: for a stroked path, its line.
+    fileprivate var irisPath: IrisRender.Path {
+        var path = IrisRender.Path()
+        func point(_ p: CGPoint) -> IrisRender.Point {
+            IrisRender.Point(x: Float(p.x), y: Float(p.y))
+        }
+        for element in elements {
+            switch element {
+            case let .move(p): path.move(to: point(p))
+            case let .line(p): path.addLine(to: point(p))
+            case let .quadCurve(p, control): path.addQuadCurve(to: point(p), control: point(control))
+            case let .curve(p, control1, control2):
+                path.addCurve(to: point(p), control1: point(control1), control2: point(control2))
+            case .closeSubpath: path.closeSubpath()
+            }
+        }
+        return path
+    }
+
+    /// Fills the path in `color`, or for a stroked path, strokes its line.
+    fileprivate func irisShapeStyle(color: UInt32, eoFill: Bool) -> IrisRender.ShapeStyle {
+        guard case let .stroked(stroked) = storage else {
+            return IrisRender.ShapeStyle(fill: color, isEvenOdd: eoFill)
+        }
+        let style = stroked.style
+        let cap: IrisRender.ShapeStyle.LineCap = switch style.lineCap {
+        case .round: .round
+        case .square: .square
+        default: .butt
+        }
+        let join: IrisRender.ShapeStyle.LineJoin = switch style.lineJoin {
+        case .round: .round
+        case .bevel: .bevel
+        default: .miter
+        }
+        return IrisRender.ShapeStyle(
+            fill: 0,
+            stroke: color,
+            lineWidth: Float(style.lineWidth),
+            lineCap: cap,
+            lineJoin: join,
+            miterLimit: Float(style.miterLimit),
+            dashes: style.dash.map { Float($0) },
+            dashPhase: Float(style.dashPhase)
+        )
+    }
