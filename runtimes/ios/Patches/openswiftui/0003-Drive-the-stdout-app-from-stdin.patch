@@ -82,6 +84,8 @@ final package class StdoutRendererHost<Content>: ViewRendererHost, ViewGraphRend
             return unsafeBitCast(self as any ViewGraphRenderDelegate, to: T.self)
         } else if DisplayList.ViewRenderer.self == T.self {
