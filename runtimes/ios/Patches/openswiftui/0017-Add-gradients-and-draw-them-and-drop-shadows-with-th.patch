+extension AnyResolvedPaint {
+    fileprivate var irisGradient: IrisGradientPaint? {
+        var visitor = GradientVisitor()
+        visit(&visitor)
+        return visitor.paint
+    }
+}
+
+private struct GradientVisitor: ResolvedPaintVisitor {
+    var paint: IrisGradientPaint?
+
+    mutating func visitPaint<P>(_ paint: P) where P: ResolvedPaint {
+        self.paint = paint as? IrisGradientPaint
+    }
+}
+
+extension IrisGradientPaint {
+    /// The gradient over a shape of `size` points.
+    fileprivate func irisGradient(size: CGSize) -> IrisRender.Gradient {
+        func point(_ unit: UnitPoint) -> IrisRender.Point {
+            IrisRender.Point(x: Float(unit.x * size.width), y: Float(unit.y * size.height))
+        }
+        let irisKind: IrisRender.Gradient.Kind = switch kind {
+        case let .linear(start, end):
+            .linear(start: point(start), end: point(end))
+        case let .radial(center, startRadius, endRadius):
+            .radial(center: point(center), startRadius: Float(startRadius), endRadius: Float(endRadius))
+        case let .angular(center, start, end):
+            .conic(center: point(center), startAngle: Float(start.radians), endAngle: Float(end.radians))
+        }
+        return IrisRender.Gradient(irisKind, colors: colors.map(\.irisColor), locations: locations)
+    }
+}
