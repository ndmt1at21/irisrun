@@ -0,0 +1,65 @@
+//
+//  IrisAllowsHitTesting.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+import OpenAttributeGraphShims
+
+// Iris: allowsHitTesting, until upstream has it: a responder around the view's responders that
+// hit-testing skips, with everything in it, when the view does not allow it.
+
+extension View {
+    /// Configures whether this view participates in hit test operations.
+    public func allowsHitTesting(_ enabled: Bool) -> some View {
+        modifier(AllowsHitTestingModifier(enabled: enabled))
+    }
+}
+
+private struct AllowsHitTestingModifier: ViewModifier, MultiViewModifier, PrimitiveViewModifier {
+    var enabled: Bool
+
+    nonisolated static func _makeView(
+        modifier: _GraphValue<Self>,
+        inputs: _ViewInputs,
+        body: @escaping (_Graph, _ViewInputs) -> _ViewOutputs
+    ) -> _ViewOutputs {
+        var outputs = body(_Graph(), inputs)
+        if inputs.preferences.requiresViewResponders {
+            let responder = HitTestingResponder(inputs: inputs)
+            outputs.preferences.viewResponders = Attribute(HitTestingFilter(
+                modifier: modifier.value,
+                children: .init(outputs.preferences.viewResponders),
+                responder: responder
+            ))
+        }
+        return outputs
+    }
+}
+
+private final class HitTestingResponder: DefaultLayoutViewResponder {
+    var enabled = true
+
+    override var allowsHitTesting: Bool { enabled }
+}
+
+private struct HitTestingFilter: StatefulRule {
+    @Attribute var modifier: AllowsHitTestingModifier
+    @OptionalAttribute var children: [ViewResponder]?
+    let responder: HitTestingResponder
+
+    typealias Value = [ViewResponder]
+
+    func updateValue() {
+        responder.enabled = modifier.enabled
+        if let (children, changed) = $children?.changedValue(), changed {
+            responder.children = children
+        }
+        if !hasValue {
+            value = [responder]
+        }
+    }
+}
