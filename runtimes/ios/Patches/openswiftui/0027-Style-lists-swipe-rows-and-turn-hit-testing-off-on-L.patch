+/// Active while a finger is down without moving away, failing once it moves 10 points, so
+/// that the views around the button can take the drag.
+private struct PressGesture: Gesture {
+    var body: some Gesture<Bool> {
+        EventListener<TappableEvent>()
+            .mapPhase { phase -> GesturePhase<Bool> in
+                switch phase {
+                case .possible: .possible(nil)
+                case .active: .active(true)
+                case .ended: .ended(false)
+                case .failed: .failed
+                }
+            }
+            .gated(by: DistanceGesture(maximumDistance: 10).coordinateSpace(.global))
+    }
+}
