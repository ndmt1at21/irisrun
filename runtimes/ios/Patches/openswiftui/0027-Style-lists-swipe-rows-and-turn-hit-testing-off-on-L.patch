new file mode 100644
index 0000000..0faa0d9
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/List/IrisListStyles.swift
@@ -0,0 +1,315 @@
+//
+//  IrisListStyles.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// Iris: list styles, row modifiers and swipe actions, until upstream has List. A list is
+// inset grouped by default, as on iOS. Custom list styles are not supported.
+
+/// systemRed.
+private let systemRed = Color(red: 1, green: 59 / 255, blue: 48 / 255)
+/// systemGray, a swipe action's default color.
+private let systemGray = Color(red: 142 / 255, green: 142 / 255, blue: 147 / 255)
+
+// MARK: - List styles
+
+/// A protocol that describes the behavior and appearance of a list.
+public protocol ListStyle {}
+
+/// The list style that describes a platform's default behavior and appearance for a list:
+/// inset grouped on iOS.
+public struct DefaultListStyle: ListStyle { public init() {} }
+/// The list style that describes the behavior and appearance of a plain list.
+public struct PlainListStyle: ListStyle { public init() {} }
+/// The list style that describes the behavior and appearance of a grouped list.
+public struct GroupedListStyle: ListStyle { public init() {} }
+/// The list style that describes the behavior and appearance of an inset grouped list.
+public struct InsetGroupedListStyle: ListStyle { public init() {} }
+/// The list style that describes the behavior and appearance of an inset list.
+public struct InsetListStyle: ListStyle { public init() {} }
+/// The list style that describes the behavior and appearance of a sidebar list.
+public struct SidebarListStyle: ListStyle { public init() {} }
+
+extension ListStyle where Self == DefaultListStyle {
+    public static var automatic: DefaultListStyle { .init() }
+}
+
+extension ListStyle where Self == PlainListStyle {
+    public static var plain: PlainListStyle { .init() }
+}
+
+extension ListStyle where Self == GroupedListStyle {
+    public static var grouped: GroupedListStyle { .init() }
+}
+
+extension ListStyle where Self == InsetGroupedListStyle {
+    public static var insetGrouped: InsetGroupedListStyle { .init() }
+}
+
+extension ListStyle where Self == InsetListStyle {
+    public static var inset: InsetListStyle { .init() }
+}
+
+extension ListStyle where Self == SidebarListStyle {
+    public static var sidebar: SidebarListStyle { .init() }
+}
+
+enum IrisListStyle {
+    case insetGrouped, grouped, plain
+}
+
+extension View {
+    /// Sets the style for lists within this view.
+    public func listStyle<S>(_ style: S) -> some View where S: ListStyle {
+        let kind: IrisListStyle = switch style {
+        case is PlainListStyle, is InsetListStyle: .plain
+        case is GroupedListStyle: .grouped
+        default: .insetGrouped
+        }
+        return environment(\.irisListStyle, kind)
+    }
+
+    /// Specifies the visibility of the background for scrollable views within this view.
+    public func scrollContentBackground(_ visibility: Visibility) -> some View {
+        environment(\.irisContentBackground, visibility)
+    }
+
+    /// Places a custom background view behind a list row item.
+    public func listRowBackground<V>(_ view: V?) -> some View where V: View {
+        _trait(IrisRowBackgroundTrait.self, view.map { AnyView($0) })
+    }
+
+    /// Sets the display mode for the separator associated with this specific row.
+    public func listRowSeparator(_ visibility: Visibility, edges: VerticalEdge.Set = .all) -> some View {
+        _trait(IrisRowSeparatorTrait.self, visibility)
+    }
+
+    /// Sets the tint color associated with a row. Iris: rows keep their separators' color.
+    public func listRowSeparatorTint(_ color: Color?, edges: VerticalEdge.Set = .all) -> some View {
+        self
+    }
+
+    /// Applies an inset to the rows in a list.
+    public func listRowInsets(_ insets: EdgeInsets?) -> some View {
+        _trait(IrisRowInsetsTrait.self, insets)
+    }
+
+    /// Sets whether to hide the separator associated with a list section. Iris: sections have
+    /// none.
+    public func listSectionSeparator(_ visibility: Visibility, edges: VerticalEdge.Set = .all) -> some View {
+        self
+    }
+}
+
+extension EnvironmentValues {
+    var irisListStyle: IrisListStyle {
+        get { self[IrisListStyleKey.self] }
+        set { self[IrisListStyleKey.self] = newValue }
+    }
+
+    var irisContentBackground: Visibility {
+        get { self[IrisContentBackgroundKey.self] }
+        set { self[IrisContentBackgroundKey.self] = newValue }
+    }
+}
+
+private struct IrisListStyleKey: EnvironmentKey {
+    static var defaultValue: IrisListStyle { .insetGrouped }
+}
+
+private struct IrisContentBackgroundKey: EnvironmentKey {
+    static var defaultValue: Visibility { .automatic }
+}
+
+struct IrisRowBackgroundTrait: _ViewTraitKey {
+    static var defaultValue: AnyView? { nil }
+}
+
+struct IrisRowSeparatorTrait: _ViewTraitKey {
+    static var defaultValue: Visibility { .automatic }
+}
+
+struct IrisRowInsetsTrait: _ViewTraitKey {
+    static var defaultValue: EdgeInsets? { nil }
+}
+
+// MARK: - Swipe actions
+
+extension View {
+    /// Adds custom swipe actions to a row in a list: a drag from the other edge towards
+    /// `edge`'s opposite reveals them at `edge`.
+    public func swipeActions<T>(edge: HorizontalEdge = .trailing, allowsFullSwipe: Bool = true, @ViewBuilder content: () -> T) -> some View where T: View {
+        let actions = AnyView(content())
+        return Group {
+            if edge == .trailing {
+                _trait(IrisTrailingSwipeTrait.self, actions)
+            } else {
+                _trait(IrisLeadingSwipeTrait.self, actions)
+            }
+        }
+    }
+}
+
+struct IrisTrailingSwipeTrait: _ViewTraitKey {
+    static var defaultValue: AnyView? { nil }
+}
+
+struct IrisLeadingSwipeTrait: _ViewTraitKey {
+    static var defaultValue: AnyView? { nil }
+}
+
+/// How far the actions are revealed, kept apart from the view's state so gestures read the
+/// latest value.
+private final class SwipeState {
+    var revealed: CGFloat = 0
+    var leadingWidth: CGFloat = 0
+    var trailingWidth: CGFloat = 0
+}
+
+/// A list row with swipe actions: dragging it sideways reveals the actions of the edge it
+/// moves away from, as tall as the row.
+struct IrisSwipeRow<Content>: View where Content: View {
+    var leading: AnyView?
+    var trailing: AnyView?
+    var content: Content
+    @State private var offset: CGFloat = 0
+    @State private var state = SwipeState()
+    @GestureState private var drag: CGFloat = 0
+
+    init(leading: AnyView?, trailing: AnyView?, content: Content) {
+        self.leading = leading
+        self.trailing = trailing
+        self.content = content
+    }
+
+    var body: some View {
+        let position = offset + drag
+        let allowed = min(max(position, trailing == nil ? 0 : -.infinity), leading == nil ? 0 : .infinity)
+        content
+            .offset(x: allowed)
+            .overlay(alignment: .trailing) {
+                actions(trailing, width: max(-allowed, 0)) { [state] in state.trailingWidth = $0 }
+            }
+            .overlay(alignment: .leading) {
+                actions(leading, width: max(allowed, 0)) { [state] in state.leadingWidth = $0 }
+            }
+            .contentShape(Rectangle())
+            .gesture(
+                DragGesture(minimumDistance: 10)
+                    .updating($drag) { value, drag, _ in
+                        drag = value.translation.width
+                    }
+                    .onEnded { value in
+                        // Rest open when dragged past half the actions, closed otherwise.
+                        let travel = state.revealed + value.translation.width
+                        if trailing != nil, -travel > state.trailingWidth / 2 {
+                            state.revealed = -state.trailingWidth
+                        } else if leading != nil, travel > state.leadingWidth / 2 {
+                            state.revealed = state.leadingWidth
+                        } else {
+                            state.revealed = 0
+                        }
+                        withAnimation(.easeOut(duration: 0.25)) {
+                            offset = state.revealed
+                        }
+                    }
+            )
+    }
+
+    @ViewBuilder
+    private func actions(_ actions: AnyView?, width: CGFloat, measured: @escaping (CGFloat) -> Void) -> some View {
+        if let actions {
+            HStack(spacing: 0) {
+                actions
+            }
+            .buttonStyle(SwipeActionButtonStyle {
+                state.revealed = 0
+                withAnimation(.easeOut(duration: 0.25)) {
+                    offset = 0
+                }
+            })
+            .fixedSize(horizontal: true, vertical: false)
+            .frame(maxHeight: .infinity)
+            .onGeometryChange(for: CGFloat.self) { $0.size.width } action: { measured($0) }
+            .frame(width: width)
+            .clipped()
+            .opacity(width > 0 ? 1 : 0)
+        }
+    }
+}
+
+/// A swipe action: its label in white on the tint, red when destructive, as tall as the row.
+private struct SwipeActionButtonStyle: PrimitiveButtonStyle {
+    var close: () -> Void
+    @Environment(\.tintColor) private var tint
+
+    func makeBody(configuration: Configuration) -> some View {
+        configuration.label
+            .labelStyle(.titleOnly)
+            .foregroundStyle(Color.white)
+            .lineLimit(1)
+            .padding(.horizontal, 12)
+            .frame(minWidth: 74, maxHeight: .infinity)
+            .background(configuration.role == .destructive ? systemRed : tint ?? systemGray)
+            .contentShape(Rectangle())
+            .onTapGesture {
+                close()
+                configuration.trigger()
+            }
+    }
+}
+
+// MARK: - Deleting and moving
+
+extension ForEach where Content: View {
+    /// Sets the deletion action for the dynamic view: each row gets a Delete swipe action.
+    public func onDelete(perform action: ((IndexSet) -> Void)?) -> ForEach<Data, ID, IrisDeletableRow<Content>> {
+        let data = data
+        let content = content
+        let idGenerator = idGenerator
+        let rowIDs: ForEach<Data, ID, IrisDeletableRow<Content>>.IDGenerator = switch idGenerator {
+        case let .keyPath(keyPath): .keyPath(keyPath)
+        case .offset: .offset
+        }
+        return ForEach<Data, ID, IrisDeletableRow<Content>>(data, idGenerator: rowIDs) { element in
+            IrisDeletableRow(content: content(element)) {
+                if let action, let offset = Self.offset(of: element, in: data, idGenerator: idGenerator) {
+                    action(IndexSet(integer: offset))
+                }
+            }
+        }
+    }
+
+    /// Sets the move action for the dynamic view. Iris: rows cannot be moved yet.
+    public func onMove(perform action: ((IndexSet, Int) -> Void)?) -> ForEach<Data, ID, Content> {
+        self
+    }
+
+    private static func offset(of element: Data.Element, in data: Data, idGenerator: IDGenerator) -> Int? {
+        switch idGenerator {
+        case let .keyPath(keyPath):
+            let id = element[keyPath: keyPath]
+            return data.firstIndex { $0[keyPath: keyPath] == id }.map { data.distance(from: data.startIndex, to: $0) }
+        case .offset:
+            guard let value = element as? Int, let first = data.first as? Int else { return nil }
+            return value - first
+        }
+    }
+}
+
+/// A row of a ForEach with onDelete: the row with a Delete swipe action.
+public struct IrisDeletableRow<Content>: View where Content: View {
+    var content: Content
+    var delete: () -> Void
+
+    public var body: some View {
+        content.swipeActions {
+            Button("Delete", role: .destructive, action: delete)
+        }
+    }
+}
