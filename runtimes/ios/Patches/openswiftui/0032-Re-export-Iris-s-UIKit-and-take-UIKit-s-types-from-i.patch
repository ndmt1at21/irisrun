 @available(OpenSwiftUI_v2_0, *)
-public struct _CALayerView<LayerType>: View where LayerType: CALayer {
+public struct _CALayerView<LayerType>: View where LayerType: OpenQuartzCoreShims.CALayer {
     /// The function used to update the layer instance.
     public var update: (LayerType) -> Void
 }
@@ -40,17 +41,17 @@ extension _CALayerView: RendererLeafView, PlatformLayerFactory {
         .platformLayer(self)
     }
 
-    package var platformLayerType: CALayer.Type {
+    package var platformLayerType: OpenQuartzCoreShims.CALayer.Type {
         LayerType.self
     }
 
-    package func updatePlatformLayer(_ layer: CALayer) {
+    package func updatePlatformLayer(_ layer: OpenQuartzCoreShims.CALayer) {
         update(layer as! LayerType)
     }
 }
 
 @available(OpenSwiftUI_v2_0, *)
-extension _CALayerView where LayerType == CALayer {
+extension _CALayerView where LayerType == OpenQuartzCoreShims.CALayer {
     /// Initializes with a function to update the layer whenever the
