index 0000000..59802e9
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/Control/IrisControls.swift
@@ -0,0 +1,135 @@
+//
+//  IrisControls.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+import OpenSwiftUICore
+
+// Iris: iOS controls drawn by SwiftUI itself on Linux, where UIKit is not there to draw a
+// UISwitch, UISlider or UIProgressView. Sizes and colors follow UIKit's defaults.
+
+/// systemGreen, UISwitch's default on color.
+private let switchOn = Color(red: 52 / 255, green: 199 / 255, blue: 89 / 255)
+/// The off track of UISwitch and the empty track of UISlider and UIProgressView.
+private let trackOff = Color(red: 233 / 255, green: 233 / 255, blue: 234 / 255)
+/// systemBlue, the default tint.
+private let systemBlue = Color(red: 0, green: 122 / 255, blue: 1)
+
+// MARK: - IrisSwitch
+
+/// UISwitch: 51 × 31 points; a tap flips it.
+struct IrisSwitch: View {
+    @Binding var isOn: Bool
+    var tint: Color?
+
+    var body: some View {
+        ZStack(alignment: isOn ? .trailing : .leading) {
+            Capsule().fill(isOn ? (tint ?? switchOn) : trackOff)
+            Circle()
+                .fill(Color.white)
+                .shadow(color: .black.opacity(0.15), radius: 2, y: 2)
+                .padding(2)
+        }
+        .frame(width: 51, height: 31)
+        .contentShape(Rectangle())
+        .onTapGesture {
+            withAnimation(.easeInOut(duration: 0.2)) {
+                isOn.toggle()
+            }
+        }
+    }
+}
+
+// MARK: - IrisSlider
+
+/// UISlider: a 4-point track filled in the tint up to a 28-point thumb, which a touch drags.
+/// `value` runs from 0 to 1; a slider with steps snaps to them.
+struct IrisSlider: View {
+    @Binding var value: Double
+    var steps: Int
+    var tint: Color?
+    var onEditingChanged: (Bool) -> Void
+
+    @State private var isEditing = false
+
+    var body: some View {
+        GeometryReader { track in
+            let thumb: CGFloat = 28
+            let usable = max(track.size.width - thumb, 1)
+            let fraction = min(max(value, 0), 1)
+            ZStack(alignment: .leading) {
+                Capsule().fill(trackOff).frame(height: 4)
+                Capsule()
+                    .fill(tint ?? systemBlue)
+                    .frame(width: thumb / 2 + usable * fraction, height: 4)
+                Circle()
+                    .fill(Color.white)
+                    .shadow(color: .black.opacity(0.2), radius: 3, y: 2)
+                    .frame(width: thumb, height: thumb)
+                    .offset(x: usable * fraction)
+            }
+            .frame(height: track.size.height)
+            .contentShape(Rectangle())
+            .gesture(DragGesture(minimumDistance: 0).onChanged { drag in
+                if !isEditing {
+                    isEditing = true
+                    onEditingChanged(true)
+                }
+                var fraction = min(max((drag.location.x - thumb / 2) / usable, 0), 1)
+                if steps > 1 {
+                    fraction = (fraction * CGFloat(steps - 1)).rounded() / CGFloat(steps - 1)
+                }
+                value = Double(fraction)
+            }.onEnded { _ in
+                isEditing = false
+                onEditingChanged(false)
+            })
+        }
+        .frame(height: 34)
+    }
+}
+
+// MARK: - Progress
+
+/// UIProgressView's default style: a 4-point track filled in the tint.
+struct IrisLinearProgress: View {
+    var fraction: Double?
+    var tint: Color?
+
+    var body: some View {
+        GeometryReader { track in
+            ZStack(alignment: .leading) {
+                Capsule().fill(trackOff)
+                Capsule()
+                    .fill(tint ?? systemBlue)
+                    .frame(width: track.size.width * min(max(fraction ?? 0, 0), 1))
+            }
+        }
+        .frame(height: 4)
+    }
+}
+
+/// UIActivityIndicatorView's medium style: eight bars around a circle fading in turn.
+/// ponytail: it stands still.
+struct IrisSpinner: View {
+    var tint: Color?
+
+    var body: some View {
+        ZStack {
+            ForEach(0 ..< 8, id: \.self) { index in
+                Capsule()
+                    .fill(tint ?? Color.gray)
+                    .frame(width: 3, height: 6)
+                    .offset(y: -6)
+                    .rotationEffect(.degrees(Double(index) * 45))
+                    .opacity(0.25 + 0.75 * Double(index) / 7)
+            }
+        }
+        .frame(width: 20, height: 20)
+    }
+}
+#endif
