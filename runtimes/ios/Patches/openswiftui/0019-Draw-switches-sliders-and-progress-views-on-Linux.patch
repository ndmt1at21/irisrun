 .../CircularProgressViewStyle.swift           |   2 +-
 .../LinearProgressViewStyle.swift             |   2 +-
 .../Control/Slider/SystemSliderStyle.swift    |  17 +++
 .../View/Toggle/SwitchToggleStyle.swift       |   2 +-
 Sources/OpenSwiftUI/View/Toggle/Toggle.swift  |  26 ++++
