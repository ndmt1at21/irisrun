@@ -0,0 +1,400 @@
+//
+//  IrisHostingView.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+@_spi(DisplayList_ViewSystem)
+import OpenSwiftUICore
+import IrisHost
+import IrisRender
+import OpenUIKit
+
+// MARK: - _UIHostingView
+
+/// Iris: the view of a `UIHostingController` in Iris's UIKit. Its SwiftUI content lays out in
+/// the view's bounds and safe area, renders when the view lays out (the view asks for layout
+/// whenever the view graph asks for an update), and draws through the render core into a
+/// layer of its own that the view's layer holds (`IrisLayerHost`). UIKit hit-tests touches to
+/// it as to any view, and they go on to SwiftUI's gestures. While one of its text fields is
+/// focused it is UIKit's first responder, so that the keyboard reaches SwiftUI, and a UIKit
+/// text input that takes the keyboard ends SwiftUI's editing.
+final class _UIHostingView<Content>: UIView, ViewRendererHost, ViewGraphRenderDelegate, EventGraphHost, IrisLayerHost where Content: View {
+    typealias RootView = ModifiedContent<ModifiedContent<Content, IrisPresentationHost>, HitTestBindingModifier>
+
+    let viewGraph: ViewGraph
+    let renderer = DisplayList.ViewRenderer(platform: .init(definition: IrisPlatformViewDefinition.self))
+    let eventBindingManager = EventBindingManager()
+    private lazy var input = DeviceInput(manager: eventBindingManager)
+
+    var rootView: Content {
+        didSet { invalidateProperties(.rootView) }
+    }
+
+    /// The environment the content starts from, such as its scene's; UIKit's traits go over it.
+    var inheritedEnvironment: EnvironmentValues? {
+        didSet { invalidateProperties(.environment) }
+    }
+
+    var safeAreaRegions = SafeAreaRegions.all {
+        didSet { invalidateProperties(.safeArea) }
+    }
+
+    var sizingOptions: UIHostingControllerSizingOptions = []
+    weak var hostingController: UIViewController?
+
+    var currentTimestamp: Time = .zero
+    var propertiesNeedingUpdate: ViewRendererHostProperties = .all
+    var renderingPhase: ViewRenderingPhase = .none
+    var externalUpdateCount: Int = .zero
+
+    /// The soonest update the view graph asked for, in seconds, for a script to settle.
+    private var requestedUpdate: Double?
+    /// The script's `irisScriptTime` that the view graph's clock has caught up with.
+    private var scriptTime = irisScriptTime
+    /// When the device next renders, at the latest.
+    private var scheduledRender: DispatchTime?
+    private var laidOut: (size: CGSize, safeArea: UIEdgeInsets)?
+    private var lastIdealSize: CGSize?
+    /// The SwiftUI text field this view stands in for as UIKit's first responder.
+    private var focusedSession: TextEditingSession?
+
+    init(rootView: Content) {
+        self.rootView = rootView
+        Update.begin()
+        viewGraph = ViewGraph(rootViewType: RootView.self, requestedOutputs: [.displayList, .layout, .viewResponders])
+        super.init(frame: .zero)
+        renderer.host = self
+        eventBindingManager.host = self
+        initializeViewGraph()
+        Update.end()
+        // As UIHostingController's view on iOS.
+        backgroundColor = .systemBackground
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    /// The render core layer the display list draws in, in this view's layer.
+    lazy var irisLayer: IrisRender.Layer = {
+        let layer = IrisRender.Layer(in: irisScene)
+        self.layer._irisContentLayer = layer
+        return layer
+    }()
+
+    // MARK: Rendering
+
+    /// Renders with the view graph's clock caught up: on a device it follows the uptime clock,
+    /// as touches do; a script's moves on by the time its steps let pass (`irisScriptTime`), as
+    /// while a finger is held, and while a step settles.
+    private func renderCaughtUp() {
+        let interval = irisAnimates ? max(Time.systemUptime - currentTimestamp, 0) : irisScriptTime - scriptTime
+        scriptTime = irisScriptTime
+        render(interval: interval, targetTimestamp: nil)
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        let safeArea = safeAreaRegions.contains(.container) ? safeAreaInsets : .zero
+        if laidOut?.size != bounds.size {
+            invalidateProperties([.size, .containerSize])
+        }
+        if laidOut?.safeArea != safeArea {
+            invalidateProperties(.safeArea)
+        }
+        laidOut = (bounds.size, safeArea)
+        irisLayer.frame = Rect(x: 0, y: 0, width: Float(bounds.width), height: Float(bounds.height))
+        reconcilingFocus {
+            renderCaughtUp()
+            if !irisAnimates {
+                settle()
+            }
+        }
+        updateSizing()
+    }
+
+    /// Renders the updates the view graph asks for, such as the frames of an animation, on a
+    /// virtual 60 Hz clock until none is left, so that a script's step ends where SwiftUI
+    /// settles.
+    private func settle() {
+        var elapsed = 0.0
+        while let delay = requestedUpdate {
+            requestedUpdate = nil
+            // Endless animations and repeating timers never settle.
+            guard elapsed < 2 else {
+                printError("still updating after 2 s of app time; taking the frame as it is")
+                return
+            }
+            let interval = max(delay, 1.0 / 60)
+            elapsed += interval
+            render(interval: interval, targetTimestamp: nil)
+        }
+    }
+
+    /// What `sizingOptions` ask for after a render: the content's ideal size as the
+    /// controller's preferred size, or as the view's intrinsic size.
+    private func updateSizing() {
+        guard !sizingOptions.isEmpty else { return }
+        let size = intrinsicContentSize
+        if sizingOptions.contains(.preferredContentSize) {
+            hostingController?.preferredContentSize = size
+        }
+        if sizingOptions.contains(.intrinsicContentSize), lastIdealSize != size {
+            invalidateIntrinsicContentSize()
+        }
+        lastIdealSize = size
+    }
+
+    override var intrinsicContentSize: CGSize {
+        sizeThatFits(CGSize(width: CGFloat.infinity, height: .infinity))
+    }
+
+    /// The content's size for a proposal; dimensions beyond any screen are left to the content.
+    override func sizeThatFits(_ size: CGSize) -> CGSize {
+        let unspecified = 2_777_780.0
+        let fitting = sizeThatFits(_ProposedSize(
+            width: size.width >= unspecified ? nil : size.width,
+            height: size.height >= unspecified ? nil : size.height
+        ))
+        let pixelLength = 1 / (window?.screen.scale ?? UIScreen.main.scale)
+        return CGSize(
+            width: fitting.width.rounded(.up, toMultipleOf: pixelLength),
+            height: fitting.height.rounded(.up, toMultipleOf: pixelLength)
+        )
+    }
+
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        invalidateProperties([.environment, .safeArea])
+    }
+
+    // MARK: Input
+
+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent?) {
+        forward(touches, as: .began)
+    }
+
+    override func touchesMoved(_ touches: Set<UITouch>, with event: UIEvent?) {
+        forward(touches, as: .moved)
+    }
+
+    override func touchesEnded(_ touches: Set<UITouch>, with event: UIEvent?) {
+        forward(touches, as: .ended)
+    }
+
+    override func touchesCancelled(_ touches: Set<UITouch>, with event: UIEvent?) {
+        forward(touches, as: .cancelled)
+    }
+
+    /// The touches UIKit gives this view, in its coordinates, as SwiftUI's gestures take them.
+    private func forward(_ touches: Set<UITouch>, as phase: DeviceTouch.Phase) {
+        let time = touches.map(\.timestamp).max() ?? ProcessInfo.processInfo.systemUptime
+        touch(touches.map { touch in
+            DeviceTouch(id: UInt32(truncatingIfNeeded: ObjectIdentifier(touch).hashValue), phase: phase, location: touch.location(in: self))
+        }, at: time)
+    }
+
+    /// Runs input through SwiftUI's event system and text fields, with the view graph's clock
+    /// caught up first, as gestures such as a long press time touches with it; the result shows
+    /// when the view next lays out.
+    private func send(_ body: (DeviceInput) -> Void) {
+        reconcilingFocus {
+            if irisAnimates || scriptTime != irisScriptTime {
+                renderCaughtUp()
+            }
+            body(input)
+        }
+        setNeedsLayout()
+    }
+
+    // MARK: Focus
+
+    override var canBecomeFirstResponder: Bool {
+        focusedSession != nil
