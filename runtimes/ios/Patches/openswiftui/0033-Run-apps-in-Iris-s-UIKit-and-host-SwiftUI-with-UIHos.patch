+
+#if !canImport(Darwin)
+/// Iris: holds the app delegate that `UIApplicationDelegateAdaptor` made.
+final class IrisDelegateBox: AnyFallbackDelegateBox {
+    private let instance: NSObject?
+
+    init(_ instance: NSObject?) {
+        self.instance = instance
