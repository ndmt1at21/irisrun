+    /// A device renders again after the delay, at most 60 times a second; a script settles
+    /// what is asked for while it renders, and renders the rest when the view lays out.
+    func requestUpdate(after delay: Double) {
+        requestedUpdate = min(requestedUpdate ?? delay, delay)
+        guard irisAnimates else {
+            if !isRendering {
+                setNeedsLayout()
+            }
+            return
+        }
+        let time = DispatchTime.now() + max(delay, 1.0 / 60)
+        if let scheduledRender, scheduledRender <= time {
+            return
+        }
+        scheduledRender = time
+        DispatchQueue.main.asyncAfter(deadline: time) { [weak self] in
+            guard let self else { return }
+            MainActor.assumeIsolated {
+                guard let scheduledRender = self.scheduledRender, scheduledRender <= .now() else { return }
+                self.scheduledRender = nil
+                self.setNeedsLayout()
+            }
+        }
