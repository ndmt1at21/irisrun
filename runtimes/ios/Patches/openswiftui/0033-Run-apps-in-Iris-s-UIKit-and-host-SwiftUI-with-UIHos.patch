index 0000000..7cff5d4
--- /dev/null
+++ b/Sources/OpenSwiftUI/App/App/Stdout/IrisApp.swift
@@ -0,0 +1,138 @@
+//
+//  IrisApp.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+import OpenSwiftUICore
+import IrisHost
+import OpenUIKit
+
+// MARK: - runIrisApp
+
+/// Iris: runs the app as on iOS, in Iris's UIKit, which shows it on a device or plays a script
+/// against it with the host it has for every app: UIKit launches with SwiftUI's app delegate,
+/// whose scene delegate shows the app's first scene in a window, under a UIHostingController.
+func runIrisApp(_ app: some App) -> Never {
+    Update.dispatchImmediately(reason: nil) {
+        let graph = AppGraph(app: app)
+        graph.instantiate()
+        AppGraph.shared = graph
+    }
+    MainActor.assumeIsolated {
+        IrisAppDelegate.main()
+    }
+    exit(0)
+}
+
+// MARK: - IrisAppDelegate
+
+/// Iris: SwiftUI's app delegate. It passes UIKit's callbacks on to the app's own delegate, if
+/// the app has one (`UIApplicationDelegateAdaptor`), and makes the app's window scene with
+/// `IrisSceneDelegate`.
+// ponytail: the lifecycle callbacks are passed on, not every method as SwiftUI forwards them on
+// iOS; the app delegate's own scene configurations and delegates are not asked.
+final class IrisAppDelegate: UIResponder, UIApplicationDelegate, _IrisInstantiable {
+    static func _irisMake() -> AnyObject {
+        IrisAppDelegate()
+    }
+
+    private lazy var fallback = AppGraph.delegateBox?.delegate as? any UIApplicationDelegate
+
+    func application(_ application: UIApplication, willFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
+        fallback?.application(application, willFinishLaunchingWithOptions: launchOptions) ?? true
+    }
+
+    func application(_ application: UIApplication, didFinishLaunchingWithOptions launchOptions: [UIApplication.LaunchOptionsKey: Any]?) -> Bool {
+        fallback?.application(application, didFinishLaunchingWithOptions: launchOptions) ?? true
+    }
+
+    func applicationDidBecomeActive(_ application: UIApplication) {
+        fallback?.applicationDidBecomeActive(application)
+    }
+
+    func applicationWillResignActive(_ application: UIApplication) {
+        fallback?.applicationWillResignActive(application)
+    }
+
+    func applicationDidEnterBackground(_ application: UIApplication) {
+        fallback?.applicationDidEnterBackground(application)
+    }
+
+    func applicationWillEnterForeground(_ application: UIApplication) {
+        fallback?.applicationWillEnterForeground(application)
+    }
+
+    func applicationWillTerminate(_ application: UIApplication) {
+        fallback?.applicationWillTerminate(application)
+    }
+
+    func application(_ application: UIApplication, configurationForConnecting connectingSceneSession: UISceneSession, options: UIScene.ConnectionOptions) -> UISceneConfiguration {
+        let configuration = UISceneConfiguration(name: nil, sessionRole: connectingSceneSession.role)
+        configuration.delegateClass = IrisSceneDelegate.self
+        return configuration
+    }
+}
+
+// MARK: - IrisSceneDelegate
+
+/// Iris: shows the app's first scene in the window scene that UIKit connects, in a window whose
+/// root is a UIHostingController, with UIKit's scene phase in the scene's environment.
+// ponytail: one scene, made once; changes to the app's scenes and scene storage come later.
+final class IrisSceneDelegate: UIResponder, UIWindowSceneDelegate, _IrisInstantiable {
+    static func _irisMake() -> AnyObject {
+        IrisSceneDelegate()
+    }
+
+    var window: UIWindow?
+    private var controller: UIHostingController<IrisSceneRoot>?
+
+    func scene(_ scene: UIScene, willConnectTo session: UISceneSession, options connectionOptions: UIScene.ConnectionOptions) {
+        guard let windowScene = scene as? UIWindowScene,
+              let item = Update.ensure({ AppGraph.shared?.rootSceneList?.items.first }) else {
+            printError("OpenSwiftUI: the app has no scene to show")
+            return
+        }
+        let controller = UIHostingController(rootView: IrisSceneRoot(content: item.value.view, phase: .inactive))
+        controller.host.inheritedEnvironment = item.environment
+        // ponytail: the app's views lay out under the status bar and the home indicator, as
+        // Iris has always shown SwiftUI apps; UIKit's safe area (47 and 34 points) once the
+        // SwiftUI sample's session and frames are made anew for it.
+        controller.safeAreaRegions = []
+        let window = UIWindow(windowScene: windowScene)
+        window.rootViewController = controller
+        window.makeKeyAndVisible()
+        self.window = window
+        self.controller = controller
+    }
+
+    func sceneWillEnterForeground(_ scene: UIScene) {
+        controller?.rootView.phase = .inactive
+    }
+
+    func sceneDidBecomeActive(_ scene: UIScene) {
+        controller?.rootView.phase = .active
+    }
+
+    func sceneWillResignActive(_ scene: UIScene) {
+        controller?.rootView.phase = .inactive
+    }
+
+    func sceneDidEnterBackground(_ scene: UIScene) {
+        controller?.rootView.phase = .background
+    }
+}
+
+/// Iris: a scene's views, in its phase.
+struct IrisSceneRoot: View {
+    var content: AnyView
+    var phase: ScenePhase
+
+    var body: some View {
+        content.environment(\.scenePhase, phase)
+    }
+}
+#endif
