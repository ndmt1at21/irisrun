+//
+//  IrisHostingController.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+public import OpenUIKit
+
+/// A UIKit view controller that manages a SwiftUI view hierarchy.
+///
+/// Iris: in Iris's UIKit, with a `_UIHostingView` (IrisHostingView.swift) as its view.
+@MainActor
+@preconcurrency
+open class UIHostingController<Content>: UIViewController where Content: View {
+    let host: _UIHostingView<Content>
+
+    public init(rootView: Content) {
+        host = _UIHostingView(rootView: rootView)
+        super.init(nibName: nil, bundle: nil)
+        host.hostingController = self
+    }
+
+    public init?(coder aDecoder: NSCoder, rootView: Content) {
+        host = _UIHostingView(rootView: rootView)
+        super.init(coder: aDecoder)
+        host.hostingController = self
+    }
+
+    public required init?(coder aDecoder: NSCoder) {
+        preconditionFailure("init(coder:) must be implemented in a subclass and call super.init(coder:, rootView:)")
+    }
+
+    open override func loadView() {
+        view = host
+    }
+
+    /// The root view of the SwiftUI view hierarchy managed by this view controller.
+    public var rootView: Content {
+        get { host.rootView }
+        set { host.rootView = newValue }
+    }
+
+    /// The options for how the hosting controller tracks changes to the size of its SwiftUI
+    /// content.
+    public var sizingOptions: UIHostingControllerSizingOptions {
+        get { host.sizingOptions }
+        set {
+            host.sizingOptions = newValue
+            host.setNeedsLayout()
+        }
+    }
+
+    /// Calculates and returns the most appropriate size for the current view.
+    public func sizeThatFits(in size: CGSize) -> CGSize {
+        host.sizeThatFits(size)
+    }
+
+    /// The safe area regions that this view controller adds to its view.
+    public var safeAreaRegions: SafeAreaRegions {
+        get { host.safeAreaRegions }
+        set { host.safeAreaRegions = newValue }
+    }
+}
+#endif
