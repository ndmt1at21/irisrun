+
+// Iris: on Linux, focus is a value the view keeps, like @State. `focused(_:equals:)` hands the
+// text fields under it a target to keep in step with: setting the value focuses the matching
+// field, and a field that gains or loses the keyboard sets the value.
+@available(OpenSwiftUI_v3_0, *)
+@propertyWrapper
+public struct FocusState<Value>: DynamicProperty where Value: Hashable {
+    @propertyWrapper
+    public struct Binding {
+        let box: FocusBox<Value>
+
+        public var wrappedValue: Value {
+            get { box.value }
+            nonmutating set { box.value = newValue }
+        }
+
+        public var projectedValue: FocusState<Value>.Binding {
+            self
+        }
+
+        var propertyID: ObjectIdentifier {
+            ObjectIdentifier(box)
+        }
+    }
+
+    // A reference, not the value: actions that run during an update read a Binding's value as
+    // it was when the view drew, and focus changes there, as when Return moves to the next field.
+    @State private var box: FocusBox<Value>
+
+    public var wrappedValue: Value {
+        get { box.value }
+        nonmutating set { box.value = newValue }
+    }
+
+    public var projectedValue: FocusState<Value>.Binding {
+        Binding(box: box)
+    }
+
+    public init() where Value == Bool {
+        _box = State(initialValue: FocusBox(false))
+    }
+
+    public init<T>() where Value == T?, T: Hashable {
+        _box = State(initialValue: FocusBox(nil))
+    }
+}
+
+/// Iris: the value of a `FocusState`, which views observe.
+final class FocusBox<Value>: Observable where Value: Hashable {
+    private let registrar = ObservationRegistrar()
+    private var _value: Value
+    /// The value when nothing in the scope has focus.
+    let resetValue: Value
+
+    init(_ resetValue: Value) {
+        _value = resetValue
+        self.resetValue = resetValue
+    }
+
+    var value: Value {
+        get {
+            registrar.access(self, keyPath: \.value)
+            return _value
+        }
+        set {
+            guard newValue != _value else { return }
+            registrar.withMutation(of: self, keyPath: \.value) { _value = newValue }
+        }
+    }
+}
+
+/// Iris: what `focused(_:equals:)` tells the text fields under it.
+struct IrisFocusTarget {
+    var isFocused: Bool
+    var focus: () -> Void
+    var blur: () -> Void
+}
+
+extension EnvironmentValues {
+    var irisFocusTarget: IrisFocusTarget? {
+        get { self[IrisFocusTargetKey.self] }
+        set { self[IrisFocusTargetKey.self] = newValue }
+    }
+}
+
+private struct IrisFocusTargetKey: EnvironmentKey {
+    static var defaultValue: IrisFocusTarget? { nil }
+}
+#endif
+
 @available(*, unavailable)
 extension FocusState: Sendable {}
 
 @available(*, unavailable)
 extension FocusState.Binding: Sendable {}
 
+#if canImport(Darwin)
 // MARK: - View + Focus State
 
 @available(OpenSwiftUI_v3_0, *)
@@ -422,6 +515,30 @@ extension View {
     }
 }
 
+#else
+@available(OpenSwiftUI_v3_0, *)
+extension View {
+    nonisolated public func focused<Value>(
+        _ binding: FocusState<Value>.Binding,
+        equals value: Value
+    ) -> some View where Value: Hashable {
+        environment(\.irisFocusTarget, IrisFocusTarget(
+            isFocused: binding.wrappedValue == value,
+            focus: { binding.wrappedValue = value },
+            blur: {
+                if binding.wrappedValue == value {
+                    binding.wrappedValue = binding.box.resetValue
+                }
+            }
+        ))
+    }
+
+    nonisolated public func focused(_ condition: FocusState<Bool>.Binding) -> some View {
+        focused(condition, equals: true)
+    }
+}
+#endif
