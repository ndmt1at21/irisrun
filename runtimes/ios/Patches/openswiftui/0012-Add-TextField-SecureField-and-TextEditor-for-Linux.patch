+// MARK: - TextEditor
+
+/// A view that can display and edit long-form text. It fills the space it is offered.
+public struct TextEditor: View {
+    private var text: Binding<String>
+
+    public init(text: Binding<String>) {
+        self.text = text
+    }
+
+    public var body: some View {
+        EditableText(text: text, prompt: nil, kind: .editor)
+    }
+}
+
+// MARK: - EditableText
+
+/// Iris: what the text controls draw: the text or its placeholder, the marked text underlined,
+/// and a caret where the render core lays it out, while the field has the keyboard.
+struct EditableText: View {
+    enum Kind {
+        /// One line that scrolls sideways to keep the caret in view.
+        case field
+        /// A field that shows a bullet for each character.
+        case secure
+        /// Lines that wrap, as tall as the text.
+        case growing
+        /// Lines that wrap in all the space offered, with UITextView's insets.
+        case editor
+    }
+
+    var text: Binding<String>
+    var prompt: Text?
+    var kind: Kind
+    var onEditingChanged: (Bool) -> Void = { _ in }
+    var onCommit: () -> Void = {}
+
+    @State private var session = TextEditingSession()
+    @Environment(\.self) private var environment
+    @Environment(\.irisFocusTarget) private var focusTarget
+    @Environment(\.irisSubmitActions) private var submitActions
+    @Environment(\.irisRoundedBorderTextFields) private var roundedBorder
+    @Environment(\.isEnabled) private var isEnabled
+
+    /// UIColor.placeholderText.
+    private static let placeholderColor = Color(red: 60 / 255, green: 60 / 255, blue: 67 / 255, opacity: 0.3)
+
+    private var isMultiline: Bool {
+        kind == .growing || kind == .editor
+    }
+
+    var body: some View {
+        let isFocused = TextInputFocus.shared.session === session
+        let value = text.wrappedValue
+        let state = isFocused ? session.state(for: value) : TextEditingState(text: value)
+        // The session runs keys with the field's latest binding and actions.
+        session.binding = text
+        session.isMultiline = isMultiline
+        session.submit = { [submitActions, onCommit] in
+            for action in submitActions {
+                action()
+            }
+            onCommit()
+        }
+        return Group {
+            if isMultiline {
+                lines(Shown(state, secure: false), isFocused: isFocused)
+            } else {
+                line(Shown(state, secure: kind == .secure), isFocused: isFocused)
+            }
+        }
+        .modifier(RoundedBorder(isOn: roundedBorder && kind != .editor))
+        // Touches beside the text, as in the border or below the last line, focus the field
+        // and keep the caret where it is.
+        .contentShape(Rectangle())
+        .onTapGesture {
+            guard isEnabled else { return }
+            focus()
+            focusTarget?.focus()
+        }
+        .onChange(of: focusTarget?.isFocused ?? false, initial: true) { _, wantsFocus in
+            if wantsFocus {
+                focus()
+            } else if TextInputFocus.shared.session === session {
+                TextInputFocus.shared.session = nil
+            }
+        }
+        .onChange(of: isFocused) { _, isFocused in
+            onEditingChanged(isFocused)
+            if !isFocused {
+                focusTarget?.blur()
+            }
+        }
+        .onDisappear {
+            if TextInputFocus.shared.session === session {
+                TextInputFocus.shared.session = nil
+            }
+        }
+    }
+
+    // MARK: Layout
+
+    /// One line, as tall as the font's line, that scrolls sideways to keep the caret in view.
+    private func line(_ shown: Shown, isFocused: Bool) -> some View {
+        let style = textStyle(shown.string)
+        let caret = irisScene.caret(in: shown.string, style: style, at: shown.caret)
+        return Text(verbatim: " ")
+            .frame(maxWidth: .infinity, alignment: .leading)
+            .hidden()
+            .overlay {
+                GeometryReader { field in
+                    let scroll = max(0, CGFloat(caret.x) + 2 - field.size.width)
+                    ZStack(alignment: .topLeading) {
+                        Color.clear
+                        Group {
+                            decorations(shown, style: style, maxWidth: .infinity, caret: caret, isFocused: isFocused)
+                        }
+                        .offset(x: -scroll)
+                    }
+                    .contentShape(Rectangle())
+                    .onTapGesture(coordinateSpace: .local) { location in
+                        tap(x: location.x + scroll, y: location.y, maxWidth: .infinity)
+                    }
+                }
+            }
+            .clipped()
+    }
+
+    /// Lines that wrap at the width offered.
+    private func lines(_ shown: Shown, isFocused: Bool) -> some View {
+        let style = textStyle(shown.string)
+        let insets = kind == .editor ? EdgeInsets(top: 8, leading: 5, bottom: 8, trailing: 5) : EdgeInsets()
+        return Text(verbatim: shown.string.isEmpty ? " " : shown.string)
+            .frame(maxWidth: .infinity, alignment: .topLeading)
+            .hidden()
+            .overlay {
+                GeometryReader { box in
+                    let width = Float(box.size.width)
+                    let caret = irisScene.caret(in: shown.string, style: style, maxWidth: width, at: shown.caret)
+                    ZStack(alignment: .topLeading) {
+                        Color.clear
+                        decorations(shown, style: style, maxWidth: width, caret: caret, isFocused: isFocused)
+                    }
+                    .contentShape(Rectangle())
+                    .onTapGesture(coordinateSpace: .local) { location in
+                        tap(x: location.x, y: location.y, maxWidth: width)
+                    }
+                }
+            }
+            .padding(insets)
+            .frame(maxHeight: kind == .editor ? .infinity : nil, alignment: .top)
+    }
+
+    /// The text or the placeholder, the marked text's underline and the caret, from the top-left
+    /// corner of the text.
+    @ViewBuilder
+    private func decorations(
+        _ shown: Shown,
+        style: IrisRender.TextStyle,
+        maxWidth: Float,
+        caret: IrisRender.Caret,
+        isFocused: Bool
+    ) -> some View {
+        if shown.string.isEmpty, let prompt {
+            prompt
+                .foregroundStyle(Self.placeholderColor)
+                .lineLimit(isMultiline ? nil : 1)
+                .fixedSize(horizontal: !isMultiline, vertical: true)
+        }
+        Text(verbatim: shown.string)
+            .foregroundStyle(isEnabled ? Color.primary : Self.placeholderColor)
+            .fixedSize(horizontal: !isMultiline, vertical: true)
+            .frame(width: isMultiline ? CGFloat(maxWidth) : nil, alignment: .topLeading)
+        if !shown.marked.isEmpty {
+            // ponytail: one underline from the start of the marked text to the caret; marked
+            // text that wraps onto another line is underlined on the caret's line only.
+            let start = irisScene.caret(in: shown.string, style: style, maxWidth: maxWidth, at: shown.marked.lowerBound)
+            let startX = start.y == caret.y ? CGFloat(start.x) : 0
+            Rectangle()
+                .fill(Color.primary)
+                .frame(width: max(CGFloat(caret.x) - startX, 1), height: 1)
+                .offset(x: startX, y: CGFloat(caret.y + caret.height) - 1)
+        }
+        if isFocused {
+            Rectangle()
+                .fill(Color.accentColor)
+                .frame(width: 2, height: CGFloat(caret.height))
+                .offset(x: CGFloat(caret.x) - 1, y: CGFloat(caret.y))
+        }
+    }
+
+    /// How the render core draws `string` in this field's environment, as Text would.
+    private func textStyle(_ string: String) -> IrisRender.TextStyle {
+        // One character to resolve the style with, as empty text has no attributes.
+        let sample = Text(verbatim: string.isEmpty ? " " : string)
+        return sample.resolveAttributedString(in: environment)?.irisTextStyle(lineLimit: nil) ?? IrisRender.TextStyle()
+    }
+
+    // MARK: Focus
+
+    private func focus() {
+        guard TextInputFocus.shared.session !== session else { return }
+        session.state = TextEditingState(text: text.wrappedValue)
+        TextInputFocus.shared.session = session
+    }
+
+    /// A tap gives the field the keyboard and puts the caret at the nearest character boundary.
+    private func tap(x: CGFloat, y: CGFloat, maxWidth: Float) {
+        guard isEnabled else { return }
+        focus()
+        focusTarget?.focus()
+        let value = text.wrappedValue
+        let drawn = kind == .secure ? Shown.bullets(value) : value
+        let index = irisScene.index(in: drawn, style: textStyle(drawn), maxWidth: maxWidth, x: Float(x), y: Float(y))
+        // Bullets stand one for each character, so characters count the same in both.
+        let characters = drawn.distance(from: drawn.startIndex, to: index)
+        let cursor = value.utf16.distance(from: value.startIndex, to: value.index(value.startIndex, offsetBy: characters))
+        session.edit { state in
+            state.marked = ""
+            state.cursor = cursor
+        }
+    }
+}
+
+// MARK: - Shown
+
+/// The text as drawn: with the marked text at the caret, in bullets for a secure field.
+private struct Shown {
+    var string: String
+    var caret: String.Index
+    var marked: Range<String.Index>
+
+    init(_ state: TextEditingState, secure: Bool) {
+        let index = state.index(state.cursor)
+        var before = String(state.text[..<index])
+        var after = String(state.text[index...])
+        var marked = state.marked
+        if secure {
+            before = Self.bullets(before)
+            after = Self.bullets(after)
+            marked = Self.bullets(marked)
+        }
+        string = before + marked + after
+        let start = string.utf8.index(string.startIndex, offsetBy: before.utf8.count)
+        // The caret stays at the end of the marked text, where the input method types.
+        caret = string.utf8.index(start, offsetBy: marked.utf8.count)
+        self.marked = start ..< caret
+    }
+
+    static func bullets(_ text: String) -> String {
+        String(repeating: "•", count: text.count)
+    }
+}
+
+// MARK: - RoundedBorder
+
+/// RoundedBorderTextFieldStyle: UITextField's rounded rectangle, with its insets.
+private struct RoundedBorder: ViewModifier {
+    var isOn: Bool
+
+    func body(content: Content) -> some View {
+        if isOn {
+            content
+                .padding(.horizontal, 7)
+                .padding(.vertical, 6)
+                .background {
+                    // ponytail: a border of two fills; the layer renderer draws no stroked paths.
+                    ZStack {
+                        RoundedRectangle(cornerRadius: 5).fill(Color(red: 0.8, green: 0.8, blue: 0.82))
+                        RoundedRectangle(cornerRadius: 4.5).fill(Color.white).padding(0.5)
+                    }
+                }
+        } else {
+            content
+        }
+    }
+}
+#endif
