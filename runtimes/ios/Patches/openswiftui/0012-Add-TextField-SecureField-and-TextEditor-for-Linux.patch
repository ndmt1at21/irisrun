+//
+//  TextField.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !canImport(Darwin)
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+import IrisRender
+
+// Iris: on Linux, text fields are drawn by SwiftUI itself, as there is no UITextField. They take
+// text from the host's input method, marked text included, and editing keys from a hardware
+// keyboard: Backspace, Delete, arrows, Home, End and Return. No selection, copy and paste,
+// formatters, custom styles, blinking caret or software keyboard yet.
+
+// MARK: - TextField
+
+/// A control that displays an editable text interface.
+public struct TextField<Label>: View where Label: View {
+    private var text: Binding<String>
+    private var prompt: Text?
+    private var label: Label
+    private var axis: Axis
+    private var onEditingChanged: (Bool) -> Void = { _ in }
+    private var onCommit: () -> Void = {}
+
+    /// Creates a text field with a prompt and a label. On iOS the prompt is the placeholder
+    /// and the label is not shown.
+    public init(text: Binding<String>, prompt: Text? = nil, @ViewBuilder label: () -> Label) {
+        self.text = text
+        self.prompt = prompt
+        self.label = label()
+        self.axis = .horizontal
+    }
+
+    /// Creates a text field that grows to more lines along `axis` when it is vertical.
+    public init(text: Binding<String>, prompt: Text? = nil, axis: Axis, @ViewBuilder label: () -> Label) {
+        self.init(text: text, prompt: prompt, label: label)
+        self.axis = axis
+    }
+
+    public var body: some View {
+        EditableText(
+            text: text,
+            prompt: prompt,
+            kind: axis == .vertical ? .growing : .field,
+            onEditingChanged: onEditingChanged,
+            onCommit: onCommit
+        )
+    }
+}
+
+extension TextField where Label == Text {
+    /// Creates a text field with a title, which is also its placeholder.
+    public init(_ titleKey: LocalizedStringKey, text: Binding<String>) {
+        self.init(text: text, prompt: Text(titleKey)) { Text(titleKey) }
+    }
+
+    @_disfavoredOverload
+    public init<S>(_ title: S, text: Binding<String>) where S: StringProtocol {
+        self.init(text: text, prompt: Text(title)) { Text(title) }
+    }
+
+    public init(_ titleKey: LocalizedStringKey, text: Binding<String>, prompt: Text?) {
+        self.init(text: text, prompt: prompt ?? Text(titleKey)) { Text(titleKey) }
+    }
+
+    @_disfavoredOverload
+    public init<S>(_ title: S, text: Binding<String>, prompt: Text?) where S: StringProtocol {
+        self.init(text: text, prompt: prompt ?? Text(title)) { Text(title) }
+    }
+
+    public init(_ titleKey: LocalizedStringKey, text: Binding<String>, axis: Axis) {
+        self.init(text: text, prompt: Text(titleKey), axis: axis) { Text(titleKey) }
+    }
+
+    @_disfavoredOverload
+    public init<S>(_ title: S, text: Binding<String>, axis: Axis) where S: StringProtocol {
+        self.init(text: text, prompt: Text(title), axis: axis) { Text(title) }
+    }
+
+    public init(_ titleKey: LocalizedStringKey, text: Binding<String>, prompt: Text?, axis: Axis) {
+        self.init(text: text, prompt: prompt ?? Text(titleKey), axis: axis) { Text(titleKey) }
+    }
+
+    @_disfavoredOverload
+    public init<S>(_ title: S, text: Binding<String>, prompt: Text?, axis: Axis) where S: StringProtocol {
+        self.init(text: text, prompt: prompt ?? Text(title), axis: axis) { Text(title) }
+    }
+
+    @available(*, deprecated, message: "Use FocusState<T> and View.focused(_:equals) for onEditingChanged, and View.onSubmit(of:_:) for onCommit")
+    public init(
+        _ titleKey: LocalizedStringKey,
+        text: Binding<String>,
+        onEditingChanged: @escaping (Bool) -> Void = { _ in },
+        onCommit: @escaping () -> Void = {}
+    ) {
+        self.init(titleKey, text: text)
+        self.onEditingChanged = onEditingChanged
+        self.onCommit = onCommit
+    }
+
+    @available(*, deprecated, message: "Use FocusState<T> and View.focused(_:equals) for onEditingChanged, and View.onSubmit(of:_:) for onCommit")
+    @_disfavoredOverload
+    public init<S>(
+        _ title: S,
+        text: Binding<String>,
+        onEditingChanged: @escaping (Bool) -> Void = { _ in },
+        onCommit: @escaping () -> Void = {}
+    ) where S: StringProtocol {
+        self.init(title, text: text)
+        self.onEditingChanged = onEditingChanged
+        self.onCommit = onCommit
+    }
+}
