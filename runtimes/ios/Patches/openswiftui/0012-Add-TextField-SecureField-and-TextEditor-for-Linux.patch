new file mode 100644
index 0000000..5742f46
--- /dev/null
+++ b/Sources/OpenSwiftUI/App/App/Stdout/DeviceInput.swift
@@ -0,0 +1,102 @@
+//
+//  DeviceInput.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+import OpenSwiftUICore
+
+/// Iris: delivers a phone's input to the app as UIKit would: touches go through the gesture
+/// system, and typed text and editing keys go to the text field that has the keyboard. Used on
+/// the main thread.
+final class DeviceInput {
+    enum Phase {
+        case began, moved, stationary, ended, cancelled
+    }
+
+    struct Touch {
+        var id: UInt32
+        var phase: Phase
+        /// In points from the top-left corner of the screen.
+        var location: CGPoint
+    }
+
+    private let manager: EventBindingManager
+    /// The event serial of each finger on the screen, by the host's touch id.
+    private var fingers: [UInt32: Int] = [:]
+    private var serial = 0
+
+    init(manager: EventBindingManager) {
+        self.manager = manager
+    }
+
+    /// Every touch on the screen after a change, as the Device Protocol sends them.
+    func touch(_ touches: [Touch], at time: Time = .systemUptime) {
+        var events: [EventID: any EventType] = [:]
+        for touch in touches {
+            let phase: EventPhase
+            switch touch.phase {
+            case .began:
+                serial += 1
+                fingers[touch.id] = serial
+                phase = .began
+            case .moved, .stationary:
+                phase = .active
+            case .ended:
+                phase = .ended
+            case .cancelled:
+                phase = .failed
+            }
+            // Touches that began before the app did are not the app's.
+            guard let serial = fingers[touch.id] else { continue }
+            if phase.isTerminal {
+                fingers[touch.id] = nil
+            }
+            events[EventID(type: TouchEvent.self, serial: serial)] = TouchEvent(
+                timestamp: time,
+                phase: phase,
+                location: touch.location,
+                globalLocation: touch.location,
+                radius: 1,
+                force: 0,
+                maximumPossibleForce: 0,
+                modifiers: [],
+                altitude: .zero,
+                azimuth: .zero,
+                touchType: .direct
+            )
+        }
+        guard !events.isEmpty else { return }
+        manager.send(events)
+        // Once every finger has lifted, the next touch starts from a fresh gesture graph, as
+        // EventBindingBridge does for UIKit and AppKit hosts.
+        if fingers.isEmpty {
+            manager.reset()
+        }
+    }
+
+    /// Text from the input method: inserted at the caret in place of the marked text.
+    func commit(_ text: String) {
+        TextInputFocus.shared.session?.edit { $0.commit(text) }
+    }
+
+    /// The text the input method is composing, shown at the caret until it commits.
+    func compose(_ text: String) {
+        TextInputFocus.shared.session?.edit { $0.compose(text) }
+    }
+
+    /// Deletes UTF-16 code units around the caret, as an input method's correction does.
+    func deleteSurrounding(before: Int, after: Int) {
+        TextInputFocus.shared.session?.edit { $0.deleteSurrounding(before: before, after: after) }
+    }
+
+    /// A key pressed on a hardware keyboard, by W3C `KeyboardEvent.code`; `command` is the
+    /// Command key of a Mac keyboard on iPad.
+    func press(_ code: String, command: Bool = false) {
+        _ = TextInputFocus.shared.session?.press(code, command: command)
+    }
+}
+#endif
