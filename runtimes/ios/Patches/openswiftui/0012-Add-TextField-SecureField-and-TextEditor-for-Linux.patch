diff --git a/Sources/OpenSwiftUI/View/TextField/TextEditing.swift b/Sources/OpenSwiftUI/View/TextField/TextEditing.swift
new file mode 100644
index 0000000..f929f1a
--- /dev/null
+++ b/Sources/OpenSwiftUI/View/TextField/TextEditing.swift
@@ -0,0 +1,222 @@
+//
+//  TextEditing.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+import OpenSwiftUICore
+
+// MARK: - TextEditingState
+
+/// Iris: text being edited, the caret in it, and the text an input method is composing at the
+/// caret (marked text), which joins the text only when the input method commits it. Offsets
+/// count UTF-16 code units, as input methods and the Device Protocol do.
+struct TextEditingState: Equatable {
+    var text: String
+    /// From 0 to the length of `text`.
+    var cursor: Int
+    var marked = ""
+
+    init(text: String, cursor: Int? = nil) {
+        self.text = text
+        self.cursor = cursor ?? text.utf16.count
+    }
+
+    /// Inserts `string` at the caret in place of the marked text.
+    mutating func commit(_ string: String) {
+        text.insert(contentsOf: string, at: index(cursor))
+        cursor += string.utf16.count
+        marked = ""
+    }
+
+    /// Replaces the marked text; an empty string removes it.
+    mutating func compose(_ string: String) {
+        marked = string
+    }
+
+    /// Deletes code units before and after the caret, outside the marked text. A range that
+    /// ends inside a character takes the whole character.
+    mutating func deleteSurrounding(before: Int, after: Int) {
+        let start = index(cursor - before)
+        var end = index(cursor + after)
+        if end < text.endIndex, offset(end) < cursor + after {
+            end = text.index(after: end)
+        }
+        cursor = offset(start)
+        text.removeSubrange(start ..< end)
+    }
+
+    /// Backspace: deletes the character before the caret.
+    mutating func deleteBackward() {
+        let end = index(cursor)
+        guard end > text.startIndex else { return }
+        let start = text.index(before: end)
+        cursor -= text.utf16.distance(from: start, to: end)
+        text.removeSubrange(start ..< end)
+    }
+
+    /// Delete: deletes the character after the caret.
+    mutating func deleteForward() {
+        let start = index(cursor)
+        guard start < text.endIndex else { return }
+        text.removeSubrange(start ... start)
+    }
+
+    mutating func moveLeft() {
+        let index = index(cursor)
+        guard index > text.startIndex else { return }
+        cursor = offset(text.index(before: index))
+    }
+
+    mutating func moveRight() {
+        let index = index(cursor)
+        guard index < text.endIndex else { return }
+        cursor = offset(text.index(after: index))
+    }
+
+    /// To the start of the line, or of the text with `wholeText`.
+    mutating func moveToStart(wholeText: Bool) {
+        cursor = wholeText ? 0 : offset(lineStart(index(cursor)))
+    }
+
+    mutating func moveToEnd(wholeText: Bool) {
+        cursor = wholeText ? text.utf16.count : offset(lineEnd(index(cursor)))
+    }
+
+    /// To the same character of the line above or below, or the end of a shorter line.
+    mutating func moveLine(by step: Int) {
+        let caret = index(cursor)
+        let start = lineStart(caret)
+        let column = text.distance(from: start, to: caret)
+        let target: String.Index
+        if step < 0 {
+            guard start > text.startIndex else { return moveToStart(wholeText: true) }
+            target = lineStart(text.index(before: start))
+        } else {
+            let end = lineEnd(caret)
+            guard end < text.endIndex else { return moveToEnd(wholeText: true) }
+            target = text.index(after: end)
+        }
+        let length = text.distance(from: target, to: lineEnd(target))
+        cursor = offset(text.index(target, offsetBy: min(column, length)))
+    }
+
+    /// The character boundary at or before a UTF-16 offset.
+    func index(_ offset: Int) -> String.Index {
+        let target = text.utf16.index(text.startIndex, offsetBy: min(max(offset, 0), text.utf16.count))
+        var index = text.startIndex
+        while index < target {
+            let next = text.index(after: index)
+            guard next <= target else { break }
+            index = next
+        }
+        return index
+    }
+
+    private func offset(_ index: String.Index) -> Int {
+        text.utf16.distance(from: text.startIndex, to: index)
+    }
+
+    private func lineStart(_ index: String.Index) -> String.Index {
+        text[..<index].lastIndex(of: "\n").map { text.index(after: $0) } ?? text.startIndex
+    }
+
+    private func lineEnd(_ index: String.Index) -> String.Index {
+        text[index...].firstIndex(of: "\n") ?? text.endIndex
+    }
+}
+
+// MARK: - TextEditingSession
+
+/// Iris: the editing state of one text field. The text belongs to the field's binding; the
+/// session keeps the caret and the marked text while the field has the keyboard, and the
+/// actions an editing key runs. Used on the main thread.
+final class TextEditingSession: Observable {
+    private let registrar = ObservationRegistrar()
+    private var _state = TextEditingState(text: "")
+
+    var state: TextEditingState {
+        get {
+            registrar.access(self, keyPath: \.state)
+            return _state
+        }
+        set {
+            registrar.withMutation(of: self, keyPath: \.state) { _state = newValue }
+        }
+    }
+
+    // The field updates these whenever it updates.
+    var binding: Binding<String>?
+    var isMultiline = false
+    var submit: () -> Void = {}
+
+    /// The state for the field's current text. Text that changed some other way, such as by
+    /// the app, puts the caret at its end, as setting a UITextField's text does.
+    func state(for text: String) -> TextEditingState {
+        let state = state
+        return state.text == text ? state : TextEditingState(text: text)
+    }
+
+    /// Applies an edit and writes the text back to the binding.
+    func edit(_ body: (inout TextEditingState) -> Void) {
+        guard let binding else { return }
+        var state = state(for: binding.wrappedValue)
+        body(&state)
+        self.state = state
+        if binding.wrappedValue != state.text {
+            binding.wrappedValue = state.text
+        }
+    }
+
+    /// Handles a key from a hardware keyboard, a W3C `KeyboardEvent.code` such as "Backspace";
+    /// false when the key does nothing in a text field.
+    func press(_ code: String, command: Bool) -> Bool {
+        switch code {
+        case "Backspace": edit { $0.deleteBackward() }
+        case "Delete": edit { $0.deleteForward() }
+        case "ArrowLeft": edit { command ? $0.moveToStart(wholeText: false) : $0.moveLeft() }
+        case "ArrowRight": edit { command ? $0.moveToEnd(wholeText: false) : $0.moveRight() }
+        case "ArrowUp": edit { isMultiline && !command ? $0.moveLine(by: -1) : $0.moveToStart(wholeText: true) }
+        case "ArrowDown": edit { isMultiline && !command ? $0.moveLine(by: 1) : $0.moveToEnd(wholeText: true) }
+        case "Home": edit { $0.moveToStart(wholeText: command) }
+        case "End": edit { $0.moveToEnd(wholeText: command) }
+        case "Enter", "NumpadEnter":
+            if isMultiline {
+                edit { $0.commit("\n") }
+            } else {
+                // Return ends editing, then runs onSubmit, which may focus the next field.
+                TextInputFocus.shared.session = nil
+                submit()
+            }
+        default:
+            return false
+        }
+        return true
+    }
+}
+
+// MARK: - TextInputFocus
+
+/// Iris: the text field that has the keyboard. The host sends typed text and editing keys to
+/// its session. Used on the main thread.
+final class TextInputFocus: Observable {
+    static let shared = TextInputFocus()
+
+    private let registrar = ObservationRegistrar()
+    private var _session: TextEditingSession?
+
+    var session: TextEditingSession? {
+        get {
+            registrar.access(self, keyPath: \.session)
+            return _session
+        }
+        set {
+            guard newValue !== _session else { return }
+            registrar.withMutation(of: self, keyPath: \.session) { _session = newValue }
+        }
+    }
+}
+#endif
