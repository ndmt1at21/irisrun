+//
+//  TextInputModifiers.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !canImport(Darwin)
+public import Foundation
+@_spi(ForOpenSwiftUIOnly)
+public import OpenSwiftUICore
+
+// MARK: - Submit
+
+/// A type that defines various triggers that result in the firing of a submission action.
+public struct SubmitTriggers: OptionSet, Sendable {
+    public let rawValue: UInt
+
+    public init(rawValue: UInt) {
+        self.rawValue = rawValue
+    }
+
+    /// Defines triggers originating from text input controls like `TextField` and `SecureField`.
+    public static let text = SubmitTriggers(rawValue: 1 << 0)
+
+    /// Defines triggers originating from search fields constructed from searchable modifiers.
+    public static let search = SubmitTriggers(rawValue: 1 << 1)
+}
+
+extension View {
+    /// Adds an action to perform when the user submits a value to this view, such as by
+    /// pressing Return in a text field.
+    public func onSubmit(of triggers: SubmitTriggers = .text, _ action: @escaping () -> Void) -> some View {
+        transformEnvironment(\.irisSubmitActions) { actions in
+            if triggers.contains(.text) {
+                actions.insert(action, at: 0)
+            }
+        }
+    }
+}
+
+/// A semantic label describing the label of submission within a view hierarchy.
+///
+/// Iris: accepted and ignored; Return keys have no label on the Device UI's keyboard.
+public struct SubmitLabel: Sendable {
+    private var name: String
+
+    public static var done: SubmitLabel { SubmitLabel(name: "done") }
+    public static var go: SubmitLabel { SubmitLabel(name: "go") }
+    public static var send: SubmitLabel { SubmitLabel(name: "send") }
+    public static var join: SubmitLabel { SubmitLabel(name: "join") }
+    public static var route: SubmitLabel { SubmitLabel(name: "route") }
+    public static var search: SubmitLabel { SubmitLabel(name: "search") }
+    public static var `return`: SubmitLabel { SubmitLabel(name: "return") }
+    public static var next: SubmitLabel { SubmitLabel(name: "next") }
+    public static var `continue`: SubmitLabel { SubmitLabel(name: "continue") }
+}
+
+extension View {
+    public func submitLabel(_ submitLabel: SubmitLabel) -> some View {
+        self
+    }
+}
+
+extension EnvironmentValues {
+    /// Iris: the actions `onSubmit` added around a view, innermost first.
+    var irisSubmitActions: [() -> Void] {
+        get { self[SubmitActionsKey.self] }
+        set { self[SubmitActionsKey.self] = newValue }
+    }
+}
+
+private struct SubmitActionsKey: EnvironmentKey {
+    static var defaultValue: [() -> Void] { [] }
+}
+
+// MARK: - Keyboard hints
+
+// Iris: what the software keyboard of a phone would adapt to. The Device UI types with the
+// computer's keyboard, so these are accepted and ignored.
+
+/// The kind of capitalization applied to text as it's typed.
+public struct TextInputAutocapitalization: Sendable {
+    private var name: String
+
+    public static var never: TextInputAutocapitalization { .init(name: "never") }
+    public static var words: TextInputAutocapitalization { .init(name: "words") }
+    public static var sentences: TextInputAutocapitalization { .init(name: "sentences") }
+    public static var characters: TextInputAutocapitalization { .init(name: "characters") }
+}
+
+extension View {
+    public func textInputAutocapitalization(_ autocapitalization: TextInputAutocapitalization?) -> some View {
+        self
+    }
+
+    public func autocorrectionDisabled(_ disable: Bool = true) -> some View {
+        self
+    }
+
+    @available(*, deprecated, renamed: "autocorrectionDisabled(_:)")
+    public func disableAutocorrection(_ disable: Bool?) -> some View {
+        self
+    }
+}
+
+// ponytail: UIKit's types live here until OpenKit has UIKit (P1-16); move them there then, and
+// re-export UIKit from SwiftUI as Apple's does.
+
+/// The type of keyboard to display for a given text-based view.
+public enum UIKeyboardType: Int, Sendable {
+    case `default`
+    case asciiCapable
+    case numbersAndPunctuation
+    case URL
+    case numberPad
+    case phonePad
+    case namePhonePad
+    case emailAddress
+    case decimalPad
+    case twitter
+    case webSearch
+    case asciiCapableNumberPad
+
+    public static var alphabet: UIKeyboardType { .asciiCapable }
+}
+
+/// The semantic meaning for a text-entry area.
+public struct UITextContentType: RawRepresentable, Hashable, Sendable {
+    public var rawValue: String
+
+    public init(rawValue: String) {
+        self.rawValue = rawValue
+    }
+
+    public static let name = UITextContentType(rawValue: "name")
+    public static let givenName = UITextContentType(rawValue: "given-name")
+    public static let familyName = UITextContentType(rawValue: "family-name")
+    public static let nickname = UITextContentType(rawValue: "nickname")
+    public static let organizationName = UITextContentType(rawValue: "organization")
+    public static let fullStreetAddress = UITextContentType(rawValue: "street-address")
+    public static let addressCity = UITextContentType(rawValue: "address-level2")
+    public static let postalCode = UITextContentType(rawValue: "postal-code")
+    public static let countryName = UITextContentType(rawValue: "country-name")
+    public static let telephoneNumber = UITextContentType(rawValue: "tel")
+    public static let emailAddress = UITextContentType(rawValue: "email")
+    public static let URL = UITextContentType(rawValue: "url")
+    public static let username = UITextContentType(rawValue: "username")
+    public static let password = UITextContentType(rawValue: "password")
+    public static let newPassword = UITextContentType(rawValue: "new-password")
+    public static let oneTimeCode = UITextContentType(rawValue: "one-time-code")
+}
+
+extension View {
+    public func keyboardType(_ type: UIKeyboardType) -> some View {
+        self
+    }
+
+    public func textContentType(_ textContentType: UITextContentType?) -> some View {
+        self
+    }
+}
