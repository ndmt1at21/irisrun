+    /// Representables' views: subviews, whose geometry in UIKit matches where the display list
+    /// draws them, for hit-testing and conversions, and whose layers draw at their places among
+    /// SwiftUI's layers. Those the display list no longer shows leave.
+    func irisPlace(_ placements: [IrisPlatformViewPlacement]) {
+        let views = placements.compactMap { $0.view as? UIView }
+        for view in platformViews where !views.contains(where: { $0 === view }) {
+            view.layer._irisOwnerLayer = nil
+            view.removeFromSuperview()
+        }
+        platformViews = views
+        for placement in placements {
+            guard let view = placement.view as? UIView else { continue }
+            let transform = placement.transform
+            view.bounds.size = placement.frame.size
+            view.center = CGPoint(x: placement.frame.midX, y: placement.frame.midY).applying(transform)
+            view.transform = CGAffineTransform(a: transform.a, b: transform.b, c: transform.c, d: transform.d, tx: 0, ty: 0)
+            view.layer._irisOwnerLayer = placement.slot
+            if view.superview !== self {
+                addSubview(view)
+            }
+        }
+    }
+
+    /// Touches go where SwiftUI's responders say, front to back, as on iOS: into a
+    /// representable's UIKit view, hit-tested there as UIKit does, unless SwiftUI content drawn
+    /// over it takes them; elsewhere to SwiftUI through this view. A view the app adds to this
+    /// one is hit as UIKit hits it.
+    // ponytail: a SwiftUI clip leaves the clipped part of a UIKit view hittable, as both
+    // UIKit's frame and the responder's are the whole view; iOS puts the view in clipping
+    // container views, which this would need.
+    override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+        let hit = super.hitTest(point, with: event)
+        guard let hit, hit !== self, platformViews.contains(where: { hit.isDescendant(of: $0) }) else {
+            return hit
+        }
+        let responder = Update.ensure {
+            (responderNode as? ViewResponder)?.hitTest(globalPoint: point, radius: 1)
+        }
+        guard let hostView = (responder as? UIViewResponder)?.hostView else {
+            return self
+        }
+        return hit.isDescendant(of: hostView) ? hit : hostView.hitTest(convert(point, to: hostView), with: event) ?? self
+    }
