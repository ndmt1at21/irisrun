@@ -0,0 +1,230 @@
+//
+//  IrisPlatformViewHost.swift
+//  OpenSwiftUI
+//
+//  Status: Iris
+
+#if !OPENSWIFTUI_SWIFTUI_RENDERER && !canImport(Darwin)
+import Foundation
+@_spi(ForOpenSwiftUIOnly)
+import OpenSwiftUICore
+import OpenAttributeGraphShims
+import OpenUIKit
+
+typealias PlatformEdgeInsets = UIEdgeInsets
+
+// MARK: - PlatformViewHost
+
+/// Iris: the view that holds a representable's UIKit view, or its view controller's view, as on
+/// iOS. The hosting view makes it a subview where the display list places it
+/// (`_UIHostingView.irisPlace(_:)`); it sizes the view to its bounds, tells SwiftUI the view's
+/// intrinsic size and content priorities and when they change, and makes a view controller a
+/// child of the hosting view's controller while it is in a window.
+final class PlatformViewHost<Content>: UIView, AnyPlatformViewHost, AnyPlatformViewProviderHost where Content: PlatformViewRepresentable {
+    var importer: EmptyPreferenceImporter
+    var environment: EnvironmentValues
+    var viewPhase: _GraphInputs.Phase
+    let representedViewProvider: Content.PlatformViewProvider
+    weak var host: ViewRendererHost?
+    var focusedValues = FocusedValues()
+    weak var responder: PlatformViewResponder?
+    var layoutInvalidator: PlatformViewLayoutInvalidator?
+    private var invalidationPending = false
+    private var cachedLayoutTraits: _LayoutTraits?
+
+    /// The UIKit view shown, filling this one.
+    private var hostedView: UIView? {
+        didSet {
+            guard hostedView !== oldValue else { return }
+            oldValue?.removeFromSuperview()
+            if let hostedView {
+                addSubview(hostedView)
+            }
+        }
+    }
+
+    init(
+        _ provider: Content.PlatformViewProvider,
+        host: ViewRendererHost?,
+        environment: EnvironmentValues,
+        viewPhase: _GraphInputs.Phase,
+        importer: EmptyPreferenceImporter
+    ) {
+        self.environment = environment
+        self.viewPhase = viewPhase
+        self.representedViewProvider = provider
+        self.host = host
+        self.importer = importer
+        super.init(frame: .zero)
+        // A view controller's view comes in once it joins its parent (didMoveToWindow).
+        if !Content.isViewController {
+            let view = Content.platformView(for: provider)
+            hostedView = view
+            addSubview(view)
+        }
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    // ponytail: SwiftUI's environment doesn't reach UIKit's traits, and safe area insets don't
+    // propagate (the SPI layout option `propagatesSafeArea`).
+    func updateEnvironment(_ environment: EnvironmentValues, viewPhase: _GraphInputs.Phase) {
+        self.environment = environment
+        self.viewPhase = viewPhase
+    }
+
+    func updateSafeAreaInsets(_ insets: PlatformEdgeInsets?) {}
+
+    // ponytail: no text baselines; SwiftUI aligns the view by its top and bottom.
+    func _baselineOffsets(at size: CGSize) -> (firstTextBaseline: CGFloat, lastTextBaseline: CGFloat) {
+        (.nan, .nan)
+    }
+
+    // MARK: Layout
+
+    /// How SwiftUI sizes the view along each axis, as on iOS: by its intrinsic content size,
+    /// which it shrinks below only if it resists compression weakly and grows past only if it
+    /// hugs weakly; along an axis with no intrinsic size it takes any size.
+    func layoutTraits() -> _LayoutTraits {
+        if let cachedLayoutTraits {
+            return cachedLayoutTraits
+        }
+        func dimension(value: CGFloat, axis: NSLayoutConstraint.Axis) -> _LayoutTraits.Dimension {
+            guard value != UIView.noIntrinsicMetric else {
+                return .init(min: .zero, ideal: .zero, max: .infinity)
+            }
+            let ideal = max(value, .zero)
+            let minValue = contentCompressionResistancePriority(for: axis) >= .defaultHigh ? ideal : .zero
+            let maxValue = contentHuggingPriority(for: axis) >= .defaultHigh ? ideal : .infinity
+            return .init(min: minValue, ideal: ideal, max: maxValue)
+        }
+        let size = intrinsicContentSize
+        let traits = _LayoutTraits(
+            width: dimension(value: size.width, axis: .horizontal),
+            height: dimension(value: size.height, axis: .vertical)
+        )
+        cachedLayoutTraits = traits
+        return traits
+    }
+
+    override var intrinsicContentSize: CGSize {
+        Content.isViewController ? super.intrinsicContentSize : Content.platformView(for: representedViewProvider).intrinsicContentSize
+    }
+
+    override func contentHuggingPriority(for axis: NSLayoutConstraint.Axis) -> UILayoutPriority {
+        Content.isViewController ? super.contentHuggingPriority(for: axis) : Content.platformView(for: representedViewProvider).contentHuggingPriority(for: axis)
+    }
+
+    override func contentCompressionResistancePriority(for axis: NSLayoutConstraint.Axis) -> UILayoutPriority {
+        Content.isViewController ? super.contentCompressionResistancePriority(for: axis) : Content.platformView(for: representedViewProvider).contentCompressionResistancePriority(for: axis)
+    }
+
+    /// The view's intrinsic size changed, such as a label's text in `updateUIView`: SwiftUI lays
+    /// it out again, after the update that may be running.
+    override func _intrinsicContentSizeInvalidated(forChildView view: UIView) {
+        guard view === hostedView else { return }
+        cachedLayoutTraits = nil
+        guard !invalidationPending, let layoutInvalidator else { return }
+        invalidationPending = true
+        Update.enqueueAction { [weak self] in
+            self?.invalidationPending = false
+            guard let computer = layoutInvalidator.layoutComputer.attribute else { return }
+            computer.invalidateValue()
+            layoutInvalidator.graphHost?.graphInvalidation(from: nil)
+        }
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        guard let hostedView, bounds.width != .zero, bounds.height != .zero else { return }
+        hostedView.frame = bounds
+    }
+
+    /// Only the hosted views take touches; elsewhere in the frame they go on to SwiftUI.
+    override func hitTest(_ point: CGPoint, with event: UIEvent?) -> UIView? {
+        let result = super.hitTest(point, with: event)
+        return result === self ? nil : result
+    }
+
+    // MARK: View controllers
+
+    /// A view controller is a child of the nearest view controller above, the hosting
+    /// controller, while its view is in a window, with UIKit's containment calls.
+    // ponytail: no appearance callbacks; UIKit has none yet (P1-16, step 4).
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        guard let viewController = representedViewProvider as? UIViewController else { return }
+        guard window != nil else {
+            guard viewController.parent != nil else { return }
+            viewController.willMove(toParent: nil)
+            viewController.removeFromParent()
+            return
+        }
+        var responder: UIResponder? = superview
+        while let current = responder, !(current is UIViewController) {
+            responder = current.next
+        }
+        guard let parent = responder as? UIViewController, viewController.parent !== parent else { return }
+        parent.addChild(viewController)
+        hostedView = viewController.view
+        viewController.didMove(toParent: parent)
+    }
+}
+
+// MARK: - UIViewResponder
+
+/// Iris: a representable's view among SwiftUI's responders, as on iOS, so that SwiftUI's
+/// hit-testing tells whether the view or SwiftUI content drawn over it takes a touch
+/// (`_UIHostingView.hitTest(_:with:)`).
+final class UIViewResponder: ViewResponder {
+    weak var hostView: UIView?
+    var helper = ContentResponderHelper<TrivialContentResponder>()
+
+    override func containsGlobalPoints(_ points: [CGPoint], cacheKey: UInt32?, options: ContainsPointsOptions) -> ContainsPointsResult {
+        guard let hostView, options.contains(.allowDisabledViews) || hostView.isUserInteractionEnabled else {
+            return super.containsGlobalPoints(points, cacheKey: cacheKey, options: options)
+        }
+        var result = helper.containsGlobalPoints(points, cacheKey: cacheKey, options: options, children: children)
+        if !result.mask.isEmpty, !options.contains(.useZDistanceAsPriority) {
+            result.priority = max(result.priority, Self.gestureContainmentPriority)
+        }
+        return result
+    }
+
+    override func addContentPath(to path: inout Path, kind: ContentShapeKinds, in space: CoordinateSpace, observer: (any ContentPathObserver)?) {
+        helper.addContentPath(to: &path, kind: kind, in: space, observer: observer)
+    }
+}
+
+/// Iris: keeps a representable's responder where its view is, as `LeafResponderFilter` does for
+/// leaf views.
+struct PlatformViewResponderFilter<Content>: StatefulRule where Content: PlatformViewRepresentable {
+    @Attribute var view: ViewLeafView<Content>
+    @Attribute var size: ViewSize
+    @Attribute var position: ViewOrigin
+    @Attribute var transform: ViewTransform
+    let responder = UIViewResponder()
+
+    typealias Value = [ViewResponder]
+
+    mutating func updateValue() {
+        let (view, viewChanged) = $view.changedValue()
+        if viewChanged {
+            responder.hostView = view.platformView
+            view.platformView.responder = responder
+        }
+        responder.helper.update(
+            data: (TrivialContentResponder(), !hasValue),
+            size: $size.changedValue(),
+            position: $position.changedValue(),
+            transform: $transform.changedValue(),
+            parent: responder
+        )
+        if !hasValue {
+            value = [responder]
+        }
+    }
+}
+#endif
